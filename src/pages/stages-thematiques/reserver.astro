---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import FormulaireReservation from '../../components/FormulaireReservation.astro';
import { getAdminClient } from '../../utils/supabase';
import {
  seancesAchetables, demarrerAchatUnite,
  lireFormulaireReservation, participantDe, saisieVide,
} from '../../utils/achat-unite';
import { mesurer } from '../../utils/mesure';

/*
 * RÉSERVER UNE PLACE, À UNE DATE.
 *
 * Jumelle de l'autre page de réservation : elles ne diffèrent que par le genre
 * demandé — les stages d'un côté, les séances sans engagement de l'autre — et
 * par leurs mots. Tout le reste vit dans `achat-unite.ts` et dans le formulaire
 * partagé, y compris avec l'inscription au forfait, qui demande la même chose
 * aux mêmes gens.
 */

const supabase = getAdminClient();
const seances = await seancesAchetables(supabase, 'stage');

let erreur: string | null = null;
let saisi = saisieVide();

if (Astro.request.method === 'POST') {
  saisi = lireFormulaireReservation(await Astro.request.formData());

  const r = await demarrerAchatUnite(supabase, {
    email: saisi.email,
    payeurPrenom: saisi.payeurPrenom,
    payeurNom: saisi.payeurNom,
    prenom: participantDe(saisi),
    sessionId: saisi.session,
    codePromo: saisi.code,
    origine: Astro.url.origin,
    site: Astro.site,
    cheminAchat: '/stages-thematiques/reserver/',
    cheminRetour: '/reserver/retour/',
  });

  if (!r.ok) {
    erreur = r.erreur;
    // Le motif dit pourquoi une famille s'arrête là. Voir /ateliers-reguliers/inscription/.
    /*
     * SANS L'ADRESSE, ET C'EST LE POINT. Cette personne n'a rien acheté : son
     * code était expiré, ou la date venait d'être prise. Elle n'est ni
     * adhérente ni cliente, et rien ne justifie qu'une adresse saisie dans un
     * formulaire refusé ouvre une fiche chez un tiers.
     *
     * On ne perd presque rien : ce qui fait corriger, c'est le motif — « le
     * code X n'existe pas » — et non l'identité de qui l'a saisi. Ce qui est
     * perdu, et assumé : savoir que la même personne est revenue payer ensuite.
     */
    await mesurer('achat_refuse', null, { motif: r.erreur, depuis: '/stages-thematiques/reserver/' });
  }
  // `redirectUrl` ne vaut que quinze minutes : on y va tout de suite.
  else return Astro.redirect(r.valeur.redirectUrl, 303);
}

/*
 * ON PEUT ARRIVER DEPUIS LA FICHE D'UN STAGE, qui sait déjà lequel. Le
 * paramètre ne fait que présélectionner : il n'entre pas dans l'achat, où seule
 * la date compte, et un créneau inconnu retombe simplement sur « toutes les
 * possibilités » plutôt que de vider la liste.
 */
const creneauChoisi = Astro.url.searchParams.get('creneau');

if (Astro.url.searchParams.has('echec')) {
  erreur = 'Le paiement n’a pas abouti. Rien n’a été prélevé — vous pouvez réessayer.';
  // HelloAsso renvoie ici quand le paiement n'a pas abouti. Rien n'a été
  // prélevé ; ce qui se mesure, c'est le renoncement au moment de payer.
  await mesurer('paiement_echoue', Astro.locals.account?.email ?? null, {
    depuis: '/stages-thematiques/reserver/',
  });
}
---

<BaseLayout
  title="Réserver un stage"
  description="Choisir sa date et régler sa place en ligne."
  noIndex
>
  <section class="mx-auto max-w-3xl px-4 py-16 md:py-20">
    <h1 class="text-2xl md:text-3xl font-bold" style="font-family: var(--font-heading)">
      Réserver un stage
    </h1>

    <FormulaireReservation seances={seances} erreur={erreur} saisi={saisi} creneauChoisi={creneauChoisi} nomProduit="ce stage" nomCreneau="Quel stage ?" />
  </section>
</BaseLayout>
