---
export const prerender = false;

import BaseLayout from '../../../layouts/BaseLayout.astro';
import RetourPaiement from '../../../components/RetourPaiement.astro';

/*
 * Toute la mécanique — relire l'intention chez HelloAsso, provisionner, et
 * mettre en file ce qui ne se rattache pas — vit dans `RetourPaiement`, partagé
 * avec le retour d'une réservation à l'unité. Ne restent ici que les mots.
 */
---

<BaseLayout title="Votre inscription" description="Confirmation de votre inscription." noIndex>
  <RetourPaiement
    contexte="inscription publique"
    messageCree="Votre inscription est enregistrée et vos premières séances sont déjà posées sur votre créneau."
    messageDeja="Votre inscription était déjà enregistrée. Tout est en ordre."
    messageGratuit="Votre code couvrait la totalité : il n’y a rien eu à régler. Vos premières séances sont déjà posées sur votre créneau."
    messageHorsLigne="Votre règlement par chèque ou en espèces est enregistré, et votre inscription avec. Vos premières séances sont déjà posées sur votre créneau."
  >
    <div class="mt-8 rounded-xl bg-[var(--color-bg-accent)] px-4 py-4">
      <h2 class="font-bold text-[var(--color-heading)]">Ouvrir votre espace</h2>
      <p class="mt-2 text-[var(--color-text)]">
        Votre accès est ouvert à l’adresse que vous venez d’indiquer. Connectez-vous pour voir
        vos dates, en changer, ou inscrire quelqu’un d’autre de votre foyer — l’adhésion ne
        sera pas redemandée.
      </p>
      <a href="/espace-membre/connexion/"
         class="mt-4 inline-block rounded-[var(--radius-button)] bg-[var(--color-button)] px-6 py-3 font-medium text-white">
        Me connecter
      </a>
      <p class="mt-3 text-sm text-[var(--color-text-light)]">
        Un code vous sera envoyé par courriel : il n’y a pas de mot de passe à retenir.
      </p>
    </div>
  </RetourPaiement>
</BaseLayout>
