---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import AvisProvisoire from '../components/AvisProvisoire.astro';
import IntroSection from '../components/IntroSection.astro';
import CrossLinksSection from '../components/CrossLinksSection.astro';
import CalendrierCreneau from '../components/CalendrierCreneau.astro';
import FaqSection from '../components/FaqSection.astro';
import Temoignages from '../components/Temoignages.astro';
import { getPageContext, reader } from '../utils/reader';
import { resolveImage, resolveImageUrl } from '../utils/images';
import { toSlug } from '../utils/strings';
import { buildCourseSchema, buildServicePageSchemas } from '../utils/schema';
import {
  fourchetteForfaits,
  grilleAvecPrixDeLaBase,
  lireFormules,
  lireTarifs,
  montantFr,
  prixDesOffres,
} from '../utils/tarifs';
import { ADHESION_CENTS } from '../utils/helloasso';
import { getAdminClient } from '../utils/supabase';
import { ATELIER_GROUPS, titreAudience } from '../utils/ateliers';

/**
 * Les ateliers réguliers : leurs dates et leur disponibilité lues en base.
 *
 * LES DATES NE SONT PLUS RECOPIÉES. Elles l'étaient dans le CMS, et la page a
 * passé une saison entière à annoncer les samedis de l'année précédente — même
 * jour de la semaine, un an trop tôt, ce qui ne se voit pas. Une date qui vient
 * de la base ne peut plus mentir sans que l'écran des séances mente aussi.
 *
 * CE QUI RESTE AU CONTENU, ET POURQUOI : les MOTS de la grille — la durée d'une
 * séance, la glose du rythme, l'ordre des cartes. Ses nombres, eux, viennent de
 * la table `formules` depuis qu'un dépassement se facture au prix divisé du
 * forfait : le montant facture, il ne peut donc plus vivre à deux endroits.
 *
 * `default_unit_price_cents` reste une TOUTE AUTRE CHOSE — le prix d'une séance
 * achetée seule, 45 € les 3 h — et non le forfait d'une saison. Afficher l'un à
 * la place de l'autre ne serait pas une simplification mais une erreur de prix. Le prix à l'unité, lui, est lu en base : c'est celui qu'on
 * encaisse d'un visiteur d'un soir, et deux endroits pour un seul montant
 * finiraient par diverger. Il ne facture PAS les dépassements de forfait, qui
 * se règlent au prix divisé de la formule achetée.
 *
 * Rendue à la demande, et non à la construction : une place prise ce matin doit
 * se voir cet après-midi.
 */

const page = await reader.singletons.ateliersReguliers.read();
if (!page) throw new Error('Contenu des ateliers réguliers introuvable');

const { settings, siteUrl } = await getPageContext(Astro.site);

/*
 * La description SEO annonçait « De 25€ à 55€ par mois » — deux chiffres d'une
 * grille tarifaire qui n'existe plus. Elle garde ses mots, mais prend ses
 * nombres dans la grille affichée juste en dessous.
 */
/*
 * LA GRILLE, SES NOMBRES REPRIS DE LA BASE — avant tout le reste.
 *
 * `page.tarifs` porte les mots ; `formules` porte les montants. Tout ce qui
 * suit — la fourchette de la description SEO, les cartes, le JSON-LD, le prix
 * d'appel de l'accueil — travaille sur la grille ainsi corrigée, faute de quoi
 * la page et la facture annonceraient deux prix.
 */
const formules = await lireFormules();
const tarifsPage = grilleAvecPrixDeLaBase(page.tarifs, formules);

const grille = fourchetteForfaits(tarifsPage);
const descriptionSeo = grille
  ? page.seoDescription.replace(/De\s+\d+\s*€\s+à\s+\d+\s*€/i, grille)
  : page.seoDescription;

const coverGlob = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/covers/**/*.{jpg,jpeg,png,webp}');
const couverture = await resolveImage(page.coverImage, coverGlob);
const ogImage = await resolveImageUrl(page.coverImage, coverGlob, Astro.site);

const faqItems = page.faqItems ?? [];
/*
 * `descriptionSeo` ET NON `page.seoDescription`, ici comme dans la balise meta.
 *
 * Le correctif ci-dessus ne portait que sur ce qu'un visiteur lit ; le JSON-LD,
 * lui, continuait d'annoncer « De 25€ à 55€ par mois » à Google et aux moteurs
 * de réponse — la grille d'avant, dans le seul endroit de la page que personne
 * ne relit. Deux phrases pour un seul prix, et c'est la version fausse qui
 * partait aux machines.
 */
const schemas = buildServicePageSchemas({
  title: page.title,
  seoDescription: descriptionSeo,
  pageUrl: new URL(Astro.url.pathname, Astro.site).toString(),
  siteUrl,
  settings,
  /*
   * LES OFFRES DU SCHÉMA VIENNENT DE LA BASE, non du CMS.
   *
   * `schemaOffers` annonçait encore « Forfait 10 séances — adultes, 360 € » et
   * « 20 séances, 580 € » : des formules qui n'existent plus, et rien pour les
   * ados. C'est ce que Google lit — l'endroit de la page que personne ne relit,
   * et le seul où un prix périmé peut vivre des mois.
   *
   * Le champ a été RETIRÉ du contenu plutôt que corrigé, comme sur la page des
   * séances sans engagement et pour la même raison : corrigé, il aurait
   * simplement recommencé à dériver à la prochaine saison.
   */
  offers: (formules ?? []).map((f) => ({
    name: `Forfait ${f.seances} séances — ${f.audience}`,
    price: String(Math.round(f.prixCents / 100)),
  })),
  faqItems,
});

const creneaux = page.creneaux ?? [];
const groupes = ATELIER_GROUPS
  .map((g) => ({ ...g, items: creneaux.filter((c) => c.group === g.id) }))
  .filter((g) => g.items.length > 0);

const supabase = getAdminClient();

// Les séances à venir de chaque créneau d'atelier encore proposé. Un créneau
// archivé n'est plus au programme : montrer ses dates ferait espérer une
// inscription impossible.
//
// `au_forfait` écarte les créneaux qui ne se vendent qu'à l'unité — la séance
// du jeudi soir, 1 h 30 à 22 €. Cette page ne parle que de forfaits : l'y
// laisser paraître aurait invité à poser sur elle un forfait qu'elle
// n'accepte pas. Elle a sa page, celle des séances sans engagement.
//
// LE FILTRE EST SUR LA REQUÊTE, ET NON À L'AFFICHAGE, parce que `enBase` sert
// aussi à repérer les créneaux qu'aucune fiche du CMS ne décrit. Filtré plus
// tard, un créneau hors forfait serait signalé comme un oubli de contenu à
// chaque visite — un avertissement permanent sur une absence voulue.
const { data: enBase, error } = await supabase
  .from('creneaux')
  .select(`
    id, label, audience, default_location, default_start_time, default_end_time,
    default_unit_price_cents, default_capacity,
    sessions(starts_at, ends_at, capacity, places_attente, status, bookings(status))
  `)
  .eq('kind', 'atelier')
  .eq('au_forfait', true)
  .is('archived_at', null);

const maintenant = new Date().toISOString();

/**
 * Le pont entre les deux mondes est le NOM du créneau, seul identifiant commun :
 * le contenu ne connaît pas les identifiants de la base, et la base ignore
 * l'ordre des fiches du CMS. Comparaison insensible à la casse et aux espaces de
 * bord, un « Atelier du samedi matin » saisi à la main pouvant traîner une espace.
 */
const cle = (nom: string) => nom.trim().toLowerCase();

const parNom = new Map((enBase ?? []).map((c) => [cle(c.label), c]));

const datesDe = (nom: string) =>
  ((parNom.get(cle(nom))?.sessions ?? []) as any[]).filter(
    (s) => s.status === 'scheduled' && s.starts_at > maintenant,
  );

/**
 * Un créneau du contenu qu'aucune ligne de la base ne porte est une anomalie, pas
 * un créneau sans date. Le dire fait gagner du temps : c'est précisément ce que
 * cette page sert à découvrir avant de basculer les pages publiées.
 */
const inconnuEnBase = (nom: string) => !parNom.has(cle(nom));

/** L'identifiant en base d'un créneau du contenu — celui que porte le lien d'inscription. */
const idDe = (nom: string) => parNom.get(cle(nom))?.id as string | undefined;

/**
 * ET L'INVERSE : un créneau en base qu'aucune fiche du contenu ne décrit.
 *
 * Le contrôle ne regardait que dans un sens, et l'oubli s'est fait sentir dès
 * qu'un créneau est né en base : la page le passait sous silence, puisqu'elle
 * bâtit ses groupes à partir du contenu. Un créneau absent d'une page ne se
 * remarque pas — c'est exactement ce qu'un contrôle doit rattraper.
 */
const nomsDuContenu = new Set(creneaux.map((c) => cle(c.name)));
const absentsDuContenu = (enBase ?? []).filter((c) => !nomsDuContenu.has(cle(c.label)));

/** « 3 h », « 2 h 30 » — la durée d'une séance, lue sur les horaires du créneau. */
const enHeures = (debut: string, fin: string) => {
  const min = (t: string) => Number(t.slice(0, 2)) * 60 + Number(t.slice(3, 5));
  const m = min(fin) - min(debut);
  return m <= 0 ? null : m % 60 === 0 ? `${m / 60} h` : `${Math.floor(m / 60)} h ${m % 60}`;
};

/**
 * Le nombre de places d'une séance — trois, sur tous les créneaux.
 *
 * C'EST L'ARGUMENT LE PLUS FORT DE LA PAGE, et il n'y figurait nulle part. Il
 * ne se lisait qu'en creux, quand une date passait « complet ». Or trois places
 * expliquent à la fois l'attention qu'on reçoit et le prix qu'on paie : le
 * taire, c'était laisser le prix seul.
 */
const placesDe = (nom: string) => parNom.get(cle(nom))?.default_capacity ?? null;

const dureeDe = (nom: string) => {
  const c = parNom.get(cle(nom));
  return c ? enHeures(c.default_start_time, c.default_end_time) : null;
};

/**
 * Les horaires écrits à la main, ramenés à des minutes pour être comparables.
 *
 * Le contenu les note « 14h à 17h », « de 9h30 à 12h » ; la base « 14:00:00 ».
 * Sans cette réduction, toute comparaison signalerait un écart sur chaque ligne.
 */
const enMinutes = (texte: string) => {
  const bornes = [...texte.matchAll(/(\d{1,2})\s*h\s*(\d{2})?/g)]
    .map((m) => Number(m[1]) * 60 + Number(m[2] ?? 0));
  return bornes.length === 2 ? bornes : null;
};

/**
 * CE QUE LE CONTENU ET LA BASE NE DISENT PAS PAREIL.
 *
 * C'est la raison d'être de cette page. Les deux sources décrivent les mêmes
 * ateliers, et rien ne les tient d'accord : le contenu se modifie dans le CMS,
 * la base dans l'espace d'administration. Tant que les deux vivent, elles
 * divergent — et la page affiche alors des horaires ou un public que les
 * règles d'inscription ignorent.
 *
 * Les afficher ici les fait remarquer avant la bascule, plutôt qu'un adhérent
 * ne les découvre devant une porte close.
 */
const ecartsDe = (c: { name: string; time: string; location: string; group: string }) => {
  const base = parNom.get(cle(c.name));
  if (!base) return [];
  const ecarts: string[] = [];

  const horairesContenu = enMinutes(c.time);
  const horairesBase = enMinutes(
    `${Number(base.default_start_time.slice(0, 2))}h${base.default_start_time.slice(3, 5)} à ` +
    `${Number(base.default_end_time.slice(0, 2))}h${base.default_end_time.slice(3, 5)}`,
  );
  if (horairesContenu && horairesBase &&
      (horairesContenu[0] !== horairesBase[0] || horairesContenu[1] !== horairesBase[1])) {
    ecarts.push(
      `horaires : « ${c.time} » ici, ` +
      `${base.default_start_time.slice(0, 5)}–${base.default_end_time.slice(0, 5)} en base`,
    );
  }

  const publicContenu = ATELIER_GROUPS.find((g) => g.id === c.group)?.audience;
  if (publicContenu && publicContenu !== base.audience) {
    ecarts.push(`public : ${publicContenu} ici, ${base.audience} en base`);
  }

  if (c.location.trim().toLowerCase() !== base.default_location.trim().toLowerCase()) {
    ecarts.push(`lieu : ${c.location} ici, ${base.default_location} en base`);
  }

  return ecarts;
};
/**
 * LES SÉANCES ACHETABLES À L'UNITÉ, pour la phrase qui suit la grille.
 *
 * Elle se construisait public par public, sur `enBase` — les créneaux au
 * forfait. Deux erreurs en une : elle annonçait encore « 35 € pour les ados et
 * les enfants », un tarif qu'on ne peut plus acheter depuis que la séance à
 * l'unité ne leur est plus proposée ; et elle ne pouvait pas voir la séance du
 * jeudi soir, précisément parce que celle-ci n'est PAS au forfait.
 *
 * `lireTarifs` regarde les créneaux `a_l_unite`, qui sont exactement ceux
 * qu'on peut acheter à la séance — la question que cette phrase pose.
 */
const offresUnite = (await lireTarifs())?.seances ?? [];
const phraseUnite = prixDesOffres(offresUnite);

/*
 * Les deux ternaires que ces lignes remplaçaient rangeaient tout public autre
 * qu'« enfants » chez les adultes. La carte des ados se serait donc intitulée
 * « Pour les adultes », au-dessus de la grille ados — le genre de faute qui ne
 * se voit pas à la relecture du code et saute aux yeux sur la page.
 */
const tarifs = tarifsPage.map((t) => ({
  ...t,
  titre: titreAudience(t.audience),
  public: t.audience,
}));

/**
 * La mention de l'adhésion, son montant repris de `ADHESION_CENTS`.
 *
 * LA PHRASE APPARTIENT AU CMS, LE NOMBRE À L'APPLICATION — le même partage que
 * partout ailleurs sur cette page. Isabelle écrit « S'y ajoute l'adhésion à
 * l'association Les P'tits Piafs, 15 € par an et par famille » ; le 15 est
 * remplacé par celui que le parcours d'achat facturera réellement, de sorte
 * qu'une cotisation revue à l'assemblée générale ne laisse pas la page
 * promettre l'ancienne.
 */
const noteAdhesion = page.adhesionNote
  ? page.adhesionNote.replace(/\d+(?:[.,]\d+)?(\s*€)/, `${montantFr(ADHESION_CENTS)}$1`)
  : '';

/**
 * Comment se règle un forfait : « En 9 mensualités ou en une fois. »
 *
 * LE NOMBRE VIENT DE LA BASE, comme le reste — neuf pour les adultes et les
 * ados, dix pour les enfants, et c'est `mensualites` qui le dit. Dit une seule
 * fois sous les deux formules plutôt que répété dans chacune : c'est la même
 * facilité de paiement pour l'une et pour l'autre.
 *
 * Les deux formules d'un même public partagent leur nombre d'échéances
 * aujourd'hui ; si elles venaient à diverger, la phrase les nomme toutes plutôt
 * que d'en choisir une.
 */
function reglementDe(audience: string): string {
  const echeances = [...new Set(
    (formules ?? []).filter((f) => f.audience === audience).map((f) => f.mensualites),
  )].sort((a, b) => a - b);

  if (!echeances.length) return '';
  return echeances.length === 1
    ? `En ${echeances[0]} mensualités ou en une fois.`
    : `En ${echeances.join(' ou ')} mensualités, ou en une fois.`;
}

/**
 * Ce groupe a-t-il seulement une date à venir ?
 *
 * VERDALLE N'EN A AUCUNE : ses séances « se calent avec le groupe ». Lui
 * afficher « 36 €/mois, environ 1 séance/mois » promettait un rythme que
 * personne ne peut tenir, et un forfait que la page d'inscription refuse déjà
 * de vendre — elle écarte les créneaux sans date, faute de quoi on paierait une
 * saison qu'aucune inscription d'office ne pourrait honorer.
 *
 * La règle vaut pour tous, pas pour Verdalle seul : un groupe retrouve son
 * tarif dès qu'on lui programme des dates, sans qu'on y touche.
 */
const groupeOuvert = (g: { items: readonly { name: string }[] }) =>
  g.items.some((c) => datesDe(c.name).length > 0);

/**
 * Une ligne de la grille, tout entière déduite de la base.
 *
 * « 18 séances — 59 €/mois (531 € au total), environ 2 séances/mois — soit
 * 29,50 € la séance, 18 % moins cher »
 *
 * POURQUOI ELLE N'EST PLUS ÉCRITE DANS LE CMS. La grille tenait ses phrases
 * d'Isabelle, où `grilleAvecPrixDeLaBase` venait glisser les nombres. Ce
 * partage tenait tant que la ligne ne disait que ce qui s'écrit : « environ une
 * fois par mois sur la saison ». Il ne tient plus dès qu'elle compare deux
 * formules — le prix à la séance et l'écart en pourcentage ne se saisissent
 * pas, ils se calculent, et un tarif modifié en base les aurait laissés faux
 * dans le CMS.
 *
 * L'AVANTAGE SE MESURE CONTRE LA PLUS PETITE FORMULE du même public, celle
 * qu'on prend par défaut. C'est bien elle la référence : « moins cher » n'a de
 * sens que par rapport à ce qu'on aurait payé autrement.
 */
interface LigneTarif {
  produit: string;
  mensuel: string;
  /** Le reste de la phrase : total, rythme, et l'avantage s'il y en a un. */
  suite: string;
}

function lignesDe(audience: string): LigneTarif[] {
  const desSiens = (formules ?? [])
    .filter((f) => f.audience === audience)
    .sort((a, b) => a.seances - b.seances);

  if (!desSiens.length) return [];

  // La référence : la plus petite formule, et son prix à la séance.
  const reference = desSiens[0].prixCents / desSiens[0].seances;

  return desSiens.map((f) => {
    const parSeance = f.prixCents / f.seances;
    // Un pourcentage entier : 18,06 % s'annonce « 18 % ». La décimale ne dit
    // rien de plus à qui compare deux forfaits, et « 18,1 % » a l'air d'une
    // précision qu'on n'a pas.
    const ecart = Math.round((1 - parSeance / reference) * 100);

    /*
     * LE RYTHME EST UN ARRONDI, ET LE MOT « ENVIRON » LE DIT. Seize séances sur
     * dix mensualités font 1,6 par mois — un nombre qu'on n'annonce pas à un
     * parent. On dit « environ 2 », ce qui est la façon dont la saison se vit :
     * deux séances certains mois, une les autres.
     */
    const parMois = Math.max(1, Math.round(f.seances / f.mensualites));

    const rythme = `environ ${parMois} séance${parMois > 1 ? 's' : ''}/mois`;
    const avantage = ecart >= 1
      ? ` — soit ${montantFr(Math.round(parSeance))} € la séance, ${ecart} % moins cher`
      : '';

    return {
      produit: `${f.seances} séances`,
      mensuel: `${montantFr(Math.round(f.prixCents / f.mensualites))} €/mois`,
      suite: ` (${montantFr(f.prixCents)} € au total), ${rythme}${avantage}`,
    };
  });
}

/**
 * Le même calendrier que celui affiché, redit en `Course` — voir `schema.ts`.
 *
 * Les séances sont reprises de `enBase`, déjà chargé pour la page : le balisage
 * décrit alors exactement ce que le visiteur voit, ce qui est la condition posée
 * par Google et la seule qui garde les deux d'accord.
 */
const seancesSchema = (enBase ?? []).flatMap((c) =>
  ((c.sessions ?? []) as any[])
    .filter((s) => s.status === 'scheduled' && s.starts_at > maintenant)
    .map((s) => ({
      nom: c.label,
      debut: s.starts_at,
      fin: s.ends_at,
      lieu: c.default_location,
      // `null / 100` vaut 0 en JavaScript, et `buildCourseSchema` écarte
      // déjà les prix nuls — le zéro ne sortait donc pas. Mais il sortait par
      // accident : le jour où le filtre change, un créneau au forfait
      // annoncerait « gratuit » à Google. On dit explicitement qu'il n'y a pas
      // de prix.
      prix: c.default_unit_price_cents === null ? null : c.default_unit_price_cents / 100,
    })),
);

const courseSchema = buildCourseSchema({
  name: page.title,
  description: descriptionSeo,
  pageUrl: new URL(Astro.url.pathname, Astro.site).toString(),
  siteUrl,
  settings,
  seances: seancesSchema,
  charge: page.tarifs?.[0]?.dureeSeance,
  lieuParDefaut: 'Revel',
});
---

<BaseLayout title={page.title} description={descriptionSeo}
            ogImage={ogImage}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify([...schemas, courseSchema]).replace(/<\//g, '<\\/')} />
  </Fragment>

  <AvisProvisoire texte={settings?.avisProvisoire} />

  {/* `flush` : la marge basse du héros doublait celle de l'introduction. */}
  <Hero flush title={page.title} subtitle={page.subtitle}
        coverImage={couverture ?? undefined} altText={page.coverImageAlt ?? undefined} />


  {/*
    UN BOUTON HAUT, MAINTENANT QUE LA PAGE VEND. Elle n'en portait qu'un seul,
    sous la grille des tarifs : qui revient s'inscrire — la moitié d'une rentrée
    — devait traverser tout le calendrier pour le trouver. Il ne s'agit plus
    d'écrire à Isabelle après avoir hésité, mais de reprendre sa place.
  */}
  {/*
    LE BOUTON VA DANS LE CRÉNEAU PRÉVU POUR LUI — le <slot> d'IntroSection —
    et non après la section. Posé dehors, il tombait sur la couture entre le
    fond chaud de l'introduction et la section suivante : la limite des deux
    couleurs le coupait en deux. Un composant ne sait pas ce qui le suit, mais
    il sait ce qu'il contient.
  */}
  {page.introduction && (
    <IntroSection text={page.introduction} cta={false} fond>
      {/*
        CE QU'ON ACHÈTE, DIT AVANT LES HORAIRES ET AVANT LES PRIX.
        « Un forfait s'achète pour la saison et se pose sur les dates de votre
        choix » répond à la question que pose toute grille d'abonnement — suis-je
        tenu de venir tel jour ? — et il valait mieux y répondre au seuil de la
        page qu'à mi-chemin, une fois les créneaux parcourus sans savoir ce
        qu'on en ferait.

        Elle s'y trouvait, en tête de la section des tarifs ; elle est ici et
        n'y est plus. Deux fois la même phrase sur une page, c'est une phrase
        qu'on cesse de lire.
      */}
      {page.tarifsIntro && (
        <p class="mt-4 text-[var(--color-text-light)]">{page.tarifsIntro}</p>
      )}

      {page.inscriptionLabel && page.inscriptionUrl && (
        <p class="mt-8">
          <a href={page.inscriptionUrl}
             class="inline-block rounded-[var(--radius-button)] bg-[var(--color-button)] px-8 py-3 font-medium text-white">
            {page.inscriptionLabel}
          </a>
        </p>
      )}
    </IntroSection>
  )}

  {groupes.length > 0 && (
    <section class="pt-8 pb-16 md:pt-10 md:pb-20">
      <div class="mx-auto max-w-4xl px-4">
        <h2 class="mb-6 text-center text-2xl md:text-3xl font-bold text-[var(--color-heading)]">
          {page.creneauxSectionTitle}
        </h2>

        {/*
          UNE SEULE LISTE, en cartes, découpée par lieu et par public.

          Il y a eu un temps deux sections : une grille de cartes, puis les mêmes
          créneaux détaillés en dessous. Mêmes noms, mêmes horaires, mêmes titres
          de groupe à quelques centimètres d'écart — la grille se justifiait tant
          qu'elle portait les tarifs, partis depuis en tête de page.

          Le calendrier entre donc dans la carte, replié au-delà des trois
          prochaines dates. Sept créneaux à vingt dates faisaient un rouleau où
          l'on ne trouvait plus les créneaux eux-mêmes.
        */}
        <nav class="mb-12 flex flex-wrap justify-center gap-3">
          {groupes.map((g) => (
            <a
              href={`#${g.id}`}
              class="inline-block rounded-[var(--radius-button)] border-2 border-[var(--color-button)] px-5 py-2 text-sm font-medium text-[var(--color-button)] transition-colors hover:bg-[var(--color-button)] hover:text-white"
            >
              {g.label}
            </a>
          ))}
        </nav>

        {absentsDuContenu.length > 0 && (
          <div class="mb-10 rounded-xl border border-[var(--color-button)] p-4 text-sm">
            <p class="font-semibold text-[var(--color-button)]">
              En base mais absents de cette page
            </p>
            <ul class="mt-1 list-disc space-y-0.5 pl-5 text-[var(--color-text)]">
              {absentsDuContenu.map((c) => (
                <li>{c.label} — à décrire dans le CMS pour qu'il s'affiche</li>
              ))}
            </ul>
          </div>
        )}

        {groupes.map((g) => (
          <div id={g.id} class="mb-14 scroll-mt-24 last:mb-0">
            <h3 class="mb-1 text-xl md:text-2xl font-bold text-[var(--color-heading)]">
              {g.label}
            </h3>

            {/*
              LE TARIF SOUS LE TITRE DE SON PUBLIC. « Revel — Adultes »
              annonçait des horaires sans dire ce qu'ils coûtent, et il fallait
              descendre trois écrans pour retrouver son public dans la grille.

              APPARIÉ PAR PUBLIC, jamais par position : les lignes des ados sous
              le titre des ados, quel que soit l'ordre des deux listes. C'est la
              faute que cette page a déjà connue, du temps où deux ternaires
              rangeaient tout public autre qu'« enfants » chez les adultes.
            */}
            {groupeOuvert(g) && lignesDe(g.audience).length > 0 && (
              <div class="mb-6">
                <ul class="space-y-1">
                  {lignesDe(g.audience).map((l) => (
                    <li class="text-sm text-[var(--color-text-light)]">
                      <span class="font-semibold text-[var(--color-heading)]"
                      >{l.produit}</span>{' — '}<span
                        class="font-semibold text-[var(--color-button)]"
                      >{l.mensuel}</span>{l.suite}
                    </li>
                  ))}
                </ul>
                {reglementDe(g.audience) && (
                  <p class="mt-1 text-sm text-[var(--color-text-light)]">
                    {reglementDe(g.audience)}
                  </p>
                )}
                {noteAdhesion && (
                  <p class="mt-1 text-sm text-[var(--color-text-light)]">{noteAdhesion}</p>
                )}
              </div>
            )}

            {/* Deux colonnes au plus : une liste de dates a besoin de sa largeur. */}
            <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
              {g.items.map((c) => (
                <div
                  id={`detail-${toSlug(c.name)}`}
                  class="scroll-mt-24 rounded-xl bg-white p-5 shadow-md dark:bg-[var(--color-card-bg)]"
                >
                  <h4 class="text-lg font-bold text-[var(--color-heading)]">{c.name}</h4>
                  <p class="text-sm text-[var(--color-text-light)]">{c.day}</p>
                  {/*
                    L'horaire monte en évidence : il ne se répète plus sur chaque
                    date, c'est donc ici qu'on le lit — une seule fois, mais
                    lisiblement.

                    UN CRÉNEAU SANS HORAIRE N'EN AFFICHE AUCUN, ni la durée qui
                    s'en déduit. Les deux ateliers de Verdalle se donnent « sur
                    demande » et n'ont aucune date au programme : « de 9h30 à
                    12h30 · 3 h par séance » y annonçait un rendez-vous précis
                    que rien ne tient, et invitait à venir un jeudi matin où
                    personne n'ouvre. Vider l'horaire dans le CMS retire la
                    ligne entière — la durée suit, n'étant que l'écart entre
                    deux heures qu'on cesse d'annoncer.
                  */}
                  <div class="mb-4">
                    {c.time && (
                      <p class="font-medium text-[var(--color-heading)]">
                        {c.time}
                        {dureeDe(c.name) && ` · ${dureeDe(c.name)} par séance`}
                      </p>
                    )}
                    {placesDe(c.name) && (
                      <p class="text-sm text-[var(--color-button)]">
                        {placesDe(c.name)} places par séance
                      </p>
                    )}
                    {c.note && (
                      <p class="text-sm text-[var(--color-text-light)]">{c.note}</p>
                    )}
                  </div>

                  {ecartsDe(c).length > 0 && (
                    <div class="mb-4 rounded-xl border border-[var(--color-button)] p-3 text-sm">
                      <p class="font-semibold text-[var(--color-button)]">
                        Écart entre cette page et la base
                      </p>
                      <ul class="mt-1 list-disc space-y-0.5 pl-5 text-[var(--color-text)]">
                        {ecartsDe(c).map((e) => <li>{e}</li>)}
                      </ul>
                    </div>
                  )}

                  <div class="rounded-xl bg-[var(--color-bg-accent)] p-4">
                    <p class="mb-2 text-sm font-semibold text-[var(--color-heading)]">
                      {page.calendarLabel}
                    </p>
                    <CalendrierCreneau
                      seances={datesDe(c.name)}
                      erreur={Boolean(error)}
                      limite={3}
                      heuresEnTete={true}
                      contact={!inconnuEnBase(c.name)}
                      vide={inconnuEnBase(c.name)
                        ? 'Ce créneau n’existe pas encore en base — à créer avant la bascule.'
                        : undefined}
                    />
                  </div>

                  {/*
                    « SÉLECTIONNER » PLUTÔT QUE « S'INSCRIRE » : on désigne un
                    créneau, on ne conclut pas — le formulaire demandera encore
                    la formule et le règlement. Le lien l'emporte pour éviter de
                    le rechercher dans une liste de sept où l'on vient
                    justement de le lire.

                    PAS DE BOUTON SANS DATE. Un créneau sans séance programmée
                    n'est pas vendable : la page d'inscription l'écarte déjà de
                    sa liste, et l'y envoyer mènerait à un choix introuvable.
                  */}
                  {page.creneauChoisirLabel && page.inscriptionUrl
                    && idDe(c.name) && datesDe(c.name).length > 0 && (
                    <p class="mt-4">
                      <a href={`${page.inscriptionUrl}?creneau=${encodeURIComponent(idDe(c.name)!)}`}
                         class="inline-block rounded-[var(--radius-button)] bg-[var(--color-button)] px-5 py-2 text-sm font-medium text-white no-underline">
                        {page.creneauChoisirLabel}
                      </a>
                    </p>
                  )}
                </div>
              ))}
            </div>

            {/*
              MARGE POSITIVE : le « -mt-6 » d'origine remontait ce lien contre
              le bouton de contact qui le précédait. Ce bouton retiré, la marge
              négative le faisait chevaucher les cartes.
            */}
            {page.tarifsLienLabel && tarifs.length > 0 && (
              <p class="mt-6 text-center">
                <a href="#tarifs" class="text-sm font-medium text-[var(--color-button)] underline">
                  {page.tarifsLienLabel}
                </a>
              </p>
            )}
          </div>
        ))}
      </div>
    </section>
  )}

  {/*
    LA PREUVE AVANT LE PRIX. Les témoignages arrivaient après la grille et après
    le seul bouton de la page : ils ne pouvaient donc convaincre personne au
    moment où l'on décide. Ils la précèdent désormais.
  */}
  <Temoignages page="ateliers" />

  {tarifs.length > 0 && (
    <section id="tarifs" class="scroll-mt-24 bg-[var(--color-bg-accent)] py-16 md:py-20">
      <div class="mx-auto max-w-2xl px-4">
        <h2 class="mb-4 text-center text-2xl md:text-3xl font-bold text-[var(--color-heading)]">
          {page.tarifsTitle}
        </h2>

        {/*
          UNE SEULE COLONNE, du public le plus âgé au plus jeune. Côte à côte,
          les cartes invitaient à une comparaison que personne ne fait : on sait
          pour qui l'on vient. L'ordre suffit à hiérarchiser, à l'identique sur
          téléphone et sur écran, sans dépliant ni bouton à découvrir — et il
          tient aussi bien à trois publics qu'à deux, là où deux colonnes
          auraient dû être repensées à l'arrivée des ados.
        */}
        <div class="space-y-6">
          {tarifs.map((t) => (
            <div class="rounded-xl bg-white p-5 shadow-md dark:bg-[var(--color-card-bg)]">
              <h3 class="text-lg font-bold text-[var(--color-heading)]">{t.titre}</h3>
              {t.dureeSeance && (
                <p class="mb-4 text-sm text-[var(--color-text-light)]">{t.dureeSeance}</p>
              )}
              <ul class="space-y-4">
                {(t.formules ?? []).map((f) => (
                  <li>
                    {/*
                      Ce qu'on achète et ce que ça coûte, côte à côte : le nombre
                      de séances est le produit, le prix mensuel la façon de le
                      régler. Séparés, on lisait un prix sans savoir de quoi.
                      Un seul chiffre en couleur — six accents de même force ne
                      donnaient à l'œil aucun endroit où se poser.
                    */}
                    <p class="flex flex-wrap items-baseline gap-x-3">
                      <span class="text-lg font-semibold text-[var(--color-heading)]">
                        {f.seances}
                      </span>
                      <span class="text-lg font-semibold text-[var(--color-button)]">
                        {f.mensuel}
                      </span>
                    </p>
                    {f.detail && (
                      <p class="text-sm text-[var(--color-text-light)]">{f.detail}</p>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>

        {/*
          La séance à l'unité sort des cartes : c'est l'essai de qui hésite
          encore, non une troisième formule à comparer aux deux autres. Les
          montants viennent de la base, où ils facturent aussi les séances
          au-delà du forfait.
        */}
        {page.tarifsUniteQuestion && phraseUnite && (
          <p class="mt-8 text-center text-[var(--color-text)]">
            {/*
              LE PRÉFIXE « La séance est à » A DISPARU. Il complétait un montant
              nu — « 45 € » — quand la phrase se construisait public par public.
              L'offre porte désormais son unité (« 45 € la séance de 3 h »), et
              le préfixe la redisait : « La séance est à 45 € la séance de 3 h ».
            */}
            {/*
              LA PHRASE MÈNE À LA PAGE QU'ELLE DÉCRIT. Elle posait la question
              — « vous préférez venir une seule fois ? » — et laissait le
              lecteur la résoudre seul, alors que la réponse a sa page. Le
              montant porte le lien : c'est lui qu'on lit, et il était déjà
              coloré comme un lien sans en être un.
            */}
            {page.tarifsUniteQuestion}{' '}
            <a href="/seances-sans-engagement/"
               class="font-semibold text-[var(--color-button)] underline">{phraseUnite}</a>.
          </p>
        )}

        {page.tarifsNote && (
          <p class="mt-4 text-center text-sm text-[var(--color-text-light)]">
            {page.tarifsNote}
          </p>
        )}

        {/*
          LE SEUL BOUTON DE LA PAGE, sous la grille : c'est là qu'on décide, les
          prix sous les yeux. Les « Demander une place dans un créneau » qui le
          précédaient ont été retirés — on n'écrit plus pour demander une place,
          on la prend.
        */}
        {page.inscriptionLabel && page.inscriptionUrl && (
          <p class="mt-8 text-center">
            <a href={page.inscriptionUrl}
               class="inline-block rounded-[var(--radius-button)] bg-[var(--color-button)] px-8 py-3 font-medium text-white">
              {page.inscriptionLabel}
            </a>
          </p>
        )}

      </div>
    </section>
  )}


  <FaqSection title={page.faqSectionTitle} items={faqItems} fond cta={false} />

  {/*
    LE DERNIER BOUTON EST APRÈS LA FAQ, et non avant : c'est là qu'on a fini de
    lever ses objections. Le laisser uniquement sous la grille obligeait à
    remonter la page pour agir sur une décision qu'on venait de prendre.
  */}
  {page.inscriptionLabel && page.inscriptionUrl && (
    <section class="py-12 md:py-16">
      <p class="px-4 text-center">
        <a href={page.inscriptionUrl}
           class="inline-block rounded-[var(--radius-button)] bg-[var(--color-button)] px-8 py-3 font-medium text-white">
          {page.inscriptionLabel}
        </a>
        <span class="mt-3 block text-sm text-[var(--color-text-light)]">
          Vous choisirez vos dates ensuite, et pourrez en changer jusqu’à 10 jours avant chaque séance.
        </span>
      </p>
    </section>
  )}

  {page.crossLinksText && (
    <CrossLinksSection text={page.crossLinksText} excludeHref="/ateliers-reguliers/" />
  )}
</BaseLayout>
