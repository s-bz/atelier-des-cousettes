---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import AvisProvisoire from '../components/AvisProvisoire.astro';
import IntroSection from '../components/IntroSection.astro';
import CrossLinksSection from '../components/CrossLinksSection.astro';
import CalendrierCreneau from '../components/CalendrierCreneau.astro';
import ContactCTA from '../components/ContactCTA.astro';
import FaqSection from '../components/FaqSection.astro';
import Temoignages from '../components/Temoignages.astro';
import { getPageContext, reader } from '../utils/reader';
import { resolveImage, resolveImageUrl } from '../utils/images';
import { toSlug } from '../utils/strings';
import { buildCourseSchema, buildServicePageSchemas } from '../utils/schema';
import { fourchetteForfaits } from '../utils/tarifs';
import { getAdminClient } from '../utils/supabase';
import { ATELIER_GROUPS } from '../utils/ateliers';

/**
 * Les ateliers réguliers : leurs dates et leur disponibilité lues en base.
 *
 * LES DATES NE SONT PLUS RECOPIÉES. Elles l'étaient dans le CMS, et la page a
 * passé une saison entière à annoncer les samedis de l'année précédente — même
 * jour de la semaine, un an trop tôt, ce qui ne se voit pas. Une date qui vient
 * de la base ne peut plus mentir sans que l'écran des séances mente aussi.
 *
 * CE QUI RESTE AU CONTENU, ET POURQUOI : les forfaits. Ils n'existent pas en
 * base. `default_unit_price_cents` est le prix d'une séance HORS forfait — 45 €
 * pour un adulte, 35 € pour un enfant — et non le forfait d'une saison.
 * Afficher l'un à la place de l'autre ne serait pas une simplification mais une
 * erreur de prix. Le prix à l'unité, lui, est lu en base : c'est celui qui sert
 * à facturer, et deux endroits pour un seul montant finiraient par diverger.
 *
 * Rendue à la demande, et non à la construction : une place prise ce matin doit
 * se voir cet après-midi.
 */

const page = await reader.singletons.ateliersReguliers.read();
if (!page) throw new Error('Contenu des ateliers réguliers introuvable');

const { settings, siteUrl } = await getPageContext(Astro.site);

/*
 * La description SEO annonçait « De 25€ à 55€ par mois » — deux chiffres d'une
 * grille tarifaire qui n'existe plus. Elle garde ses mots, mais prend ses
 * nombres dans la grille affichée juste en dessous.
 */
const grille = fourchetteForfaits(page.tarifs);
const descriptionSeo = grille
  ? page.seoDescription.replace(/De\s+\d+\s*€\s+à\s+\d+\s*€/i, grille)
  : page.seoDescription;

const coverGlob = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/covers/**/*.{jpg,jpeg,png,webp}');
const couverture = await resolveImage(page.coverImage, coverGlob);
const ogImage = await resolveImageUrl(page.coverImage, coverGlob, Astro.site);

const faqItems = page.faqItems ?? [];
/*
 * `descriptionSeo` ET NON `page.seoDescription`, ici comme dans la balise meta.
 *
 * Le correctif ci-dessus ne portait que sur ce qu'un visiteur lit ; le JSON-LD,
 * lui, continuait d'annoncer « De 25€ à 55€ par mois » à Google et aux moteurs
 * de réponse — la grille d'avant, dans le seul endroit de la page que personne
 * ne relit. Deux phrases pour un seul prix, et c'est la version fausse qui
 * partait aux machines.
 */
const schemas = buildServicePageSchemas({
  title: page.title,
  seoDescription: descriptionSeo,
  pageUrl: new URL(Astro.url.pathname, Astro.site).toString(),
  siteUrl,
  settings,
  offers: page.schemaOffers ?? [],
  faqItems,
});

const creneaux = page.creneaux ?? [];
const groupes = ATELIER_GROUPS
  .map((g) => ({ ...g, items: creneaux.filter((c) => c.group === g.id) }))
  .filter((g) => g.items.length > 0);

const supabase = getAdminClient();

// Les séances à venir de chaque créneau d'atelier encore proposé. Un créneau
// archivé n'est plus au programme : montrer ses dates ferait espérer une
// inscription impossible.
const { data: enBase, error } = await supabase
  .from('creneaux')
  .select(`
    label, audience, default_location, default_start_time, default_end_time,
    default_unit_price_cents,
    sessions(starts_at, ends_at, capacity, places_attente, status, bookings(status))
  `)
  .eq('kind', 'atelier')
  .is('archived_at', null);

const maintenant = new Date().toISOString();

/**
 * Le pont entre les deux mondes est le NOM du créneau, seul identifiant commun :
 * le contenu ne connaît pas les identifiants de la base, et la base ignore
 * l'ordre des fiches du CMS. Comparaison insensible à la casse et aux espaces de
 * bord, un « Atelier du samedi matin » saisi à la main pouvant traîner une espace.
 */
const cle = (nom: string) => nom.trim().toLowerCase();

const parNom = new Map((enBase ?? []).map((c) => [cle(c.label), c]));

const datesDe = (nom: string) =>
  ((parNom.get(cle(nom))?.sessions ?? []) as any[]).filter(
    (s) => s.status === 'scheduled' && s.starts_at > maintenant,
  );

/**
 * Un créneau du contenu qu'aucune ligne de la base ne porte est une anomalie, pas
 * un créneau sans date. Le dire fait gagner du temps : c'est précisément ce que
 * cette page sert à découvrir avant de basculer les pages publiées.
 */
const inconnuEnBase = (nom: string) => !parNom.has(cle(nom));

/**
 * ET L'INVERSE : un créneau en base qu'aucune fiche du contenu ne décrit.
 *
 * Le contrôle ne regardait que dans un sens, et l'oubli s'est fait sentir dès
 * qu'un créneau est né en base : la page le passait sous silence, puisqu'elle
 * bâtit ses groupes à partir du contenu. Un créneau absent d'une page ne se
 * remarque pas — c'est exactement ce qu'un contrôle doit rattraper.
 */
const nomsDuContenu = new Set(creneaux.map((c) => cle(c.name)));
const absentsDuContenu = (enBase ?? []).filter((c) => !nomsDuContenu.has(cle(c.label)));

/** « 3 h », « 2 h 30 » — la durée d'une séance, lue sur les horaires du créneau. */
const enHeures = (debut: string, fin: string) => {
  const min = (t: string) => Number(t.slice(0, 2)) * 60 + Number(t.slice(3, 5));
  const m = min(fin) - min(debut);
  return m <= 0 ? null : m % 60 === 0 ? `${m / 60} h` : `${Math.floor(m / 60)} h ${m % 60}`;
};

const dureeDe = (nom: string) => {
  const c = parNom.get(cle(nom));
  return c ? enHeures(c.default_start_time, c.default_end_time) : null;
};

/**
 * Les horaires écrits à la main, ramenés à des minutes pour être comparables.
 *
 * Le contenu les note « 14h à 17h », « de 9h30 à 12h » ; la base « 14:00:00 ».
 * Sans cette réduction, toute comparaison signalerait un écart sur chaque ligne.
 */
const enMinutes = (texte: string) => {
  const bornes = [...texte.matchAll(/(\d{1,2})\s*h\s*(\d{2})?/g)]
    .map((m) => Number(m[1]) * 60 + Number(m[2] ?? 0));
  return bornes.length === 2 ? bornes : null;
};

/**
 * CE QUE LE CONTENU ET LA BASE NE DISENT PAS PAREIL.
 *
 * C'est la raison d'être de cette page. Les deux sources décrivent les mêmes
 * ateliers, et rien ne les tient d'accord : le contenu se modifie dans le CMS,
 * la base dans l'espace d'administration. Tant que les deux vivent, elles
 * divergent — et la page affiche alors des horaires ou un public que les
 * règles d'inscription ignorent.
 *
 * Les afficher ici les fait remarquer avant la bascule, plutôt qu'un adhérent
 * ne les découvre devant une porte close.
 */
const ecartsDe = (c: { name: string; time: string; location: string; group: string }) => {
  const base = parNom.get(cle(c.name));
  if (!base) return [];
  const ecarts: string[] = [];

  const horairesContenu = enMinutes(c.time);
  const horairesBase = enMinutes(
    `${Number(base.default_start_time.slice(0, 2))}h${base.default_start_time.slice(3, 5)} à ` +
    `${Number(base.default_end_time.slice(0, 2))}h${base.default_end_time.slice(3, 5)}`,
  );
  if (horairesContenu && horairesBase &&
      (horairesContenu[0] !== horairesBase[0] || horairesContenu[1] !== horairesBase[1])) {
    ecarts.push(
      `horaires : « ${c.time} » ici, ` +
      `${base.default_start_time.slice(0, 5)}–${base.default_end_time.slice(0, 5)} en base`,
    );
  }

  const publicContenu = ATELIER_GROUPS.find((g) => g.id === c.group)?.audience;
  if (publicContenu && publicContenu !== base.audience) {
    ecarts.push(`public : ${publicContenu} ici, ${base.audience} en base`);
  }

  if (c.location.trim().toLowerCase() !== base.default_location.trim().toLowerCase()) {
    ecarts.push(`lieu : ${c.location} ici, ${base.default_location} en base`);
  }

  return ecarts;
};
/**
 * Le prix d'une séance sans engagement, par public — LU EN BASE.
 *
 * C'est le même montant qui facture une séance dépassant le forfait. Le
 * recopier dans le CMS en aurait fait deux, promis d'un côté et facturé de
 * l'autre, et ils auraient divergé en une saison.
 */
const prixSeanceDe = (audience: string) => {
  const c = (enBase ?? []).find((x) => x.audience === audience);
  return c ? `${(c.default_unit_price_cents / 100).toFixed(0)} €` : null;
};

const tarifs = (page.tarifs ?? []).map((t) => ({
  ...t,
  titre: t.audience === 'enfants' ? 'Pour les enfants' : 'Pour les adultes',
  // « adultes » / « enfants » seuls, pour la phrase de la séance à l'unité.
  public: t.audience === 'enfants' ? 'enfants' : 'adultes',
  prixSeance: prixSeanceDe(t.audience),
}));

/**
 * Le même calendrier que celui affiché, redit en `Course` — voir `schema.ts`.
 *
 * Les séances sont reprises de `enBase`, déjà chargé pour la page : le balisage
 * décrit alors exactement ce que le visiteur voit, ce qui est la condition posée
 * par Google et la seule qui garde les deux d'accord.
 */
const seancesSchema = (enBase ?? []).flatMap((c) =>
  ((c.sessions ?? []) as any[])
    .filter((s) => s.status === 'scheduled' && s.starts_at > maintenant)
    .map((s) => ({
      nom: c.label,
      debut: s.starts_at,
      fin: s.ends_at,
      lieu: c.default_location,
      prix: c.default_unit_price_cents / 100,
    })),
);

const courseSchema = buildCourseSchema({
  name: page.title,
  description: descriptionSeo,
  pageUrl: new URL(Astro.url.pathname, Astro.site).toString(),
  siteUrl,
  settings,
  seances: seancesSchema,
  charge: page.tarifs?.[0]?.dureeSeance,
  lieuParDefaut: 'Revel',
});
---

<BaseLayout title={page.title} description={descriptionSeo}
            ogImage={ogImage}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify([...schemas, courseSchema]).replace(/<\//g, '<\\/')} />
  </Fragment>

  <AvisProvisoire texte={settings?.avisProvisoire} />

  {/* `flush` : la marge basse du héros doublait celle de l'introduction. */}
  <Hero flush title={page.title} subtitle={page.subtitle}
        coverImage={couverture ?? undefined} altText={page.coverImageAlt ?? undefined} />


  {/*
    Pas de bouton sous l'introduction : la page en compte déjà cinq plus bas, un
    par lieu puis sous les tarifs et la FAQ. Celui-ci arrivait avant qu'on ait lu
    de quoi décider — et un bouton répété six fois cesse d'être remarqué.
  */}
  {page.introduction && <IntroSection text={page.introduction} cta={false} fond />}

  {groupes.length > 0 && (
    <section class="pt-8 pb-16 md:pt-10 md:pb-20">
      <div class="mx-auto max-w-4xl px-4">
        <h2 class="mb-6 text-center text-2xl md:text-3xl font-bold text-[var(--color-heading)]">
          {page.creneauxSectionTitle}
        </h2>

        {/*
          UNE SEULE LISTE, en cartes, découpée par lieu et par public.

          Il y a eu un temps deux sections : une grille de cartes, puis les mêmes
          créneaux détaillés en dessous. Mêmes noms, mêmes horaires, mêmes titres
          de groupe à quelques centimètres d'écart — la grille se justifiait tant
          qu'elle portait les tarifs, partis depuis en tête de page.

          Le calendrier entre donc dans la carte, replié au-delà des trois
          prochaines dates. Sept créneaux à vingt dates faisaient un rouleau où
          l'on ne trouvait plus les créneaux eux-mêmes.
        */}
        <nav class="mb-12 flex flex-wrap justify-center gap-3">
          {groupes.map((g) => (
            <a
              href={`#${g.id}`}
              class="inline-block rounded-[var(--radius-button)] border-2 border-[var(--color-button)] px-5 py-2 text-sm font-medium text-[var(--color-button)] transition-colors hover:bg-[var(--color-button)] hover:text-white"
            >
              {g.label}
            </a>
          ))}
        </nav>

        {absentsDuContenu.length > 0 && (
          <div class="mb-10 rounded-xl border border-[var(--color-button)] p-4 text-sm">
            <p class="font-semibold text-[var(--color-button)]">
              En base mais absents de cette page
            </p>
            <ul class="mt-1 list-disc space-y-0.5 pl-5 text-[var(--color-text)]">
              {absentsDuContenu.map((c) => (
                <li>{c.label} — à décrire dans le CMS pour qu'il s'affiche</li>
              ))}
            </ul>
          </div>
        )}

        {groupes.map((g) => (
          <div id={g.id} class="mb-14 scroll-mt-24 last:mb-0">
            <h3 class="mb-6 text-xl md:text-2xl font-bold text-[var(--color-heading)]">
              {g.label}
            </h3>

            {/* Deux colonnes au plus : une liste de dates a besoin de sa largeur. */}
            <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
              {g.items.map((c) => (
                <div
                  id={`detail-${toSlug(c.name)}`}
                  class="scroll-mt-24 rounded-xl bg-white p-5 shadow-md dark:bg-[var(--color-card-bg)]"
                >
                  <h4 class="text-lg font-bold text-[var(--color-heading)]">{c.name}</h4>
                  <p class="text-sm text-[var(--color-text-light)]">{c.day}</p>
                  {/*
                    L'horaire monte en évidence : il ne se répète plus sur chaque
                    date, c'est donc ici qu'on le lit — une seule fois, mais
                    lisiblement.
                  */}
                  <p class="mb-4 font-medium text-[var(--color-heading)]">
                    {c.time}
                    {dureeDe(c.name) && ` · ${dureeDe(c.name)} par séance`}
                    {c.note && (
                      <span class="block text-sm font-normal text-[var(--color-text-light)]">
                        {c.note}
                      </span>
                    )}
                  </p>

                  {ecartsDe(c).length > 0 && (
                    <div class="mb-4 rounded-xl border border-[var(--color-button)] p-3 text-sm">
                      <p class="font-semibold text-[var(--color-button)]">
                        Écart entre cette page et la base
                      </p>
                      <ul class="mt-1 list-disc space-y-0.5 pl-5 text-[var(--color-text)]">
                        {ecartsDe(c).map((e) => <li>{e}</li>)}
                      </ul>
                    </div>
                  )}

                  <div class="rounded-xl bg-[var(--color-bg-accent)] p-4">
                    <p class="mb-2 text-sm font-semibold text-[var(--color-heading)]">
                      {page.calendarLabel}
                    </p>
                    <CalendrierCreneau
                      seances={datesDe(c.name)}
                      erreur={Boolean(error)}
                      limite={3}
                      heuresEnTete={true}
                      contact={!inconnuEnBase(c.name)}
                      vide={inconnuEnBase(c.name)
                        ? 'Ce créneau n’existe pas encore en base — à créer avant la bascule.'
                        : undefined}
                    />
                  </div>
                </div>
              ))}
            </div>

            {/*
              Un bouton par groupe, au pied de ses cartes. Celui qui a trouvé son
              créneau à Revel n'a plus à traverser Verdalle pour trouver de quoi
              écrire — et l'on écrit au sujet d'un atelier précis, pas de la page.
            */}
            <ContactCTA label={page.ctaLabel} />
            {page.tarifsLienLabel && tarifs.length > 0 && (
              <p class="-mt-6 text-center">
                <a href="#tarifs" class="text-sm font-medium text-[var(--color-button)] underline">
                  {page.tarifsLienLabel}
                </a>
              </p>
            )}
          </div>
        ))}
      </div>
    </section>
  )}

  {tarifs.length > 0 && (
    <section id="tarifs" class="scroll-mt-24 bg-[var(--color-bg-accent)] py-16 md:py-20">
      <div class="mx-auto max-w-2xl px-4">
        <h2 class="mb-4 text-center text-2xl md:text-3xl font-bold text-[var(--color-heading)]">
          {page.tarifsTitle}
        </h2>

        {/*
          La souplesse avant les chiffres. « Suis-je tenue de venir tel jour ? »
          est la première inquiétude de qui lit une grille d'abonnement ; y
          répondre d'abord retire l'objection avant qu'un prix ne l'installe.
        */}
        {page.tarifsIntro && (
          <p class="mx-auto mb-10 max-w-xl text-center text-[var(--color-text)]">
            {page.tarifsIntro}
          </p>
        )}

        {/*
          UNE SEULE COLONNE, adultes puis enfants. Côte à côte, les deux cartes
          invitaient à une comparaison que personne ne fait : on sait pour qui
          l'on vient. L'ordre suffit à hiérarchiser, à l'identique sur téléphone
          et sur écran, sans dépliant ni bouton à découvrir.
        */}
        <div class="space-y-6">
          {tarifs.map((t) => (
            <div class="rounded-xl bg-white p-5 shadow-md dark:bg-[var(--color-card-bg)]">
              <h3 class="text-lg font-bold text-[var(--color-heading)]">{t.titre}</h3>
              {t.dureeSeance && (
                <p class="mb-4 text-sm text-[var(--color-text-light)]">{t.dureeSeance}</p>
              )}
              <ul class="space-y-4">
                {(t.formules ?? []).map((f) => (
                  <li>
                    {/*
                      Ce qu'on achète et ce que ça coûte, côte à côte : le nombre
                      de séances est le produit, le prix mensuel la façon de le
                      régler. Séparés, on lisait un prix sans savoir de quoi.
                      Un seul chiffre en couleur — six accents de même force ne
                      donnaient à l'œil aucun endroit où se poser.
                    */}
                    <p class="flex flex-wrap items-baseline gap-x-3">
                      <span class="text-lg font-semibold text-[var(--color-heading)]">
                        {f.seances}
                      </span>
                      <span class="text-lg font-semibold text-[var(--color-button)]">
                        {f.mensuel}
                      </span>
                    </p>
                    {f.detail && (
                      <p class="text-sm text-[var(--color-text-light)]">{f.detail}</p>
                    )}
                  </li>
                ))}
              </ul>
            </div>
          ))}
        </div>

        {/*
          La séance à l'unité sort des cartes : c'est l'essai de qui hésite
          encore, non une troisième formule à comparer aux deux autres. Les
          montants viennent de la base, où ils facturent aussi les séances
          au-delà du forfait.
        */}
        {page.tarifsUniteQuestion && tarifs.some((t) => t.prixSeance) && (
          <p class="mt-8 text-center text-[var(--color-text)]">
            {page.tarifsUniteQuestion}{' '}
            La séance est à{' '}
            {tarifs.filter((t) => t.prixSeance).map((t, i, liste) => (
              <Fragment>
                {i > 0 && (i === liste.length - 1 ? ' et ' : ', ')}
                <span class="font-semibold text-[var(--color-button)]">{t.prixSeance}</span>
                {' '}pour les {t.public}
              </Fragment>
            ))}.
          </p>
        )}

        {page.tarifsNote && (
          <p class="mt-4 text-center text-sm text-[var(--color-text-light)]">
            {page.tarifsNote}
          </p>
        )}

        {/* Agir sans avoir à repartir chercher un bouton plus bas. */}
        <ContactCTA label={page.ctaLabel} />
      </div>
    </section>
  )}

  <Temoignages page="ateliers" />

  <FaqSection title={page.faqSectionTitle} items={faqItems} ctaLabel={page.ctaLabel} fond />

  {page.crossLinksText && (
    <CrossLinksSection text={page.crossLinksText} excludeHref="/ateliers-reguliers/" />
  )}
</BaseLayout>
