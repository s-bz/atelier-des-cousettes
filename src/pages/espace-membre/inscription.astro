---
export const prerender = false;

import DevisEnDirect from '../../components/DevisEnDirect.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getAdminClient } from '../../utils/supabase';
import { lireCatalogueFormules, libelleFormule, heureCourte } from '../../utils/tarifs';
import { AUDIENCES } from '../../utils/ateliers';
import { saisonDe } from '../../utils/inscriptions';
import { ADHESION_CENTS } from '../../utils/helloasso';
import { demarrerAchat, adhesionDuePour } from '../../utils/achat';
import { mesurer } from '../../utils/mesure';

/*
 * L'ACHAT D'UN FORFAIT, DEPUIS L'ESPACE ADHÉRENT.
 *
 * Réservé à qui a déjà un compte : `connexion.astro` appelle `signInWithOtp`
 * avec `shouldCreateUser: false`, si bien qu'une famille nouvelle ne peut pas
 * se connecter avant d'avoir acheté. Elle passera par une route publique, qui
 * réutilisera tout ce qui suit — d'où la séparation entre ce que la page décide
 * et ce que `preparerAchat` met en forme.
 */

const { session, account } = Astro.locals;
if (!session) return Astro.redirect('/espace-membre/connexion/');
if (!account) return Astro.redirect('/espace-membre/connexion/?inconnu=1');

const supabase = getAdminClient();
const saison = saisonDe(new Date());

const [{ data: participants }, formules, { data: creneaux }] = await Promise.all([
  supabase.from('participants').select('id, first_name, last_name, audience')
    .eq('account_id', account.id).order('first_name'),
  lireCatalogueFormules(supabase),
  supabase.from('creneaux').select('id, label, audience, default_location, default_start_time, default_end_time')
    .eq('kind', 'atelier').eq('au_forfait', true).is('archived_at', null).order('label'),
]);

/*
 * ON NE VEND QUE LES CRÉNEAUX QUI ONT DES DATES.
 *
 * Verdalle n'en a aucune — ses séances « se calent avec le groupe ». Y vendre
 * un forfait ferait payer une saison qu'aucune inscription d'office ne pourrait
 * honorer : le planning resterait vide, faute de séance où poser une place.
 *
 * La règle vaut pour tous, pas pour Verdalle seul : un créneau retrouve sa
 * place dans la liste dès qu'on lui programme des dates, sans qu'on y touche.
 */
const { data: avecDates } = await supabase
  .from('sessions')
  .select('creneau_id')
  .eq('status', 'scheduled')
  .gt('starts_at', new Date().toISOString());

const ouvrables = new Set((avecDates ?? []).map((s) => s.creneau_id));
const creneauxVendables = (creneaux ?? []).filter((c) => ouvrables.has(c.id));

// L'adhésion se lit UNE FOIS, avant d'afficher : elle décide du montant annoncé
// autant que de celui qui sera prélevé.
const adhesionDue = await adhesionDuePour(supabase, account.email);

let erreur: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();

  const r = await demarrerAchat(supabase, {
    email: account.email,
    prenom: String(form.get('prenom') ?? ''),
    audience: String(form.get('audience') ?? 'adulte'),
    formule: formules.find((f) => f.id === String(form.get('formule') ?? '')),
    creneau: creneauxVendables.find((c) => c.id === String(form.get('creneau') ?? '')),
    comptant: form.get('reglement') === 'comptant',
    origine: Astro.url.origin,
    site: Astro.site,
    cheminAchat: '/espace-membre/inscription/',
    cheminRetour: '/espace-membre/inscription/retour/',
  });

  if (!r.ok) {
    erreur = r.erreur;
    // Le motif dit pourquoi une famille s'arrête là. Voir /ateliers-reguliers/inscription/.
    await mesurer('achat_refuse', account.email, { motif: r.erreur, depuis: '/espace-membre/inscription/' });
  }
  // `redirectUrl` ne vaut que quinze minutes : on y va tout de suite.
  else return Astro.redirect(r.valeur.redirectUrl, 303);
}

if (Astro.url.searchParams.has('echec')) {
  erreur = 'Le paiement n’a pas abouti. Rien n’a été prélevé — vous pouvez réessayer.';
  // HelloAsso renvoie ici quand le paiement n'a pas abouti. Rien n'a été
  // prélevé ; ce qui se mesure, c'est le renoncement au moment de payer.
  await mesurer('paiement_echoue', Astro.locals.account?.email ?? null, {
    depuis: '/espace-membre/inscription/',
  });
}

const euros = (c: number) => (c / 100).toFixed(2).replace('.', ',').replace(',00', '');
---

<BaseLayout title="S’inscrire aux ateliers" description="Choisir sa formule et régler son forfait." noIndex>
  <section class="mx-auto max-w-3xl px-4 py-16 md:py-20">
    <h1 class="text-2xl md:text-3xl font-bold" style="font-family: var(--font-heading)">
      S’inscrire aux ateliers réguliers
    </h1>
    <p class="mt-3 text-[var(--color-text)]">Saison {saison}.</p>

    {erreur && (
      <p class="mt-6 rounded-xl bg-[var(--color-bg-pink)] px-4 py-3 text-white">{erreur}</p>
    )}

    {adhesionDue ? (
      <p class="mt-6 rounded-xl bg-[var(--color-bg-accent)] px-4 py-3 text-sm">
        L’adhésion à l’association, <strong>{euros(ADHESION_CENTS)} € par an et par famille</strong>,
        s’ajoutera au premier versement. Elle vaut pour toute la saison, quel que soit le nombre
        de personnes que vous inscrivez.
      </p>
    ) : (
      <p class="mt-6 rounded-xl bg-[var(--color-bg-accent)] px-4 py-3 text-sm">
        Votre adhésion {saison} est déjà réglée : il n’y a que le forfait à payer.
      </p>
    )}

    <form method="post" class="mt-8 space-y-6">
      <div>
        <label for="prenom" class="block text-sm font-medium mb-1">Qui s’inscrit ?</label>
        <input id="prenom" name="prenom" required class="champ"
               list="deja-inscrits" placeholder="Prénom et nom" />
        <datalist id="deja-inscrits">
          {(participants ?? []).map((p) => (
            <option value={`${p.first_name} ${p.last_name}`}></option>
          ))}
        </datalist>
        <p class="mt-1 text-sm text-[var(--color-text-light)]">
          Une inscription par personne. Pour inscrire quelqu’un d’autre, vous recommencerez
          ensuite — l’adhésion ne sera pas redemandée.
        </p>
      </div>

      <div>
        <label for="audience" class="block text-sm font-medium mb-1">Public</label>
        <select id="audience" name="audience" required class="champ">
          {AUDIENCES.map((a) => <option value={a.personne}>{a.label}</option>)}
        </select>
      </div>

      <div>
        <label for="formule" class="block text-sm font-medium mb-1">Formule</label>
        <select id="formule" name="formule" required class="champ">
          {formules.map((f) => (
            <option value={f.id} data-public={f.audience}>{libelleFormule(f, { prixDivise: false })}</option>
          ))}
        </select>
      </div>

      <div>
        <label for="creneau" class="block text-sm font-medium mb-1">Créneau</label>
        <select id="creneau" name="creneau" required class="champ">
          {creneauxVendables.map((c) => (
            <option value={c.id} data-public={c.audience}>
              {c.label} — {c.default_location} — {heureCourte(c.default_start_time)} à {heureCourte(c.default_end_time)}
            </option>
          ))}
        </select>
      </div>

      <fieldset>
        <legend class="block text-sm font-medium mb-1">Règlement</legend>
        <label class="flex items-center gap-2">
          <input type="radio" name="reglement" value="echelonne" checked />
          <span>Échelonné, un versement par mois</span>
        </label>
        <label class="mt-1 flex items-center gap-2">
          <input type="radio" name="reglement" value="comptant" />
          <span>En une seule fois</span>
        </label>
      </fieldset>

      <DevisEnDirect email={account.email} />

      <button type="submit"
              class="rounded-[var(--radius-button)] bg-[var(--color-button)] px-6 py-3 font-medium text-white">
        Régler sur HelloAsso
      </button>

      {/* Le nom du relevé ne sert qu'ici : il évite le « qui m'a prélevé ? » du lendemain. */}
      <p class="text-sm text-[var(--color-text-light)]">
        Le règlement se fait sur la page sécurisée de HelloAsso : votre relevé bancaire portera
        « Les P’tits Piafs », le nom de l’association.
      </p>
    </form>
  </section>
</BaseLayout>

<script>
  /* Les listes suivent le public choisi — même geste que sur l'écran d'admin. */
  const publics: Record<string, string> = { adulte: 'adultes', ado: 'ados', enfant: 'enfants' };
  const audience = document.getElementById('audience');
  const listes = ['formule', 'creneau']
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLSelectElement => el instanceof HTMLSelectElement);

  function accorder() {
    if (!(audience instanceof HTMLSelectElement)) return;
    const attendu = publics[audience.value];
    for (const liste of listes) {
      for (const option of liste.options) {
        const garde = option.dataset.public === attendu;
        option.hidden = !garde;
        option.disabled = !garde;
      }
      if (liste.selectedOptions[0]?.disabled) {
        const premier = [...liste.options].find((o) => !o.disabled);
        liste.selectedIndex = premier ? premier.index : -1;
      }
    }
  }

  if (audience && listes.length) {
    audience.addEventListener('change', accorder);
    accorder();
  }
</script>
