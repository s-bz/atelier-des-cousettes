---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import SelecteurParticipant from '../../components/SelecteurParticipant.astro';
import { getAdminClient } from '../../utils/supabase';
import { participantsDuCompte, soldeDe, libererPlace, dateLongue, heure } from '../../utils/membre';
import { notifier, notifierAdmin, variablesSeance, variablesAdmin } from '../../utils/emails';
import { mesurer } from '../../utils/mesure';

const { session, account, isAdmin } = Astro.locals;
if (!session) return Astro.redirect('/espace-membre/connexion/');
if (!account) return Astro.redirect('/espace-membre/connexion/?inconnu=1');

const supabase = getAdminClient();

/**
 * MODE ADMINISTRATION : Isabelle réserve pour quelqu'un d'autre.
 *
 * Un forfait plus grand que son créneau attitré laisse des séances à placer
 * ailleurs, et une partie des adhérents ne le fera pas en ligne. Sans ce mode,
 * il fallait un second écran de réservation, calqué sur celui-ci — donc deux
 * endroits à corriger le jour où la règle change.
 *
 * Le paramètre est `pour`, distinct de `personne` À DESSEIN. `personne` ne
 * choisit qu'au sein du compte connecté et n'accorde donc rien ; `pour` sort de
 * ce périmètre et n'est lu que si isAdmin. Deux noms pour deux portées, faute de
 * quoi la lecture du code demanderait de vérifier à chaque fois laquelle
 * s'applique.
 */
const pour = isAdmin ? Astro.url.searchParams.get('pour') : null;

type Personne = Awaited<ReturnType<typeof participantsDuCompte>>['personnes'][number];

let personnes: Personne[] = [];
let choisie: Personne | null = null;

// L'adresse de l'ADHÉRENT, et non celle du compte connecté : en mode
// administration, la confirmation doit partir chez la personne inscrite, pas
// chez Isabelle qui vient de cliquer.
let destinataire: string | null = account.email;

if (pour) {
  const { data } = await supabase
    .from('participants')
    .select('id, first_name, last_name, audience, accounts(email)')
    .eq('id', pour)
    .maybeSingle();

  if (!data) return new Response('Personne introuvable', { status: 404 });

  choisie = data as any;
  destinataire = (data as any).accounts?.email ?? null;
} else {
  ({ personnes, choisie } = await participantsDuCompte(
    account.id,
    Astro.url.searchParams.get('personne'),
  ));
}
let message: string | null = null;
let erreur: string | null = null;

if (Astro.request.method === 'POST' && choisie) {
  const form = await Astro.request.formData();
  const action = String(form.get('action') ?? '');

  // La personne visée vient de la session, JAMAIS du formulaire : sans cela,
  // n'importe qui pourrait réserver au nom d'un autre en modifiant un champ
  // caché. Les fonctions SQL vérifient déjà l'appartenance, ceci évite même
  // d'avoir à s'y fier.
  if (action === 'reserver') {
    const { error } = await supabase.rpc('book_participant', {
      p_session: String(form.get('seance')),
      p_participant: choisie.id,
      // La provenance dit qui a réellement posé la place, et elle s'affiche sur
      // la feuille de présence : « inscrit par vous » plutôt que « réservé en
      // ligne » quand c'est Isabelle qui a cliqué.
      p_source: pour ? 'admin' : 'member',
    });
    if (error) {
      // Le message de Postgres nomme la fonction, la contrainte et son RAISE :
      // il éclaire Isabelle dans le journal, pas l'adhérent devant l'écran.
      console.error('[planning] réservation refusée :', error.message);
      erreur = 'La réservation n’a pas pu être enregistrée.';
    } else {
      message = 'Place réservée.';
      const seanceId = String(form.get('seance'));

      /*
       * LA RÉSERVATION EST L'USAGE, ET NON L'ACHAT. Un forfait vendu ne dit
       * rien de ce qu'il devient : neuf séances payées et deux venues, c'est un
       * réabonnement qui ne reviendra pas. `par` distingue la place posée par
       * l'adhérent de celle qu'Isabelle pose pour lui depuis la feuille de
       * présence — les confondre ferait passer pour de l'autonomie ce qui est
       * du travail administratif.
       */
      await mesurer('place_reservee', destinataire, {
        par: pour ? 'admin' : 'adherent',
        session_id: seanceId,
      });
      const { data: s } = await supabase
        .from('sessions')
        .select('starts_at, ends_at, location, capacity, creneaux(label)')
        .eq('id', seanceId)
        .maybeSingle();
      if (s) {
        // Chez l'ADHÉRENT, dont l'adresse a été résolue plus haut. En mode
        // administration, `account.email` serait celle d'Isabelle : elle
        // recevrait la confirmation d'une séance qu'elle ne suit pas, et
        // l'inscrit n'en saurait rien.
        await notifier('confirmation', destinataire, variablesSeance({
          prenom: choisie.first_name,
          starts_at: s.starts_at,
          ends_at: s.ends_at,
          location: s.location,
        }));

        // Et Isabelle — sauf quand c'est elle qui vient de réserver. Seuls les
        // gestes des adhérents la préviennent : ses propres ajouts depuis la
        // feuille de présence et l'inscription d'office de la nuit n'envoient
        // rien. Être notifié de ce qu'on vient de faire soi-même apprend
        // surtout à ignorer ses notifications.
        const { count } = await supabase
          .from('bookings')
          .select('id', { count: 'exact', head: true })
          .eq('session_id', seanceId)
          .eq('status', 'booked');

        if (!pour) {
          await notifierAdmin('admin_reservation', variablesAdmin({
            participant: `${choisie.first_name} ${choisie.last_name ?? ''}`.trim(),
            starts_at: s.starts_at,
            ends_at: s.ends_at,
            location: s.location,
            creneau: (s.creneaux as any)?.label ?? null,
            occupees: count ?? 0,
            capacite: s.capacity,
          }));
        }
      }
    }
  }

  if (action === 'liberer') {
    const r = await libererPlace(String(form.get('reservation')), choisie.id);
    if (r.ok) message = r.message;
    else erreur = r.message;

    /*
     * LA PLACE LIBÉRÉE COMPTE AUTANT QUE LA PLACE PRISE. C'est elle qui dit si
     * le délai de dix jours est vivable, et si les créneaux du soir tiennent.
     * Le motif d'échec est un message écrit par nous — le plus souvent « trop
     * tard pour annuler », qui est une information et non une panne.
     */
    await mesurer(r.ok ? 'place_liberee' : 'place_liberee_refusee', destinataire, {
      par: pour ? 'admin' : 'adherent',
      ...(r.ok ? {} : { motif: r.message }),
    });
  }
}

let solde = 0;
let seances: any[] = [];
let mesReservations = new Map<string, string>();
const mesAttentes = new Set<string>();

if (choisie) {
  ({ solde } = await soldeDe(choisie.id));

  const debutDuJour = new Date();
  debutDuJour.setHours(0, 0, 0, 0);

  const { data } = await supabase
    .from('sessions')
    .select('id, starts_at, ends_at, location, capacity, status, creneaux!inner(label, audience, kind, places_attente), bookings(id, participant_id, status)')
    .gte('starts_at', debutDuJour.toISOString())
    .eq('status', 'scheduled')
    // Les séances d'un autre public ne sont pas seulement irréservables :
    // les montrer ferait espérer une place qui n'existe pas.
    .eq('creneaux.audience', `${choisie.audience}s`)
    // LES STAGES SONT EXCLUS. Un stage se paie à l'unité et ne consomme aucun
    // crédit : le laisser réservable ici le donnerait gratuitement, sans que
    // rien ne s'en aperçoive — ni le solde, ni la facture. Les inscriptions aux
    // stages passent par Isabelle jusqu'à ce que le paiement en ligne existe.
    .eq('creneaux.kind', 'atelier')
    .order('starts_at')
    .limit(60);

  seances = data ?? [];

  for (const s of seances) {
    // Inscrit OU en attente : dans les deux cas la ligne existe, et le bouton
    // doit permettre de s'en retirer plutôt que de proposer une seconde
    // inscription que la base refuserait.
    const mienne = (s.bookings ?? []).find(
      (b: any) => b.participant_id === choisie.id
        && (b.status === 'booked' || b.status === 'waiting'),
    );
    if (mienne) {
      mesReservations.set(s.id, mienne.id);
      if (mienne.status === 'waiting') mesAttentes.add(s.id);
    }
  }
}

const occupees = (s: any) =>
  (s.bookings ?? []).filter((b: any) => b.status === 'booked').length;

const enAttente = (s: any) =>
  (s.bookings ?? []).filter((b: any) => b.status === 'waiting').length;

/**
 * Ce que la séance peut encore accepter, et sous quelle forme.
 *
 * Trois états, et non « libre ou complet » : une séance pleine dont la liste
 * d'attente n'est pas saturée accepte encore quelqu'un — sans lui promettre une
 * place. Le confondre avec « complet » priverait de la liste d'attente ; le
 * confondre avec « libre » ferait espérer une place qui n'existe pas.
 */
function etatSeance(s: any): 'libre' | 'attente' | 'complet' {
  if (occupees(s) < s.capacity) return 'libre';
  if (enAttente(s) < ((s.creneaux as any)?.places_attente ?? 0)) return 'attente';
  return 'complet';
}

const moisFr = new Intl.DateTimeFormat('fr-FR', {
  month: 'long', year: 'numeric', timeZone: 'Europe/Paris',
});

const parMois = new Map<string, any[]>();
for (const s of seances) {
  const cle = moisFr.format(new Date(s.starts_at));
  parMois.set(cle, [...(parMois.get(cle) ?? []), s]);
}

const lien = personnes.length > 1 && choisie ? `?personne=${choisie.id}` : '';
---

<BaseLayout title="Planning" description="Les séances à venir." noIndex={true}>
  <section class="py-12 md:py-16">
    <div class="max-w-2xl mx-auto px-4">

      <div class="mb-6 flex flex-wrap items-baseline gap-x-4">
        <h1 class="text-2xl md:text-3xl font-bold text-[var(--color-heading)]"
            style="font-family: var(--font-heading)">
          Planning
        </h1>
        {pour ? (
          <a href={`/espace-membre/admin/participants/${pour}/`}
             class="ml-auto text-sm text-[var(--color-button)] underline">
            Retour à la fiche
          </a>
        ) : (
          <a href={`/espace-membre/${lien}`} class="ml-auto text-sm text-[var(--color-button)] underline">
            Mon espace
          </a>
        )}
      </div>

      {/*
        Dire au nom de qui on agit, et le dire fort. Sans ce bandeau, l'écran est
        indistinguable de son propre planning : on croirait réserver pour soi, et
        les premières places atterriraient chez la mauvaise personne.
      */}
      {pour && choisie && (
        <p class="mb-6 rounded-xl border-2 border-[var(--color-button)] bg-[var(--color-card-bg)] p-4 text-sm shadow-md">
          <strong class="text-[var(--color-button)]">Mode administration.</strong>
          {' '}Vous réservez pour <strong>{choisie.first_name} {choisie.last_name}</strong>.
          {destinataire
            ? ' La confirmation lui sera envoyée.'
            : ' Sans adresse e-mail, aucune confirmation ne partira : prévenez-le vous-même.'}
        </p>
      )}

      <SelecteurParticipant personnes={personnes} choisie={choisie} base="/espace-membre/planning/" />

      {message && (
        <p class="mb-6 rounded-xl bg-[var(--color-bg-accent)] p-4 text-sm text-[var(--color-text)]">{message}</p>
      )}
      {erreur && (
        <p role="alert" class="mb-6 rounded-xl bg-[var(--color-card-bg)] p-4 text-sm text-[var(--color-button)] shadow-md">{erreur}</p>
      )}

      {!choisie ? (
        <p class="rounded-xl bg-[var(--color-card-bg)] p-5 text-[var(--color-text)] shadow-md">
          Aucune inscription n’est rattachée à ce compte. Contactez Isabelle.
        </p>
      ) : (
        <>
          <p class="mb-6 text-[var(--color-text)]">
            {solde > 0
              ? `${solde} séance${solde > 1 ? 's' : ''} disponible${solde > 1 ? 's' : ''}.`
              : solde === 0
                ? 'Vos séances du moment sont toutes réservées. Réserver au-delà sera facturé en supplément.'
                : `${-solde} séance${-solde < -1 ? 's' : ''} déjà au-delà de votre forfait.`}
          </p>

          {seances.length === 0 && (
            <p class="rounded-xl bg-[var(--color-card-bg)] p-5 text-[var(--color-text)] shadow-md">
              Aucune séance programmée pour l’instant.
            </p>
          )}

          {[...parMois.entries()].map(([mois, liste]) => (
            <div class="mb-8">
              <h2 class="mb-3 text-lg font-bold text-[var(--color-heading)] first-letter:uppercase">{mois}</h2>
              <ul class="space-y-2">
                {liste.map((s) => {
                  const reservationId = mesReservations.get(s.id);
                  const prises = occupees(s);
                  const etat = etatSeance(s);
                  const jAttends = mesAttentes.has(s.id);
                  // Moins de 10 jours : se désister ne rend plus la séance. On le
                  // dit AVANT le clic — l'apprendre après serait une mauvaise
                  // surprise, et elle porterait sur de l'argent.
                  const tardif = new Date(s.starts_at).getTime() - Date.now() < 48 * 3600e3;
                  return (
                    <li class="flex flex-wrap items-center gap-x-4 gap-y-2 rounded-xl bg-[var(--color-card-bg)] p-4 shadow-md">
                      <div class="min-w-[12rem] flex-1">
                        <p class="font-medium text-[var(--color-heading)] first-letter:uppercase">
                          {dateLongue.format(new Date(s.starts_at))}
                        </p>
                        <p class="text-sm text-[var(--color-text-light)]">
                          {heure.format(new Date(s.starts_at))} – {heure.format(new Date(s.ends_at))}
                          {' · '}{(s.creneaux as any)?.label}
                          {' · '}{s.location}
                        </p>
                      </div>

                      {jAttends && etat === 'libre' ? (
                        /*
                          En attente, et une place s'est libérée : c'est le
                          moment décisif. Le bouton principal prend la place —
                          personne n'ayant été inscrit d'office, elle part au
                          premier qui la réclame.
                        */
                        <div class="flex flex-wrap items-center gap-x-3 gap-y-1">
                          <form method="post">
                            <input type="hidden" name="action" value="reserver" />
                            <input type="hidden" name="seance" value={s.id} />
                            <button type="submit"
                                    class="rounded-[var(--radius-button)] bg-[var(--color-button)] px-4 py-1.5 text-sm font-medium text-white transition-opacity hover:opacity-90">
                              Prendre la place
                            </button>
                          </form>
                          <form method="post">
                            <input type="hidden" name="action" value="liberer" />
                            <input type="hidden" name="reservation" value={reservationId} />
                            <button type="submit" class="text-sm text-[var(--color-button)] underline">
                              Me retirer
                            </button>
                          </form>
                          <span class="w-full text-xs text-[var(--color-text-light)]">
                            Une place s’est libérée. Elle n’est réservée à personne : la première
                            personne qui la prend l’obtient.
                          </span>
                        </div>
                      ) : reservationId ? (
                        <form method="post" class="flex flex-wrap items-center gap-x-3 gap-y-1">
                          <input type="hidden" name="action" value="liberer" />
                          <input type="hidden" name="reservation" value={reservationId} />
                          <span class={`text-sm font-medium ${jAttends ? 'text-[var(--color-text-light)]' : 'text-[var(--color-heading)]'}`}>
                            {jAttends ? 'En attente' : 'Inscrit'}
                          </span>
                          <button type="submit" class="text-sm text-[var(--color-button)] underline">
                            {jAttends ? 'Me retirer' : 'Libérer'}
                          </button>
                          {/* Se retirer de la liste d'attente ne coûte jamais
                              rien : on n'avait pas de place. */}
                          {tardif && !jAttends && (
                            <span class="w-full text-xs text-[var(--color-button)]">
                              Moins de 10 jours : la place repartira, mais la séance restera due.
                            </span>
                          )}
                        </form>
                      ) : etat === 'complet' ? (
                        <span class="text-sm text-[var(--color-text-light)]">Complet</span>
                      ) : (
                        <form method="post" class="flex flex-wrap items-center gap-x-3 gap-y-1">
                          <input type="hidden" name="action" value="reserver" />
                          <input type="hidden" name="seance" value={s.id} />
                          <span class="text-sm text-[var(--color-text-light)]">
                            {etat === 'libre'
                              ? `${s.capacity - prises} place${s.capacity - prises > 1 ? 's' : ''}`
                              : 'Complet'}
                          </span>
                          <button type="submit"
                                  class="rounded-[var(--radius-button)] border-2 border-[var(--color-button)] px-4 py-1.5 text-sm font-medium text-[var(--color-button)] transition-colors hover:bg-[var(--color-button)] hover:text-white">
                            {etat === 'attente'
                              ? 'Liste d’attente'
                              : solde > 0 ? 'Réserver' : 'Réserver en plus'}
                          </button>
                          {/* La liste d'attente ne promet rien : le dire ici
                              évite qu'on la prenne pour une inscription. */}
                          {etat === 'attente' && (
                            <span class="w-full text-xs text-[var(--color-text-light)]">
                              La séance est pleine. Vous prendrez la place dès qu’une se libère,
                              et serez prévenu par e-mail. Aucune séance n’est décomptée en attendant.
                            </span>
                          )}
                        </form>
                      )}
                    </li>
                  );
                })}
              </ul>
            </div>
          ))}
        </>
      )}
    </div>
  </section>
</BaseLayout>
