---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';

const { session, account, isAdmin } = Astro.locals;

if (!session) {
  return Astro.redirect('/espace-membre/connexion/');
}

// Session valide mais aucun compte correspondant : on ne crée rien, on le dit.
if (!account) {
  return Astro.redirect('/espace-membre/connexion/?inconnu=1');
}
---

<BaseLayout title="Mon espace" description="Votre espace adhérent." noIndex={true}>
  <section class="py-16 md:py-20">
    <div class="max-w-2xl mx-auto px-4">
      <h1 class="text-2xl md:text-3xl font-bold text-[var(--color-heading)] mb-2"
          style="font-family: var(--font-heading)">
        Bonjour
      </h1>
      <p class="text-[var(--color-text-light)] mb-8">{account.email}</p>

      {isAdmin && (
        <div class="mb-8 rounded-xl bg-[var(--color-bg-accent)] p-5">
          <p class="font-medium text-[var(--color-heading)]">Accès administration</p>
          <p class="mt-1 text-sm text-[var(--color-text)]">
            Les écrans de gestion des séances et des participants arrivent au jalon suivant.
          </p>
        </div>
      )}

      <div class="rounded-xl bg-white p-5 shadow-md">
        <p class="text-sm text-[var(--color-text)]">
          Votre solde de séances et vos réservations apparaîtront ici.
        </p>
      </div>

      <form method="post" action="/espace-membre/deconnexion/" class="mt-8">
        <button
          type="submit"
          class="rounded-[var(--radius-button)] border-2 border-[var(--color-button)] px-6 py-2 text-sm font-medium text-[var(--color-button)] transition-colors hover:bg-[var(--color-button)] hover:text-white"
        >
          Me déconnecter
        </button>
      </form>
    </div>
  </section>
</BaseLayout>
