---
export const prerender = false;

import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { requireAdmin } from '../../../../utils/guards';
import { getAdminClient } from '../../../../utils/supabase';
import { notifier, variablesSeance } from '../../../../utils/emails';
import { AUDIENCES, memePublic } from '../../../../utils/ateliers';
import { trouverOuCreerCompte, inscrireDOffice, saisonDe, bornesSaison,
  premierJourDuMois, dernierJourDuMois }
  from '../../../../utils/inscriptions';
import { lireCatalogueFormules, libelleFormule } from '../../../../utils/tarifs';

const garde = requireAdmin(Astro);
if (garde) return garde;

const { id } = Astro.params;
const supabase = getAdminClient();

// Le sort du message d'accueil est dit explicitement : sans adresse e-mail,
// personne n'a été prévenu, et Isabelle doit savoir qu'elle a ce relais à
// faire elle-même plutôt que de le découvrir à la première séance.
// LE MESSAGE DIT CE QUI S'EST PASSÉ, et non ce qu'on espérait. Il annonçait
// « inscrit d'office aux prochaines séances » quoi qu'il arrive — y compris
// quand aucune place n'avait été posée, ce qui est le cas normal d'une
// inscription prise avant le début de l'abonnement : sans crédit octroyé, il
// n'y a rien à dépenser. Isabelle ouvrait alors la fiche, n'y voyait aucune
// séance, et n'avait aucun moyen de savoir si c'était normal.
const posees = Number(Astro.url.searchParams.get('posees') ?? '-1');

let message: string | null = Astro.url.searchParams.has('inscrit')
  ? (posees > 0
      ? `Adhérent créé, et inscrit d’office à ${posees} séance${posees > 1 ? 's' : ''} de son créneau. `
      : 'Adhérent créé. Aucune séance ne lui est encore attribuée. ')
    + (Astro.url.searchParams.has('accueil')
        ? 'Un message de bienvenue lui a été envoyé.'
        : 'Sans adresse e-mail, aucun message n’a pu partir : prévenez-le vous-même.')
  : null;
let erreur: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('action') ?? '');

  if (action === 'abonnement') {
    const debut = String(form.get('debut') ?? '');
    const fin = String(form.get('fin') ?? '');
    const cloturer = String(form.get('cloturer') ?? '');

    // Clore l'abonnement en cours plutôt que de le modifier. Changer
    // credits_per_month sur une ligne existante réécrirait rétroactivement
    // l'octroi de tous les mois déjà consommés (SPEC §6).
    if (cloturer) {
      const veille = new Date(debut);
      veille.setUTCDate(veille.getUTCDate() - 1);
      const { error } = await supabase
        .from('subscriptions')
        .update({ ends_on: veille.toISOString().slice(0, 10) })
        .eq('id', cloturer);
      if (error) erreur = `Clôture impossible : ${error.message}`;
    }

    if (!erreur) {
      const { error } = await supabase.from('subscriptions').insert({
        participant_id: id,
        season: String(form.get('saison') ?? ''),
        home_creneau_id: String(form.get('creneau') ?? '') || null,
        // Une formule désignée l'emporte : le déclencheur en base recopie son
        // nombre de séances dans total_credits et vide credits_per_month. Les
        // deux champs ci-dessous ne servent donc qu'à la saisie libre, pour un
        // abonnement qui ne correspond à aucune formule du catalogue.
        formule_id: String(form.get('formule') ?? '') || null,
        credits_per_month: form.get('type') === 'forfait' ? null : Number(form.get('credits')),
        total_credits: form.get('type') === 'forfait' ? Number(form.get('credits')) : null,
        starts_on: debut,
        ends_on: fin,
      });
      if (error) {
        erreur = `Abonnement impossible : ${error.message}`;
      } else {
        // Même raison qu'à la création : le résultat doit être visible
        // immédiatement, pas le lendemain matin.
        const auto = await inscrireDOffice(supabase);
        if (!auto.ok) {
          console.error('[abonnement] auto-inscription :', auto.erreur);
          message = 'Abonnement enregistré.';
        } else {
          const n = auto.valeur;
          message = n > 0
            ? `Abonnement enregistré. ${n} place${n > 1 ? 's ont été réservées' : ' a été réservée'} d’office.`
            : 'Abonnement enregistré. Aucune séance à venir sur ce créneau pour l’instant.';
        }
      }
    }
  }

  // Corriger un abonnement saisi de travers.
  //
  // À distinguer du changement de formule en cours de saison (§6), qui se fait
  // en clôturant puis en ouvrant : là, on RÉÉCRIT une ligne existante, ce qui
  // modifie rétroactivement l'octroi de tous ses mois. C'est exactement ce
  // qu'il faut pour réparer une faute de frappe, et exactement ce qu'il ne faut
  // pas pour acter une évolution réelle — l'écran le dit.
  if (action === 'corriger-abonnement') {
    /*
     * ON CHOISIT UN MOIS, MAIS ON NE PERD PAS LE JOUR.
     *
     * Cet écran répare une saisie fautive, et une saison va du 1er septembre au
     * 30 juin : le jour n'y a pas de sens, et le faire saisir n'apporte qu'une
     * faute possible. Mais « Ajouter un abonnement » peut, lui, créer un
     * abonnement qui commence en cours de mois — c'est ainsi qu'on acte un
     * changement de formule. Réparer un tel abonnement ne doit pas le ramener
     * au premier du mois sans le dire : tant que le mois n'est pas modifié, la
     * date d'origine est conservée telle quelle.
     */
    const garderLeJour = (mois: string, origine: string, bord: (m: string) => string) =>
      origine.startsWith(mois) ? origine : bord(mois);

    const debut = garderLeJour(String(form.get('debut') ?? ''),
                               String(form.get('debut-origine') ?? ''), premierJourDuMois);
    const fin = garderLeJour(String(form.get('fin') ?? ''),
                             String(form.get('fin-origine') ?? ''), dernierJourDuMois);

    if (debut > fin) {
      erreur = 'Le dernier mois ne peut pas précéder le premier.';
    } else {
      const { error } = await supabase
        .from('subscriptions')
        .update({
          home_creneau_id: String(form.get('creneau') ?? '') || null,
          formule_id: String(form.get('formule') ?? '') || null,
          credits_per_month: form.get('type') === 'forfait' ? null : Number(form.get('credits')),
          total_credits: form.get('type') === 'forfait' ? Number(form.get('credits')) : null,
          starts_on: debut,
          ends_on: fin,
        })
        .eq('id', String(form.get('abonnement')));
      if (error) erreur = `Correction impossible : ${error.message}`;
      else message = 'Abonnement corrigé. Le solde a été recalculé.';
    }
  }

  if (action === 'supprimer-abonnement') {
    const { error } = await supabase
      .from('subscriptions').delete().eq('id', String(form.get('abonnement')));
    if (error) erreur = `Suppression impossible : ${error.message}`;
    else message = 'Abonnement supprimé. Les réservations existantes sont conservées.';
  }

  // Rendre une séance retenue après un désistement tardif.
  //
  // La règle des 10 jours est ferme par défaut, mais Isabelle reste libre d'y
  // renoncer — une hospitalisation n'est pas un oubli. Sans ce geste, la seule
  // issue serait de ne pas appliquer la règle du tout.
  if (action === 'rendre-quand-meme') {
    const reservation = String(form.get('reservation') ?? '');

    // Les détails AVANT la mise à jour : le message annonce quelle séance a été
    // rendue, et il faut donc encore pouvoir la décrire.
    const { data: cible } = await supabase
      .from('bookings')
      .select('participants(first_name, accounts(email)), sessions(starts_at, ends_at, location)')
      .eq('id', reservation)
      .eq('participant_id', id)
      .maybeSingle();

    const { error } = await supabase
      .from('bookings')
      .update({ credit_retenu: false })
      .eq('id', reservation)
      .eq('participant_id', id);

    if (error) {
      erreur = `Impossible : ${error.message}`;
    } else {
      // Sans ce message, le geste resterait invisible : l'adhérent avait lu
      // « la séance reste due », et rien ne lui disait le contraire. Il l'aurait
      // découvert en consultant son solde, si l'idée lui venait — une générosité
      // qu'on ne remarque pas est une générosité perdue.
      const s = (cible as any)?.sessions;
      const prevenu = s
        ? await notifier('retenue_levee', (cible as any)?.participants?.accounts?.email,
            variablesSeance({
              prenom: (cible as any)?.participants?.first_name ?? '',
              starts_at: s.starts_at, ends_at: s.ends_at, location: s.location,
            }))
        : false;

      message = 'Séance rendue : elle revient au solde malgré le délai.'
        + (prevenu
            ? ' L’adhérent en a été prévenu par e-mail.'
            : ' Sans adresse e-mail, prévenez-le vous-même.');
    }
  }

  // Retirer quelqu'un d'une séance.
  //
  // Isabelle apprend souvent les empêchements par téléphone ou de vive voix :
  // sans ce bouton, il fallait ouvrir la séance concernée et y chercher la
  // personne, ou la laisser occuper une place qu'elle ne prendra pas.
  //
  // La conséquence n'est pas la même selon la date, et le message le dit :
  // sur une séance à venir la place se libère, sur une séance passée c'est un
  // crédit déjà consommé qu'on rend — un geste, pas une correction d'agenda.
  if (action === 'liberer') {
    const reservation = String(form.get('reservation') ?? '');

    // L'identifiant vient du formulaire : on vérifie qu'il appartient bien à
    // la personne affichée. L'écran est réservé aux administrateurs, mais un
    // identifiant périmé — page laissée ouverte, retour arrière — libérerait
    // sinon la place de quelqu'un d'autre sans que rien ne le signale.
    const { data: cible } = await supabase
      .from('bookings')
      .select('participant_id, sessions(starts_at)')
      .eq('id', reservation)
      .maybeSingle();

    if (!cible || cible.participant_id !== id) {
      erreur = 'Cette réservation n’appartient pas à cette personne.';
    } else {
      const { error } = await supabase.rpc('release_booking', { p_booking: reservation });
      if (error) {
        erreur = `Retrait impossible : ${error.message}`;
      } else {
        const passee = new Date((cible as any).sessions.starts_at) < new Date();
        message = (passee
          ? 'Séance retirée, et le crédit rendu au solde. '
          : 'Place libérée : elle est de nouveau proposée aux autres adhérents. ')
          + 'Aucun message n’a été envoyé — prévenez la personne vous-même.';
      }
    }
  }

  // Corriger une identité. Sans cet écran, une faute de frappe dans un nom
  // n'était réparable qu'en SQL.
  if (action === 'identite') {
    const prenom = String(form.get('prenom') ?? '').trim();
    const nom = String(form.get('nom') ?? '').trim();
    if (!prenom || !nom) {
      erreur = 'Le prénom et le nom sont nécessaires.';
    } else {
      const { error } = await supabase
        .from('participants')
        .update({ first_name: prenom, last_name: nom,
                  phone: String(form.get('telephone') ?? '').trim() || null,
                  audience: String(form.get('audience') ?? 'adulte'),
                  notes: String(form.get('notes') ?? '').trim() || null })
        .eq('id', id);
      if (error) erreur = `Modification impossible : ${error.message}`;
      else message = 'Identité mise à jour.';
    }
  }

  // Ouvrir un accès à quelqu'un qui n'en avait pas, ou corriger l'adresse.
  //
  // La SPEC promet que « le rattachement ultérieur ne perd rien » : abonnements,
  // réservations et solde sont portés par la personne, pas par le compte. C'est
  // aussi l'outil de réparation du cas le plus probable — une adresse Google
  // différente de celle enregistrée.
  if (action === 'acces') {
    const email = String(form.get('email') ?? '').trim().toLowerCase();

    if (!email) {
      // Détacher : la personne reste, son historique aussi, elle ne se connecte
      // simplement plus. On ne supprime jamais le compte lui-même, il peut
      // porter d'autres personnes.
      const { error } = await supabase
        .from('participants').update({ account_id: null }).eq('id', id);
      if (error) erreur = `Détachement impossible : ${error.message}`;
      else message = 'Accès retiré. L’historique est conservé.';
    } else {
      const compte = await trouverOuCreerCompte(supabase, email);
      const compteId = compte.ok ? compte.valeur : null;
      if (!compte.ok) erreur = compte.erreur;

      if (!erreur && compteId) {
        const { error } = await supabase
          .from('participants').update({ account_id: compteId }).eq('id', id);
        if (error) erreur = `Rattachement impossible : ${error.message}`;
        else message = `Accès rattaché à ${email}.`;
      }
    }
  }
}

const { data: participant } = await supabase
  .from('participants')
  .select('id, first_name, last_name, phone, audience, notes, account_id, accounts(email)')
  .eq('id', id)
  .maybeSingle();

if (!participant) return new Response('Participant introuvable', { status: 404 });

/**
 * Les formules au catalogue, avec le prix qu'elles font payer un dépassement.
 *
 * Ce prix — le total divisé par le nombre de séances — n'est stocké nulle part :
 * l'écrire à côté des deux nombres dont il se déduit en ferait un troisième à
 * tenir d'accord. Il s'affiche ici parce que c'est le moment où Isabelle en a
 * besoin : choisir la formule, c'est choisir ce que coûtera la séance en plus.
 */
const formules = await lireCatalogueFormules(supabase);

const { data: abonnements } = await supabase
  .from('subscriptions')
  .select('id, season, home_creneau_id, credits_per_month, total_credits, formule_id, starts_on, ends_on, helloasso_order_id, creneaux(label, audience)')
  .eq('participant_id', id)
  .order('starts_on');

// La raison d'une fiche vide, quand on la connaît : un abonnement qui n'a pas
// encore commencé n'octroie aucun crédit, donc ne pose aucune place. Le dire
// évite de faire chercher une panne là où il n'y en a pas.
if (message && posees === 0) {
  const aVenir = (abonnements ?? [])
    .map((a) => a.starts_on as string)
    .filter((d) => d > new Date().toISOString().slice(0, 10))
    .sort()[0];
  if (aVenir) {
    const quand = new Date(aVenir).toLocaleDateString('fr-FR', {
      day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC',
    });
    message += ` Son abonnement commence le ${quand} : ses séances seront posées à partir de cette date.`;
  }
}

const { data: solde } = await supabase.rpc('balance', { p_participant: id });
const { data: octroye } = await supabase.rpc('granted_credits', {
  p_participant: id, p_at: new Date().toISOString().slice(0, 10),
});
const { data: consomme } = await supabase.rpc('consumed_credits', { p_participant: id });

/*
 * SEULS LES CRÉNEAUX QU'UNE INSCRIPTION D'OFFICE PEUT HONORER.
 *
 * La liste proposait tout ce que porte la table : les stages, la séance du
 * jeudi soir vendue à l'unité, et les créneaux archivés. Or `run_auto_enrolment`
 * exige `kind = 'atelier'` ET `au_forfait` — un abonnement attaché à l'un des
 * autres ne pose jamais aucune place, en silence. Offrir un choix impossible,
 * c'est le faire faire tôt ou tard.
 */
const { data: creneaux } = await supabase
  .from('creneaux')
  .select('id, label, audience')
  .eq('kind', 'atelier')
  .eq('au_forfait', true)
  .is('archived_at', null)
  .order('label');

/*
 * LES LISTES SE BORNENT AU PUBLIC DU PARTICIPANT.
 *
 * Trois listes indépendantes — le public de la personne, celui du créneau,
 * celui de la formule — permettaient d'assembler un abonnement qu'aucune
 * inscription d'office ne pourrait honorer : l'auto-inscription exige que le
 * créneau soit celui du public de la personne, et écarte le reste en silence.
 * On a ainsi créé un enfant sur un créneau ados avec un forfait adultes, dont
 * le planning est resté vide sans explication.
 */
const creneauxDuPublic = (creneaux ?? []).filter((c) => memePublic(participant.audience, c.audience));
const formulesDuPublic = formules.filter((f) => memePublic(participant.audience, f.audience));

const { data: reservations } = await supabase
  .from('bookings')
  .select('id, source, status, credit_retenu, attendance, sessions(starts_at, status, creneaux(label))')
  .eq('participant_id', id)
  // Les places rendues trop tard figurent ici bien qu'elles soient libérées :
  // la séance reste due, donc elle compte, donc elle doit se voir. L'omettre
  // ferait un solde que rien sur cette page n'expliquerait.
  .or('status.eq.booked,status.eq.waiting,credit_retenu.eq.true')
  .order('starts_at', { referencedTable: 'sessions' });

// Les absences notées, comptées ici plutôt que laissées à repérer à l'œil dans
// une liste de vingt lignes : c'est le chiffre qui déclenche un coup de fil.
const absences = (reservations ?? []).filter((r: any) => r.attendance === 'absent').length;

const enCours = (abonnements ?? []).filter((a) => a.ends_on >= new Date().toISOString().slice(0, 10));

/**
 * Ce qui reste à placer tient-il encore sur le créneau attitré ?
 *
 * La question ne porte PAS sur le forfait acheté mais sur le SOLDE, et pas sur
 * les dates du créneau mais sur celles qui y sont encore prenables. Une première
 * version comparait 20 séances aux 10 dates du mardi : l'avertissement restait
 * affiché une fois les 20 placées — dix sur le mardi, dix ailleurs — et
 * annonçait un travail déjà fait.
 *
 * Une date n'est prenable que si elle est à venir, non annulée, pas complète, et
 * pas déjà RÉSERVÉE par cette personne.
 *
 * Une date qu'elle a LIBÉRÉE compte comme prenable, elle. C'est l'inscription
 * d'office qui ne repasse jamais sur une place rendue — pour qu'un désistement
 * ne soit pas défait la nuit suivante — mais rien n'empêche de la reprendre à la
 * main, et cet avertissement parle précisément de placement à la main. L'exclure
 * annoncerait « à placer ailleurs » des dates encore libres sur son créneau.
 */
const dispoParCreneau = await Promise.all(
  enCours
    .filter((a) => a.home_creneau_id)
    .map(async (a) => {
      const { data } = await supabase
        .from('sessions')
        .select('id, capacity, bookings(participant_id, status)')
        .eq('creneau_id', a.home_creneau_id)
        .eq('status', 'scheduled')
        .gt('starts_at', new Date().toISOString())
        .lte('starts_at', `${a.ends_on}T23:59:59`);

      const libres = (data ?? []).filter((s: any) => {
        const lignes = s.bookings ?? [];
        const dejaPrise = lignes.some(
          (b: any) => b.participant_id === id && b.status === 'booked',
        );
        const prises = lignes.filter((b: any) => b.status === 'booked').length;
        return !dejaPrise && prises < s.capacity;
      }).length;

      return { creneau: (a.creneaux as any)?.label ?? a.home_creneau_id, libres };
    }),
);

const placesAttitrees = dispoParCreneau.reduce((n, d) => n + d.libres, 0);
const resteAPlacer = Math.max(0, (solde as number) ?? 0);
const ailleurs = resteAPlacer - placesAttitrees;
const dateFr = new Intl.DateTimeFormat('fr-FR', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Europe/Paris' });
/*
 * LA SAISON PAR DÉFAUT SUIT LA RÈGLE DE `saisonDe`, et non l'année civile.
 *
 * Elle valait `${année}-${année + 1}` : juste de septembre à décembre, faux de
 * janvier à juillet — un abonnement ajouté en janvier 2027 s'annonçait de la
 * saison 2027-2028, alors que celle en cours est 2026-2027. Le seuil est août,
 * comme partout ailleurs.
 */
const saisonDefaut = saisonDe(new Date());
const bornesDefaut = bornesSaison(saisonDefaut);
---

<AdminLayout
  title={`${participant.first_name} ${participant.last_name}`}
  soustitre={participant.account_id
    ? `Accès : ${(participant.accounts as any)?.email}`
    : 'Sans accès au site — ne recevra aucun e-mail'}
>
  {message && <p class="mb-6 rounded-xl bg-[var(--color-bg-accent)] p-4 text-sm">{message}</p>}
  {erreur && <p role="alert" class="mb-6 rounded-xl bg-[var(--color-card-bg)] p-4 text-sm text-[var(--color-button)] shadow-md">{erreur}</p>}

  {/*
    Ce qui reste à placer ne tient plus sur le créneau attitré.
    Recalculé à chaque visite : l'avertissement disparaît de lui-même dès que les
    dates sont posées, au lieu d'annoncer un travail déjà fait.
  */}
  {ailleurs > 0 && (
    <p class="mb-6 rounded-xl border border-[var(--color-button)] bg-[var(--color-card-bg)] p-4 text-sm text-[var(--color-text)] shadow-md">
      <strong class="text-[var(--color-button)]">
        {ailleurs} séance{ailleurs > 1 ? 's' : ''} à placer sur un autre créneau.
      </strong>
      {' '}Il reste {resteAPlacer} séance{resteAPlacer > 1 ? 's' : ''} à poser, et
      {placesAttitrees === 0
        ? ` « ${dispoParCreneau.map((d) => d.creneau).join(' », « ')} » n’a plus de date libre.`
        : ` seulement ${placesAttitrees} date${placesAttitrees > 1 ? 's' : ''} libre${placesAttitrees > 1 ? 's' : ''} sur son créneau habituel.`}
    </p>
  )}

  {/*
    Une seule quantité en grand : celle qui répond à une question.
    « Disponibles » décide s'il reste une place à poser ; « acquises » et
    « réservées » ne servent qu'à vérifier le calcul, et grossissent toute la
    saison — 24 et 22 en juin. Les mettre au même rang rendrait les deux moins
    utiles les plus visibles, et « acquises : 24 » se lirait comme un stock
    disponible.
  */}
  <div class="mb-8 rounded-xl bg-[var(--color-card-bg)] p-5 shadow-md">
    <p class="text-sm text-[var(--color-text-light)]">Séances disponibles</p>
    <p class={`text-4xl font-bold ${(solde as number) < 0 ? 'text-[var(--color-button)]' : 'text-[var(--color-heading)]'}`}>
      {solde}
    </p>
    <p class="mt-2 text-sm text-[var(--color-text-light)]">
      {octroye} acquise{(octroye as number) > 1 ? 's' : ''} depuis le début de l’abonnement,
      {' '}{consomme} déjà réservée{(consomme as number) > 1 ? 's' : ''}.
    </p>
    <p class="mt-1 text-sm text-[var(--color-text-light)]">
      {(solde as number) < 0
        ? `${-(solde as number)} séance${-(solde as number) > 1 ? 's' : ''} au-delà du forfait, à facturer.`
        : 'Une séance s’acquiert au premier de chaque mois, se reporte jusqu’en juin, et une réservation lointaine est décomptée dès maintenant.'}
    </p>

    {/*
      Réserver à sa place, depuis le planning des adhérents lui-même.
      Une partie des inscrits ne réservera pas en ligne, et les séances qui
      débordent du créneau attitré demandent un choix que l'inscription d'office
      ne peut pas faire. Réutiliser leur écran plutôt qu'en bâtir un second
      évite d'avoir deux règles de réservation à maintenir.
    */}
    {(solde as number) > 0 && (
      <a href={`/espace-membre/planning/?pour=${participant.id}`}
         class="mt-4 inline-block rounded-[var(--radius-button)] bg-[var(--color-button)] px-5 py-2.5 text-sm font-medium text-white transition-opacity hover:opacity-90">
        Choisir {solde} date{(solde as number) > 1 ? 's' : ''} pour {participant.first_name}
      </a>
    )}
  </div>

  <h2 class="mb-3 text-lg font-bold text-[var(--color-heading)]">Abonnements</h2>
  {(abonnements ?? []).length === 0 ? (
    <p class="rounded-xl bg-[var(--color-card-bg)] p-5 text-[var(--color-text)] shadow-md">Aucun abonnement.</p>
  ) : (
    <ul class="space-y-2">
      {(abonnements ?? []).map((a) => (
        <li class="rounded-xl bg-[var(--color-card-bg)] p-4 shadow-md">
          <div class="flex flex-wrap items-center gap-x-4">
            <span class="font-medium text-[var(--color-heading)]">
              {a.total_credits !== null
                ? `Forfait ${a.total_credits} séance${a.total_credits > 1 ? 's' : ''}`
                : `${a.credits_per_month} séance${a.credits_per_month > 1 ? 's' : ''}/mois`}
            </span>
            <span class="text-sm text-[var(--color-text-light)]">
              {(a.creneaux as any)?.label ?? 'sans créneau d’origine'}
            </span>
            <span class="ml-auto text-sm text-[var(--color-text-light)]">
              {dateFr.format(new Date(a.starts_on))} → {dateFr.format(new Date(a.ends_on))}
            </span>
          </div>
          {!a.helloasso_order_id && (
            <p class="mt-1 text-xs text-[var(--color-text-light)]">Saisi à la main</p>
          )}

          {a.home_creneau_id && !memePublic(participant.audience, (a.creneaux as any)?.audience) && (
            <p class="mt-2 rounded-lg bg-[var(--color-bg-pink)] px-3 py-2 text-sm text-white">
              <strong>Aucune séance ne sera posée d’office.</strong>{' '}
              {participant.first_name} est inscrit comme « {participant.audience} », mais ce
              créneau accueille le public « {(a.creneaux as any)?.audience} ». Corrigez l’un
              ou l’autre ci-dessous.
            </p>
          )}

          <details class="mt-3">
            <summary class="cursor-pointer text-sm text-[var(--color-text-light)]">
              Corriger cet abonnement
            </summary>

            <p class="mt-2 max-w-xl text-sm text-[var(--color-text)]">
              À n’utiliser que pour <strong>réparer une saisie fautive</strong>. Corriger ici
              réécrit l’octroi de tous les mois déjà passés, et le solde change aussitôt.
              Pour acter un vrai changement de formule en cours de saison, n’y touchez pas :
              utilisez « Ajouter un abonnement » ci-dessous, qui clôture celui-ci à la
              veille du nouveau et conserve l’historique.
            </p>

            <form method="post" class="mt-3">
              <input type="hidden" name="action" value="corriger-abonnement" />
              <input type="hidden" name="abonnement" value={a.id} />

              <div class="grid gap-3 sm:grid-cols-2">
                <div>
                  <label for={`c-creneau-${a.id}`} class="block text-sm font-medium mb-1">Créneau habituel</label>
                  <select id={`c-creneau-${a.id}`} name="creneau" class="champ">
                    <option value="">Aucun</option>
                    {creneauxDuPublic.map((c) => (
                      <option value={c.id} selected={c.id === a.home_creneau_id}>
                        {c.label} — {c.audience}
                      </option>
                    ))}
                  </select>
                </div>
                <div class="sm:col-span-2">
                  <label for={`c-formule-${a.id}`} class="block text-sm font-medium mb-1">Formule</label>
                  <select id={`c-formule-${a.id}`} name="formule" class="champ">
                    <option value="">Aucune — saisie libre ci-dessous</option>
                    {formulesDuPublic.map((f) => (
                      <option value={f.id} selected={f.id === a.formule_id}>{libelleFormule(f)}</option>
                    ))}
                  </select>
                  <p class="mt-1 text-sm text-[var(--color-text-light)]">
                    Choisir une formule fixe le nombre de séances et le prix d’un dépassement.
                    Sans formule, une séance en plus se facture au tarif d’une séance sans engagement.
                  </p>
                </div>
                <div class="sm:col-span-2">
                  <label for={`c-type-${a.id}`} class="block text-sm font-medium mb-1">Type</label>
                  <select id={`c-type-${a.id}`} name="type" class="champ">
                    <option value="mensuel" selected={a.total_credits === null}>Séances par mois</option>
                    <option value="forfait" selected={a.total_credits !== null}>Forfait pour la saison</option>
                  </select>
                </div>
                <div>
                  <label for={`c-credits-${a.id}`} class="block text-sm font-medium mb-1">Nombre de séances</label>
                  <input id={`c-credits-${a.id}`} name="credits" type="number" min="0" required
                         value={a.total_credits ?? a.credits_per_month} class="champ" />
                </div>
                <div>
                  <label for={`c-debut-${a.id}`} class="block text-sm font-medium mb-1">Premier mois</label>
                  <input id={`c-debut-${a.id}`} name="debut" type="month" required
                         value={String(a.starts_on).slice(0, 7)} class="champ" />
                  <input type="hidden" name="debut-origine" value={a.starts_on} />
                </div>
                <div>
                  <label for={`c-fin-${a.id}`} class="block text-sm font-medium mb-1">Dernier mois</label>
                  <input id={`c-fin-${a.id}`} name="fin" type="month" required
                         value={String(a.ends_on).slice(0, 7)} class="champ" />
                  <input type="hidden" name="fin-origine" value={a.ends_on} />
                </div>
              </div>

              <button type="submit"
                      class="mt-3 rounded-[var(--radius-button)] border-2 border-[var(--color-button)] px-5 py-2 text-sm font-medium text-[var(--color-button)]">
                Corriger
              </button>
            </form>

            <form method="post" class="mt-3 border-t border-[var(--color-border)] pt-3">
              <input type="hidden" name="action" value="supprimer-abonnement" />
              <input type="hidden" name="abonnement" value={a.id} />
              <button type="submit" class="text-sm text-[var(--color-button)] underline">
                Supprimer cet abonnement
              </button>
              <span class="ml-3 text-sm text-[var(--color-text-light)]">
                Les réservations déjà posées restent : elles deviendront des séances
                supplémentaires, à facturer.
              </span>
            </form>
          </details>
        </li>
      ))}
    </ul>
  )}

  <details class="mt-6 rounded-xl bg-[var(--color-card-bg)] p-5 shadow-md">
    <summary class="cursor-pointer font-medium text-[var(--color-heading)]">
      Ajouter un abonnement
    </summary>

    <p class="mt-3 text-sm text-[var(--color-text-light)]">
      Pour changer de formule, ne modifiez pas l’abonnement en cours : clôturez-le et ouvrez-en
      un nouveau. Modifier le nombre de séances réécrirait rétroactivement les mois déjà passés.
    </p>

    <form method="post" class="mt-4 space-y-4">
      <input type="hidden" name="action" value="abonnement" />

      {enCours.length > 0 && (
        <div>
          <label for="cloturer" class="block text-sm font-medium mb-1">
            Clôturer un abonnement en cours ?
          </label>
          <select id="cloturer" name="cloturer"
                  class="champ">
            <option value="">Non, c’est un abonnement supplémentaire</option>
            {enCours.map((a) => (
              <option value={a.id}>
                Oui, clore « {a.credits_per_month} séance(s)/mois » la veille du nouveau début
              </option>
            ))}
          </select>
        </div>
      )}

      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <label for="creneau" class="block text-sm font-medium mb-1">Créneau d’origine</label>
          <select id="creneau" name="creneau"
                  class="champ">
            <option value="">Aucun</option>
            {creneauxDuPublic.map((c) => <option value={c.id}>{c.label} — {c.audience}</option>)}
          </select>
        </div>
        <div class="sm:col-span-2">
          <label for="formule" class="block text-sm font-medium mb-1">Formule</label>
          <select id="formule" name="formule" class="champ">
            <option value="">Aucune — saisie libre ci-dessous</option>
            {formulesDuPublic.map((f) => <option value={f.id}>{libelleFormule(f)}</option>)}
          </select>
          <p class="mt-1 text-sm text-[var(--color-text-light)]">
            Choisir une formule fixe le nombre de séances et le prix d’un dépassement.
            Sans formule, une séance en plus se facture au tarif d’une séance sans engagement.
          </p>
        </div>
        <div class="sm:col-span-2">
          <label for="type" class="block text-sm font-medium mb-1">Type de forfait</label>
          <select id="type" name="type" required class="champ">
            <option value="mensuel">Tant de séances par mois</option>
            <option value="forfait">Forfait pour la saison, acquis en entier</option>
          </select>
        </div>

        <div>
          <label for="credits" class="block text-sm font-medium mb-1">Nombre de séances</label>
          <input id="credits" name="credits" type="number" min="0" required value="2"
                 class="champ" />
          <p class="mt-1 text-xs text-[var(--color-text-light)]">0 pour un créneau payé à la séance.</p>
        </div>
        <div>
          <label for="saison" class="block text-sm font-medium mb-1">Saison</label>
          <input id="saison" name="saison" required value={saisonDefaut}
                 class="champ" />
        </div>
        <div>
          <label for="debut" class="block text-sm font-medium mb-1">Premier mois</label>
          <input id="debut" name="debut" type="date" required
                 class="champ" />
          <p class="mt-1 text-sm text-[var(--color-text-light)]">
            Le jour compte ici : un changement de formule en cours de saison
            commence à sa date, et clôture le précédent la veille.
          </p>
        </div>
        <div>
          <label for="fin" class="block text-sm font-medium mb-1">Dernier mois</label>
          <input id="fin" name="fin" type="date" required value={bornesDefaut?.fin ?? ''}
                 class="champ" />
        </div>
      </div>

      <button type="submit" class="rounded-[var(--radius-button)] bg-[var(--color-button)] px-6 py-2 font-medium text-white">
        Enregistrer
      </button>
    </form>
  </details>

  <h2 class="mt-10 mb-3 text-lg font-bold text-[var(--color-heading)]">
    Séances réservées
    {absences > 0 && (
      <span class="ml-2 text-sm font-normal text-[var(--color-button)]">
        {absences} absence{absences > 1 ? 's' : ''} notée{absences > 1 ? 's' : ''}
      </span>
    )}
  </h2>
  {(reservations ?? []).length === 0 ? (
    <p class="rounded-xl bg-[var(--color-card-bg)] p-5 text-[var(--color-text)] shadow-md">Aucune réservation.</p>
  ) : (
    <ul class="space-y-2">
      {(reservations ?? []).map((r: any) => {
        const passee = new Date(r.sessions.starts_at) < new Date();
        return (
          <li class={`flex flex-wrap items-center gap-x-4 gap-y-2 rounded-xl bg-[var(--color-card-bg)] p-4 shadow-md ${passee ? 'opacity-60' : ''}`}>
            <span class="font-medium text-[var(--color-heading)]">
              {dateFr.format(new Date(r.sessions.starts_at))}
            </span>
            <span class="text-sm text-[var(--color-text-light)]">{r.sessions.creneaux?.label}</span>
            {/*
              « Non noté » n'est pas « absent » : la feuille de présence ne sera
              pas remplie tous les jours, et afficher un silence comme une
              absence accuserait quelqu'un qui était là.
            */}
            {passee && (
              r.attendance === 'absent'
                ? <span class="text-sm font-medium text-[var(--color-button)]">absent</span>
                : r.attendance === 'present'
                  ? <span class="text-sm text-[var(--color-text-light)]">présent</span>
                  : <span class="text-sm text-[var(--color-text-light)]">présence non notée</span>
            )}
            {r.sessions.status === 'cancelled' && (
              <span class="text-sm text-[var(--color-button)]">séance annulée</span>
            )}

            {r.status === 'waiting' && (
              <span class="text-sm text-[var(--color-text-light)]">en attente d’une place</span>
            )}
            {r.credit_retenu && (
              <span class="text-sm font-medium text-[var(--color-button)]">
                annulée tardivement — séance due
              </span>
            )}

            {/*
              Trois gestes selon l'état, et le libellé dit lequel :
              une séance retenue se rend malgré le délai, une séance passée se
              rend, une séance à venir se retire.
            */}
            {r.credit_retenu ? (
              <form method="post" class="ml-auto flex flex-wrap items-center justify-end gap-x-3 gap-y-1">
                <input type="hidden" name="action" value="rendre-quand-meme" />
                <input type="hidden" name="reservation" value={r.id} />
                {/* Dire que le message part : c'est ce qui distingue ce bouton
                    d'une correction discrète, et Isabelle doit le savoir avant
                    de cliquer, pas après. */}
                <span class="text-xs text-[var(--color-text-light)]">
                  un e-mail préviendra la personne
                </span>
                <button type="submit"
                        class="rounded-[var(--radius-button)] border border-[var(--color-border-prominent)] px-4 py-1.5 text-sm font-medium text-[var(--color-text)] transition-colors hover:bg-[var(--color-bg-accent)]">
                  Rendre malgré le délai
                </button>
              </form>
            ) : (
              <form method="post" class="ml-auto">
                <input type="hidden" name="action" value="liberer" />
                <input type="hidden" name="reservation" value={r.id} />
                <button type="submit"
                        class="rounded-[var(--radius-button)] border border-[var(--color-border-prominent)] px-4 py-1.5 text-sm font-medium text-[var(--color-text)] transition-colors hover:bg-[var(--color-bg-accent)]">
                  {r.status === 'waiting' ? 'Retirer de la liste'
                    : passee ? 'Rendre la séance' : 'Retirer de la séance'}
                </button>
              </form>
            )}
          </li>
        );
      })}
    </ul>
  )}

  <h2 class="mt-10 mb-3 text-lg font-bold text-[var(--color-heading)]">Fiche</h2>

  <div class="grid gap-4 md:grid-cols-2">

    <form method="post" class="rounded-xl bg-[var(--color-card-bg)] p-5 shadow-md">
      <input type="hidden" name="action" value="identite" />
      <p class="mb-3 font-medium text-[var(--color-heading)]">Identité</p>

      <div class="grid gap-3 sm:grid-cols-2">
        <div>
          <label for="prenom" class="block text-sm font-medium mb-1">Prénom</label>
          <input id="prenom" name="prenom" required value={participant.first_name} class="champ" />
        </div>
        <div>
          <label for="nom" class="block text-sm font-medium mb-1">Nom</label>
          <input id="nom" name="nom" required value={participant.last_name} class="champ" />
        </div>
      </div>

      <div class="mt-3">
        <label for="audience" class="block text-sm font-medium mb-1">Public</label>
        <select id="audience" name="audience" class="champ">
          {AUDIENCES.map((a) => (
            <option value={a.personne} selected={participant.audience === a.personne}>
              {a.label.replace(/s$/, '')}
            </option>
          ))}
        </select>
      </div>

      <div class="mt-3">
        <label for="telephone" class="block text-sm font-medium mb-1">Téléphone</label>
        <input id="telephone" name="telephone" type="tel" autocomplete="tel"
               value={participant.phone ?? ''} class="champ" />
      </div>

      <div class="mt-3">
        <label for="notes" class="block text-sm font-medium mb-1">Notes</label>
        <textarea id="notes" name="notes" rows="2" class="champ">{participant.notes ?? ''}</textarea>
      </div>

      <button type="submit"
              class="mt-3 rounded-[var(--radius-button)] border-2 border-[var(--color-button)] px-5 py-2 text-sm font-medium text-[var(--color-button)]">
        Enregistrer
      </button>
    </form>

    <form method="post" class="rounded-xl bg-[var(--color-card-bg)] p-5 shadow-md">
      <input type="hidden" name="action" value="acces" />
      <p class="mb-3 font-medium text-[var(--color-heading)]">Accès au site</p>

      <label for="email" class="block text-sm font-medium mb-1">Adresse e-mail</label>
      <input id="email" name="email" type="email"
             value={(participant.accounts as any)?.email ?? ''} class="champ" />

      <p class="mt-2 text-sm text-[var(--color-text-light)]">
        {participant.account_id
          ? 'Modifier l’adresse rattache la personne à un autre compte. Vider le champ retire l’accès — abonnements, réservations et solde sont conservés dans tous les cas.'
          : 'Ouvrir un accès plus tard ne fait rien perdre : abonnements, réservations et solde appartiennent à la personne, pas au compte.'}
      </p>

      <button type="submit"
              class="mt-3 rounded-[var(--radius-button)] border-2 border-[var(--color-button)] px-5 py-2 text-sm font-medium text-[var(--color-button)]">
        {participant.account_id ? 'Mettre à jour' : 'Ouvrir un accès'}
      </button>
    </form>

  </div>

  <a href="/espace-membre/admin/participants/" class="mt-8 inline-block text-sm underline">← Tous les adhérents</a>
</AdminLayout>
