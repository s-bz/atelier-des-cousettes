---
export const prerender = false;

import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { requireAdmin } from '../../../../utils/guards';
import { getAdminClient } from '../../../../utils/supabase';
import { lienEmail, lienWhatsApp } from '../../../../utils/contact';

const garde = requireAdmin(Astro);
if (garde) return garde;

const supabase = getAdminClient();

const { data: personnes } = await supabase
  .from('participants')
  .select('id, first_name, last_name, phone, account_id, accounts(email), subscriptions(id)')
  .order('last_name');

const soldes = new Map<string, number>();
for (const p of personnes ?? []) {
  const { data } = await supabase.rpc('balance', { p_participant: p.id });
  soldes.set(p.id, (data as number) ?? 0);
}

type Personne = NonNullable<typeof personnes>[number];

/**
 * On ne regroupe QUE lorsqu'un compte porte plusieurs personnes.
 *
 * La notion de famille n'existe que dans ce cas ; l'immense majorité des
 * adhérents sont des adultes venant seuls. Imposer un niveau d'imbrication à tout
 * le monde pour accommoder deux ou trois familles ferait payer le cas rare par
 * le cas courant.
 */
const foyers: { compte: string | null; email: string | null; membres: Personne[] }[] = [];
const parCompte = new Map<string, Personne[]>();

for (const p of personnes ?? []) {
  if (!p.account_id) {
    foyers.push({ compte: null, email: null, membres: [p] });
    continue;
  }
  parCompte.set(p.account_id, [...(parCompte.get(p.account_id) ?? []), p]);
}

for (const [compte, membres] of parCompte) {
  foyers.push({ compte, email: (membres[0].accounts as any)?.email ?? null, membres });
}

foyers.sort((a, b) => a.membres[0].last_name.localeCompare(b.membres[0].last_name, 'fr'));

/**
 * L'état d'un adhérent, en un mot.
 *
 * Le solde était affiché tel quel — « 5 séances » — ce qui se lit comme un
 * total acheté alors que c'est un RESTE À PLACER. Isabelle ne pouvait donc pas
 * répondre d'un coup d'œil à la seule question qu'elle se pose en ouvrant cet
 * écran : qui n'a pas encore choisi ses dates.
 *
 * Trois états, et non le nombre nu :
 *   • à placer     — des séances acquises sans date choisie ;
 *   • tout placé   — rien à faire, et c'est le cas normal ;
 *   • à facturer   — plus de séances prises que d'acquises.
 */
function etatDe(solde: number, sansAbonnement: boolean) {
  if (sansAbonnement) {
    return { texte: 'aucun abonnement', urgent: true, discret: false };
  }
  if (solde < 0) {
    return { texte: `${-solde} à facturer`, urgent: true, discret: false };
  }
  if (solde === 0) {
    return { texte: 'tout est placé', urgent: false, discret: true };
  }
  return { texte: `${solde} à placer`, urgent: false, discret: false };
}

// Le compte de ceux qui attendent quelque chose, annoncé en tête : sur vingt
// lignes, deux pastilles se remarquent moins qu'une phrase.
const enAttente = (personnes ?? []).filter((p) => {
  const solde = soldes.get(p.id) ?? 0;
  return (p.subscriptions ?? []).length > 0 && solde > 0;
}).length;

const aFacturer = (personnes ?? []).filter((p) => (soldes.get(p.id) ?? 0) < 0).length;
---

<AdminLayout title="Adhérents" soustitre="Les personnes qui viennent à l’atelier.">

  <a href="/espace-membre/admin/participants/nouveau/"
     class="inline-block rounded-[var(--radius-button)] bg-[var(--color-button)] px-6 py-3 font-medium text-white">
    Inscrire quelqu’un
  </a>

  {/*
    Le bilan avant la liste : c'est la question qu'on se pose en ouvrant cet
    écran, et vingt lignes à parcourir n'y répondent pas aussi vite qu'une
    phrase.
  */}
  <p class="mt-6 mb-8 text-[var(--color-text)]">
    {enAttente === 0 && aFacturer === 0 && 'Tout le monde a choisi ses dates, et rien n’est à facturer.'}
    {enAttente > 0 && (
      <span>
        <strong>{enAttente}</strong> adhérent{enAttente > 1 ? 's ont' : ' a'} des séances
        acquises sans date choisie.
      </span>
    )}
    {aFacturer > 0 && (
      <span class="text-[var(--color-button)]">
        {enAttente > 0 ? ' ' : ''}<strong>{aFacturer}</strong> dépasse{aFacturer > 1 ? 'nt' : ''} son forfait —
        {' '}<a href="/espace-membre/admin/a-facturer/" class="underline">à facturer</a>.
      </span>
    )}
  </p>

  {foyers.length === 0 ? (
    <p class="rounded-xl bg-[var(--color-card-bg)] p-5 text-[var(--color-text)] shadow-md">
      Personne pour l’instant.
    </p>
  ) : (
    <div class="space-y-3">
      {foyers.map((foyer) => {
        const famille = foyer.membres.length > 1;

        const ligne = (p: Personne) => {
          const solde = soldes.get(p.id) ?? 0;
          const sansAbonnement = (p.subscriptions ?? []).length === 0;
          const email = lienEmail((p.accounts as any)?.email);
          const whatsapp = lienWhatsApp(p.phone);

          // Les boutons de contact sont HORS du lien de la fiche : un lien
          // n'en contient pas un autre, et les imbriquer produirait un balisage
          // que les navigateurs réparent chacun à leur façon.
          return (
            <div class="flex flex-wrap items-center gap-x-3 gap-y-1 px-4 py-3">
              <a href={`/espace-membre/admin/participants/${p.id}/`}
                 class="flex min-w-0 flex-1 flex-wrap items-center gap-x-3 gap-y-1 transition-opacity hover:opacity-70">
                <span class="font-medium text-[var(--color-heading)]">
                  {p.last_name} {p.first_name}
                </span>
                {!famille && !p.account_id && (
                  <span class="text-xs text-[var(--color-text-light)]">
                    {p.phone ? `sans accès · ${p.phone}` : 'sans accès — ne recevra aucun e-mail'}
                  </span>
                )}
                {!famille && p.account_id && (
                  <span class="text-sm text-[var(--color-text-light)]">
                    {(p.accounts as any)?.email}
                  </span>
                )}
              </a>

              {/*
                Une pastille plutôt qu'un nombre nu : « 5 » ne dit pas s'il
                reste cinq séances à placer ou cinq à payer. Seul l'état qui
                demande quelque chose est mis en couleur — tout marquer revient
                à ne rien marquer.
              */}
              {(() => {
                const etat = etatDe(solde, sansAbonnement);
                return (
                  <span class={`shrink-0 rounded-full px-3 py-1 text-xs font-medium ${
                    etat.urgent
                      ? 'bg-[var(--color-button)] text-white'
                      : etat.discret
                        ? 'text-[var(--color-text-light)]'
                        : 'bg-[var(--color-bg-accent)] text-[var(--color-heading)]'
                  }`}>
                    {etat.texte}
                  </span>
                );
              })()}

              <span class="flex items-center gap-1">
                {email && (
                  <a href={email}
                     title={`Écrire à ${p.first_name}`}
                     aria-label={`Écrire à ${p.first_name} ${p.last_name}`}
                     class="rounded-lg p-2 text-[var(--color-text-light)] transition-colors hover:bg-[var(--color-bg-accent)] hover:text-[var(--color-button)]">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none"
                         stroke="currentColor" stroke-width="1.8" aria-hidden="true">
                      <rect x="2.5" y="4.5" width="19" height="15" rx="2.5" />
                      <path d="m3 7 9 6 9-6" />
                    </svg>
                  </a>
                )}
                {whatsapp && (
                  <a href={whatsapp} target="_blank" rel="noopener noreferrer"
                     title={`WhatsApp — ${p.phone}`}
                     aria-label={`Écrire à ${p.first_name} ${p.last_name} sur WhatsApp`}
                     class="rounded-lg p-2 text-[var(--color-text-light)] transition-colors hover:bg-[var(--color-bg-accent)] hover:text-[var(--color-button)]">
                    <svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                      <path d="M12.04 2C6.58 2 2.13 6.45 2.13 11.91c0 1.75.46 3.45 1.32 4.95L2 22l5.25-1.38a9.87 9.87 0 0 0 4.79 1.22h.01c5.46 0 9.91-4.45 9.91-9.91 0-2.65-1.03-5.14-2.9-7.01A9.82 9.82 0 0 0 12.04 2Zm0 18.15h-.01a8.2 8.2 0 0 1-4.18-1.15l-.3-.18-3.11.82.83-3.04-.2-.31a8.19 8.19 0 0 1-1.26-4.38c0-4.54 3.7-8.23 8.24-8.23a8.18 8.18 0 0 1 8.23 8.24c0 4.54-3.7 8.23-8.24 8.23Zm4.52-6.16c-.25-.12-1.47-.72-1.69-.81-.23-.08-.39-.12-.56.13-.16.24-.64.8-.78.97-.15.16-.29.18-.53.06-.25-.12-1.05-.39-1.99-1.23-.74-.66-1.23-1.47-1.38-1.72-.14-.25-.01-.38.11-.5.11-.11.25-.29.37-.43.13-.15.17-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.56-1.34-.76-1.84-.2-.48-.4-.42-.56-.43h-.47c-.16 0-.43.06-.65.31-.22.25-.85.83-.85 2.03s.87 2.35.99 2.51c.12.16 1.71 2.61 4.14 3.66.58.25 1.03.4 1.38.51.58.19 1.11.16 1.53.1.47-.07 1.44-.59 1.64-1.16.2-.57.2-1.05.14-1.16-.06-.1-.22-.16-.47-.28Z" />
                    </svg>
                  </a>
                )}
              </span>
            </div>
          );
        };

        if (!famille) {
          return (
            <div class="rounded-xl bg-[var(--color-card-bg)] shadow-md">{ligne(foyer.membres[0])}</div>
          );
        }

        return (
          <div class="rounded-xl border border-[var(--color-border-prominent)] bg-[var(--color-card-bg)] shadow-md">
            <p class="border-b border-[var(--color-border)] px-4 py-2 text-sm text-[var(--color-text-light)]">
              Même compte · {foyer.email}
            </p>
            <div class="divide-y divide-[var(--color-border)]">
              {foyer.membres.map(ligne)}
            </div>
            <a href={`/espace-membre/admin/participants/nouveau/?compte=${foyer.compte}`}
               class="block border-t border-[var(--color-border)] px-4 py-2 text-sm text-[var(--color-button)] underline">
              Ajouter une personne sur ce compte
            </a>
          </div>
        );
      })}
    </div>
  )}
</AdminLayout>
