---
export const prerender = false;

import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { requireAdmin } from '../../../../utils/guards';
import { getAdminClient } from '../../../../utils/supabase';
import { notifier, variablesAccueil } from '../../../../utils/emails';
import { AUDIENCES, memePublic } from '../../../../utils/ateliers';
import { trouverOuCreerCompte, creerParticipant, creerAbonnement, inscrireDOffice,
  saisonDe, bornesSaison, premierJourDuMois, dernierJourDuMois }
  from '../../../../utils/inscriptions';
import { lireCatalogueFormules, libelleFormule } from '../../../../utils/tarifs';

const garde = requireAdmin(Astro);
if (garde) return garde;

const supabase = getAdminClient();

/**
 * Un seul écran pour une seule action : inscrire quelqu'un aux ateliers.
 *
 * La version précédente créait d'abord une « personne », puis obligeait à
 * ouvrir une autre page et à déplier un panneau pour lui donner un abonnement.
 * C'était le modèle de données exposé tel quel : or une personne sans
 * abonnement n'a aucun crédit, n'est jamais auto-inscrit, et ne sert donc à
 * rien. Les deux ne se séparent pas dans le travail réel d'Isabelle.
 */

// Ajout d'une personne sur un compte existant (une deuxième fille).
const compteExistant = Astro.url.searchParams.get('compte');
let emailCompteExistant: string | null = null;
if (compteExistant) {
  const { data } = await supabase
    .from('accounts').select('email').eq('id', compteExistant).maybeSingle();
  emailCompteExistant = data?.email ?? null;
}

/*
 * SEULS LES CRÉNEAUX QU'UNE INSCRIPTION D'OFFICE PEUT HONORER.
 *
 * La liste proposait tout ce que porte la table : les stages, la séance du
 * jeudi soir vendue à l'unité, et les créneaux archivés. Or `run_auto_enrolment`
 * exige `kind = 'atelier'` ET `au_forfait` — un abonnement attaché à l'un des
 * autres ne pose jamais aucune place, en silence. Offrir un choix impossible,
 * c'est le faire faire tôt ou tard.
 */
const { data: creneaux } = await supabase
  .from('creneaux')
  .select('id, label, audience')
  .eq('kind', 'atelier')
  .eq('au_forfait', true)
  .is('archived_at', null)
  .order('label');

const formules = await lireCatalogueFormules(supabase);

/*
 * LES DEUX MOIS SE DÉDUISENT DE LA SAISON, ils ne se saisissent plus.
 *
 * Ils étaient à taper pour chaque adhérent, à l'identique, avec le risque
 * qu'une saisie s'écarte d'un jour et rogne la saison sans que rien ne le dise.
 * Ils restent modifiables : quelqu'un qui arrive en janvier a bien un premier
 * mois à lui.
 */
const saison = bornesSaison(saisonDe(new Date()));

const champs = {
  prenom: '', nom: '', telephone: '', email: '', notes: '', audience: 'adulte',
  creneau: '', formule: '', type: 'forfait', credits: '',
  debut: saison?.debut.slice(0, 7) ?? '',
  fin: saison?.fin.slice(0, 7) ?? '',
};
let erreur: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  for (const cle of Object.keys(champs) as (keyof typeof champs)[]) {
    champs[cle] = String(form.get(cle) ?? '').trim();
  }

  const email = champs.email.toLowerCase();

  const creneauChoisi = (creneaux ?? []).find((c) => c.id === champs.creneau);
  const formuleChoisie = formules.find((f) => f.id === champs.formule);

  if (!champs.prenom || !champs.nom) {
    erreur = 'Le prénom et le nom sont nécessaires.';
  } else if (!champs.debut || !champs.fin) {
    erreur = 'Indiquez le premier et le dernier mois.';
  } else if (champs.debut > champs.fin) {
    erreur = 'Le dernier mois ne peut pas précéder le premier.';
  } else if (creneauChoisi && !memePublic(champs.audience, creneauChoisi.audience)) {
    // L'AUTO-INSCRIPTION EXIGE QUE LES DEUX PUBLICS S'ACCORDENT, et écarte le
    // reste sans rien dire. Laisser passer l'assemblage, c'est créer un
    // abonnement dont le planning restera vide sans qu'on sache pourquoi.
    erreur = `Ce créneau accueille le public « ${creneauChoisi.audience} », `
      + `mais la personne est inscrite comme « ${champs.audience} ». `
      + `Choisissez un créneau de son public, ou corrigez le public.`;
  } else if (formuleChoisie && !memePublic(champs.audience, formuleChoisie.audience)) {
    erreur = `Cette formule est celle du public « ${formuleChoisie.audience} », `
      + `mais la personne est inscrite comme « ${champs.audience} ».`;
  } else {
    let accountId: string | null = compteExistant;

    if (!accountId && email) {
      const compte = await trouverOuCreerCompte(supabase, email);
      if (compte.ok) accountId = compte.valeur;
      else erreur = compte.erreur;
    }

    if (!erreur) {
      const nouvelle = await creerParticipant(supabase, {
        compteId: accountId,
        prenom: champs.prenom,
        nom: champs.nom,
        telephone: champs.telephone,
        audience: champs.audience,
        notes: champs.notes,
      });

      if (!nouvelle.ok) {
        erreur = nouvelle.erreur;
      } else {
        const personne = { id: nouvelle.valeur };

        const abonnement = await creerAbonnement(supabase, {
          participantId: personne.id,
          creneauId: champs.creneau,
          debut: premierJourDuMois(champs.debut),
          fin: dernierJourDuMois(champs.fin),
          // La formule l'emporte : elle fixe le nombre de séances (par le
          // déclencheur en base) ET le prix d'un dépassement. Les crédits
          // saisis à la main ne servent qu'à l'abonnement qui ne correspond à
          // aucune formule du catalogue.
          formuleId: champs.formule || null,
          creditsParMois: champs.type === 'forfait' ? null : Number(champs.credits || 0),
          totalCredits: champs.type === 'forfait' ? Number(champs.credits || 0) : null,
        });

        if (!abonnement.ok) {
          erreur = `Personne créée, mais ${abonnement.erreur.charAt(0).toLowerCase()}${abonnement.erreur.slice(1)}`;
        } else {
          // Inscrire d'office TOUT DE SUITE, sans attendre le cron du
          // lendemain. Sans cela, Isabelle crée quelqu'un, ouvre la feuille de
          // présence, n'y voit personne, et conclut que ça ne marche pas.
          // La fonction est idempotente : l'appeler ici ne fait pas double
          // emploi avec la tâche quotidienne.
          const auto = await inscrireDOffice(supabase);
          if (!auto.ok) console.error('[inscription] auto-inscription :', auto.erreur);

          // Message d'accueil, APRÈS l'auto-inscription : il porte la liste des
          // séances retenues, et l'envoyer avant donnerait une liste vide.
          //
          // Sans adresse e-mail, rien ne part — c'est le cas normal d'une
          // personne inscrite au téléphone, pas un échec. L'écran suivant le
          // dit, pour qu'Isabelle sache qu'elle a ce relais à faire.
          // Sur un compte existant, l'adresse n'est pas dans le formulaire —
          // le champ n'y figure même pas : elle vient du compte.
          const destinataire = email || emailCompteExistant;

          // LES PLACES RÉELLEMENT POSÉES, lues qu'il y ait un e-mail ou non.
          // Cette requête ne servait qu'au message d'accueil ; l'écran suivant,
          // lui, annonçait « inscrit d'office aux prochaines séances » sans
          // rien savoir. Quand l'abonnement commence plus tard — le cas de
          // toute inscription prise avant la rentrée — il n'y a aucun crédit à
          // dépenser, donc aucune place posée, et l'écran affirmait le
          // contraire.
          const { data: retenues } = await supabase
            .from('bookings')
            .select('sessions!inner(starts_at, ends_at, location)')
            .eq('participant_id', personne.id)
            .eq('status', 'booked')
            .order('starts_at', { referencedTable: 'sessions' });

          if (accountId && destinataire) {
            await notifier('bienvenue', destinataire, variablesAccueil({
              prenom: champs.prenom,
              creneau: creneauChoisi?.label ?? null,
              seances: (retenues ?? []).map((r: any) => r.sessions),
              // LE SOLDE ANNONCÉ SUIT LA FORMULE quand il y en a une : les
              // crédits saisis à la main sont alors vides, et le message
              // d'accueil dirait « 0 séance » à quelqu'un qui vient d'en
              // acheter dix-huit.
              solde: formuleChoisie?.seances ?? Number(champs.credits || 0),
            }));
          }

          return Astro.redirect(
            `/espace-membre/admin/participants/${personne.id}/?inscrit=1&posees=${(retenues ?? []).length}`
            + (accountId && destinataire ? '&accueil=1' : ''),
          );
        }
      }
    }
  }
}
---

<AdminLayout
  title={emailCompteExistant ? 'Ajouter une personne' : 'Inscrire quelqu’un'}
  soustitre={emailCompteExistant
    ? `Sur le compte ${emailCompteExistant}`
    : 'Son identité, et la formule choisie.'}
>
  {erreur && (
    <p role="alert" class="mb-6 rounded-xl bg-[var(--color-card-bg)] p-4 text-sm text-[var(--color-button)] shadow-md">
      {erreur}
    </p>
  )}

  <form method="post" class="max-w-2xl space-y-8">

    <fieldset class="space-y-4">
      <legend class="mb-2 text-lg font-bold text-[var(--color-heading)]">Qui</legend>

      <div class="grid gap-4 sm:grid-cols-2">
        <div>
          <label for="prenom" class="block text-sm font-medium mb-1">Prénom</label>
          <input id="prenom" name="prenom" required value={champs.prenom} class="champ" />
        </div>
        <div>
          <label for="nom" class="block text-sm font-medium mb-1">Nom</label>
          <input id="nom" name="nom" required value={champs.nom} class="champ" />
        </div>
        <div>
          <label for="audience" class="block text-sm font-medium mb-1">Public</label>
          <select id="audience" name="audience" required class="champ">
            {AUDIENCES.map((a) => (
              <option value={a.personne} selected={champs.audience === a.personne}>
                {a.label.replace(/s$/, '')}
              </option>
            ))}
          </select>
          <p class="mt-1 text-sm text-[var(--color-text-light)]">
            Les séances adultes durent 3 h, les séances ados et enfants 2 h.
            Chacun ne peut s’inscrire qu’aux séances de son public.
          </p>
        </div>

        <div>
          <label for="telephone" class="block text-sm font-medium mb-1">
            Téléphone <span class="text-[var(--color-text-light)]">— facultatif</span>
          </label>
          <input id="telephone" name="telephone" type="tel" autocomplete="tel"
                 value={champs.telephone} class="champ" />
        </div>
        {!emailCompteExistant && (
          <div>
            <label for="email" class="block text-sm font-medium mb-1">
              Adresse e-mail <span class="text-[var(--color-text-light)]">— facultatif</span>
            </label>
            <input id="email" name="email" type="email" value={champs.email} class="champ" />
            <p class="mt-1 text-sm text-[var(--color-text-light)]">
              Pour permettre la réservation en ligne. Sans adresse, vous gérez les réservations
              et aucun e-mail n’est envoyé.
            </p>
          </div>
        )}
      </div>
    </fieldset>

    <fieldset class="space-y-4">
      <legend class="mb-2 text-lg font-bold text-[var(--color-heading)]">Sa formule</legend>

      <div class="grid gap-4 sm:grid-cols-2">
        <div class="sm:col-span-2">
          <label for="creneau" class="block text-sm font-medium mb-1">Créneau habituel</label>
          <select id="creneau" name="creneau" class="champ">
            <option value="">Aucun créneau attitré</option>
            {(creneaux ?? []).map((c) => (
              <option value={c.id} data-public={c.audience} selected={c.id === champs.creneau}>
                {c.label} — {c.audience}
              </option>
            ))}
          </select>
          <p class="mt-1 text-sm text-[var(--color-text-light)]">
            Celui où l’inscription est automatique. Venir à un autre créneau reste possible.
          </p>
        </div>

        <div class="sm:col-span-2">
          <label for="formule" class="block text-sm font-medium mb-1">Formule</label>
          <select id="formule" name="formule" class="champ">
            <option value="">Aucune — saisie libre ci-dessous</option>
            {formules.map((f) => (
              <option value={f.id} data-public={f.audience} selected={f.id === champs.formule}>
                {libelleFormule(f)}
              </option>
            ))}
          </select>
          <p class="mt-1 text-sm text-[var(--color-text-light)]">
            Choisir une formule fixe le nombre de séances et le prix d’un dépassement.
            Sans formule, une séance en plus se facture au tarif d’une séance sans engagement.
          </p>
        </div>

        <div class="sm:col-span-2">
          <label for="type" class="block text-sm font-medium mb-1">
            Sans formule — type de forfait
          </label>
          <select id="type" name="type" class="champ">
            <option value="forfait" selected={champs.type === 'forfait'}>
              Forfait pour la saison — tout est disponible dès le début
            </option>
            <option value="mensuel" selected={champs.type !== 'forfait'}>
              Tant de séances par mois — elles s’acquièrent au fil des mois
            </option>
          </select>
          <p class="mt-1 text-sm text-[var(--color-text-light)]">
            Sans effet si une formule est choisie. Un forfait affiche d’emblée tout ce qui a
            été acheté ; un forfait mensuel ouvre son quota chaque mois. Dans les deux cas,
            l’inscription d’office étale les séances sur l’année.
          </p>
        </div>

        <div>
          <label for="credits" class="block text-sm font-medium mb-1">
            Sans formule — nombre de séances
          </label>
          <input id="credits" name="credits" type="number" min="0"
                 value={champs.credits} class="champ" />
          <p class="mt-1 text-sm text-[var(--color-text-light)]">
            Pour la saison, ou par mois, selon le type choisi.
            0 en cas de paiement à la séance.
          </p>
        </div>

        <div>
          <label for="debut" class="block text-sm font-medium mb-1">Premier mois</label>
          <input id="debut" name="debut" type="month" required value={champs.debut} class="champ" />
          <p class="mt-1 text-sm text-[var(--color-text-light)]">
            Pré-rempli sur la saison en cours. Modifiable pour qui arrive en cours d’année.
          </p>
        </div>
        <div>
          <label for="fin" class="block text-sm font-medium mb-1">Dernier mois</label>
          <input id="fin" name="fin" type="month" required value={champs.fin} class="champ" />
        </div>
      </div>
    </fieldset>

    <div>
      <label for="notes" class="block text-sm font-medium mb-1">
        Notes <span class="text-[var(--color-text-light)]">— facultatif</span>
      </label>
      <textarea id="notes" name="notes" rows="2" class="champ">{champs.notes}</textarea>
    </div>

    <button type="submit"
            class="rounded-[var(--radius-button)] bg-[var(--color-button)] px-6 py-3 font-medium text-white">
      Inscrire
    </button>
  </form>
</AdminLayout>

<script>
  /*
   * LES LISTES SUIVENT LE PUBLIC CHOISI.
   *
   * Sur la fiche d'un participant, le public est déjà connu et les listes se
   * filtrent côté serveur. Ici il se choisit dans le même formulaire : c'est
   * donc au navigateur de suivre. Le contrôle côté serveur reste la garantie —
   * ce script n'est qu'une commodité, et son absence ne laisse rien passer.
   */
  const publics: Record<string, string> = { adulte: 'adultes', ado: 'ados', enfant: 'enfants' };
  const audience = document.getElementById('audience');
  const listes = ['creneau', 'formule']
    .map((id) => document.getElementById(id))
    .filter((el): el is HTMLSelectElement => el instanceof HTMLSelectElement);

  function accorder() {
    if (!(audience instanceof HTMLSelectElement)) return;
    const attendu = publics[audience.value];
    for (const liste of listes) {
      for (const option of liste.options) {
        const sien = option.dataset.public;
        // L'option vide (« Aucun créneau attitré ») n'a pas de public : elle reste.
        const garde = !sien || sien === attendu;
        option.hidden = !garde;
        option.disabled = !garde;
      }
      // Un choix devenu impossible ne doit pas rester sélectionné en silence.
      if (liste.selectedOptions[0]?.disabled) liste.selectedIndex = 0;
    }
  }

  if (audience && listes.length) {
    audience.addEventListener('change', accorder);
    accorder();
  }
</script>
