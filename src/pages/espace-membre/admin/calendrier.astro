---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import { requireAdmin } from '../../../utils/guards';
import { getAdminClient } from '../../../utils/supabase';

/**
 * L'abonnement au calendrier : une URL à coller dans Google, Apple ou Outlook.
 *
 * Cette URL EST le mot de passe. Un agenda va chercher le fichier sans cookie
 * ni en-tête d'authentification, donc le secret ne peut vivre que dans le lien
 * — c'est ainsi que Google distribue l'adresse iCal de ses propres agendas.
 * D'où le bouton de renouvellement : il n'y a pas d'autre façon de couper un
 * abonnement parti trop loin.
 *
 * Le jeton n'est pas chargé par le middleware avec le reste du compte : il ne
 * sert qu'ici, et une valeur qui n'est pas en mémoire ne fuit pas dans une page
 * qui ne la demandait pas.
 */
const garde = requireAdmin(Astro);
if (garde) return garde;

const compte = Astro.locals.account!;
const supabase = getAdminClient();

let message: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  if (form.get('action') === 'renouveler') {
    const { error } = await supabase
      .from('accounts')
      .update({ calendar_token: crypto.randomUUID() })
      .eq('id', compte.id);
    message = error
      ? 'Le lien n’a pas pu être renouvelé. Réessayez dans un instant.'
      : 'Nouveau lien créé. L’ancien ne fonctionne plus : il faut se réabonner avec celui-ci.';
  }
}

const { data: ligne } = await supabase
  .from('accounts')
  .select('calendar_token')
  .eq('id', compte.id)
  .maybeSingle();

const lien = ligne?.calendar_token
  ? `${Astro.site?.origin ?? 'https://atelier-des-cousettes.fr'}/api/calendrier/${ligne.calendar_token}.ics`
  : null;
---

<AdminLayout title="Calendrier" soustitre="Voir les séances dans votre agenda.">

  {message && (
    <p class="mb-6 rounded-xl bg-[var(--color-bg-accent)] p-4 text-sm text-[var(--color-text)]">
      {message}
    </p>
  )}

  <div class="prose mb-8 max-w-none">
    <p>
      Ce lien affiche toutes les séances — ateliers et stages — dans votre agenda,
      avec le nombre d’inscrits dans le titre, leurs noms dans le détail, et un
      lien pour ouvrir la séance et la modifier.
    </p>
  </div>

  {lien && (
    <div class="mb-8 rounded-xl bg-[var(--color-bg-accent)] p-5">
      <label for="lien" class="mb-2 block text-sm font-semibold text-[var(--color-heading)]">
        Votre lien d’abonnement
      </label>
      <div class="flex flex-wrap items-center gap-3">
        {/*
          En lecture seule et non en texte : le champ se sélectionne d'un clic,
          ce qui reste la façon la plus sûre de copier un lien de cent
          caractères quand le presse-papiers est refusé par le navigateur.
        */}
        <input
          id="lien"
          type="text"
          readonly
          value={lien}
          class="min-w-0 flex-1 rounded-lg border border-[var(--color-text-light)] bg-white px-3 py-2 font-mono text-xs text-[var(--color-text)]"
        />
        <button
          type="button"
          id="copier"
          class="rounded-[var(--radius-button)] bg-[var(--color-button)] px-5 py-2 text-sm font-medium text-white"
        >
          Copier
        </button>
      </div>
      <p class="mt-3 text-sm text-[var(--color-button)]">
        Ce lien donne accès aux noms des adhérents : ne le transmettez à personne.
      </p>
    </div>
  )}

  <div class="prose mb-8 max-w-none">
    <h2>Dans Google Agenda</h2>
    <p>
      Sur ordinateur, à gauche, à côté de « Autres agendas », cliquez sur le
      <strong>+</strong> puis sur <strong>À partir de l’URL</strong>. Collez le lien,
      puis <strong>Ajouter un agenda</strong>. Le calendrier apparaît ensuite aussi
      sur le téléphone, avec le même compte Google.
    </p>
    <p>
      <strong>Google met du temps à voir les changements</strong> — souvent plusieurs
      heures, parfois une journée. Une inscription prise ce matin n’apparaîtra donc pas
      tout de suite. L’écran des séances, lui, est toujours à jour.
    </p>

    <h2>Sur iPhone, iPad ou Mac</h2>
    <p>
      Réglages, <strong>Calendrier</strong>, <strong>Comptes</strong>,
      <strong>Ajouter un compte</strong>, <strong>Autre</strong>, puis
      <strong>Ajouter un abonnement à un calendrier</strong>. Collez le lien.
      L’agenda d’Apple se met à jour bien plus vite que celui de Google, et vous
      pouvez lui demander de vérifier toutes les heures.
    </p>
  </div>

  <form method="post" class="border-t border-[var(--color-bg-accent)] pt-6">
    <h2 class="mb-2 text-lg font-bold text-[var(--color-heading)]">Renouveler le lien</h2>
    <p class="mb-4 text-sm text-[var(--color-text-light)]">
      Si le lien a été transmis par erreur, renouvelez-le : l’ancien cesse aussitôt
      de fonctionner. Il faudra vous réabonner avec le nouveau, sur chaque appareil.
    </p>
    <input type="hidden" name="action" value="renouveler" />
    <button
      type="submit"
      class="rounded-[var(--radius-button)] border-2 border-[var(--color-button)] px-5 py-2 text-sm font-medium text-[var(--color-button)]"
    >
      Créer un nouveau lien
    </button>
  </form>

  <script is:inline>
    document.getElementById('copier')?.addEventListener('click', async (evenement) => {
      const champ = document.getElementById('lien');
      const bouton = evenement.currentTarget;
      const initial = bouton.textContent;
      try {
        // Le presse-papiers est refusé hors contexte sécurisé et selon les
        // réglages : la sélection du champ reste alors la solution de repli,
        // et un « Ctrl+C » finit le travail.
        await navigator.clipboard.writeText(champ.value);
        bouton.textContent = 'Copié';
      } catch {
        champ.select();
        bouton.textContent = 'Copiez avec Ctrl+C';
      }
      setTimeout(() => { bouton.textContent = initial; }, 2500);
    });
  </script>
</AdminLayout>
