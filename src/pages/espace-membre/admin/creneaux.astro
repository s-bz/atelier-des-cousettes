---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import { requireAdmin } from '../../../utils/guards';
import { getAdminClient } from '../../../utils/supabase';
import { groupeDe } from '../../../utils/ateliers';
import { toSlug } from '../../../utils/strings';

const garde = requireAdmin(Astro);
if (garde) return garde;

const supabase = getAdminClient();

let message: string | null = null;
let erreur: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const action = String(form.get('action') ?? 'modifier');
  const id = String(form.get('creneau') ?? '');

  if (action === 'archiver' || action === 'reactiver') {
    const { error } = await supabase
      .from('creneaux')
      .update({ archived_at: action === 'archiver' ? new Date().toISOString() : null })
      .eq('id', id);
    if (error) erreur = `Opération impossible : ${error.message}`;
    else message = action === 'archiver'
      ? 'Créneau archivé. Il n’est plus proposé, son historique est conservé.'
      : 'Créneau réactivé.';

  } else if (action === 'supprimer') {
    // Refusé dès qu'une séance ou un abonnement le référence : les clés
    // étrangères l'interdiraient de toute façon, mais un message clair vaut
    // mieux qu'une erreur de contrainte, et l'archivage est la bonne réponse.
    const [{ count: seances }, { count: abonnements }] = await Promise.all([
      supabase.from('sessions').select('id', { count: 'exact', head: true }).eq('creneau_id', id),
      supabase.from('subscriptions').select('id', { count: 'exact', head: true }).eq('home_creneau_id', id),
    ]);

    if ((seances ?? 0) > 0 || (abonnements ?? 0) > 0) {
      const parts = [];
      if (seances) parts.push(`${seances} séance${seances > 1 ? 's' : ''}`);
      if (abonnements) parts.push(`${abonnements} abonnement${abonnements > 1 ? 's' : ''}`);
      erreur = `Suppression impossible : ${parts.join(' et ')} y sont rattaché${
        (seances ?? 0) + (abonnements ?? 0) > 1 ? 's' : ''
      }. Archivez-le plutôt : il cessera d’être proposé sans rien effacer.`;
    } else {
      const { error } = await supabase.from('creneaux').delete().eq('id', id);
      if (error) erreur = `Suppression impossible : ${error.message}`;
      else message = 'Créneau supprimé.';
    }

  } else {
    // Création ou modification : mêmes champs, même validation.
    const debut = String(form.get('debut') ?? '').trim();
    const fin = String(form.get('fin') ?? '').trim();
    const horaire = /^([01]\d|2[0-3]):[0-5]\d$/;

    if (!horaire.test(debut) || !horaire.test(fin)) {
      erreur = 'Les horaires s’écrivent sur 24 heures, par exemple 14:00 ou 09:30.';
    } else if (debut >= fin) {
      erreur = 'L’heure de fin doit suivre l’heure de début.';
    } else {
      const valeurs = {
        audience: String(form.get('audience') ?? 'adultes'),
        default_start_time: debut,
        default_end_time: fin,
        // Le champ libre l'emporte quand il est rempli : c'est ainsi qu'un
        // nouveau lieu entre dans la liste, sans quoi le menu serait une
        // impasse le jour où l'atelier s'installe ailleurs.
        default_location: String(form.get('lieu_autre') ?? '').trim()
                          || String(form.get('lieu') ?? '').trim(),
        default_capacity: Number(form.get('places')),
        default_unit_price_cents: Math.round(Number(form.get('prix')) * 100),
      };

      if (action === 'creer') {
        const label = String(form.get('label') ?? '').trim();
        const kind = String(form.get('kind') ?? 'atelier');
        // L'identifiant suit toSlug(), comme les ancres du site public : un lien
        // profond vers un créneau doit continuer de fonctionner.
        const nouvelId = toSlug(label);

        if (!label) erreur = 'Donnez un nom.';
        else if (!nouvelId) erreur = 'Ce nom ne produit aucun identifiant utilisable.';
        else {
          const { error } = await supabase.from('creneaux').insert({
            id: nouvelId,
            label,
            kind,
            // Le groupe est DÉDUIT du lieu et du public, jamais saisi : il n'est
            // que leur croisement, et le demander à part permettait de le
            // contredire. Un stage n'en a aucun — il vit sur sa propre page.
            group_id: kind === 'stage'
              ? null
              : groupeDe(valeurs.default_location, valeurs.audience),
            ...valeurs,
          });
          if (error) {
            erreur = error.code === '23505'
              ? `Un créneau porte déjà ce nom (${nouvelId}).`
              : `Création impossible : ${error.message}`;
          } else {
            message = kind === 'stage'
              ? `Stage « ${label} » créé. Ajoutez ses dates depuis l’onglet Séances.`
              : `Atelier « ${label} » créé.`;
          }
        }
      } else {
        // Le nom se corrige, l'IDENTIFIANT NON. Il est référencé par les
        // séances, les abonnements et les ancres du site public : le recalculer
        // à partir du nouveau nom orphelinerait tout cela d'un coup. Une faute
        // de frappe dans un intitulé n'a pas à coûter une saison de séances.
        const label = String(form.get('label') ?? '').trim();
        if (!label) {
          erreur = 'Le nom ne peut pas être vide.';
        } else {
          // Le groupe suit le lieu et le public à chaque modification. Sans
          // cela, changer le public d'un atelier laisserait le groupe sur
          // l'ancien : le créneau resterait classé « Enfants » sur le site tout
          // en n'acceptant plus que des adultes. C'est exactement la
          // contradiction que la déduction supprime à la création.
          const estStage = String(form.get('kind') ?? 'atelier') === 'stage';
          const { error } = await supabase
            .from('creneaux')
            .update(estStage
              ? { label, ...valeurs }
              : { label, ...valeurs, group_id: groupeDe(valeurs.default_location, valeurs.audience) })
            .eq('id', id);
          if (error) erreur = `Modification impossible : ${error.message}`;
          else message = 'Modifié. Les séances déjà créées ne changent pas.';
        }
      }
    }
  }
}

const { data: tous } = await supabase
  .from('creneaux')
  .select('id, label, group_id, kind, audience, default_start_time, default_end_time, default_location, default_capacity, default_unit_price_cents, archived_at, sessions(id)')
  .order('label');

const lieux = [...new Set((tous ?? []).map((c) => c.default_location))].sort();
const actifs = (tous ?? []).filter((c) => !c.archived_at);
const archives = (tous ?? []).filter((c) => c.archived_at);

/**
 * Ateliers et stages séparés, parce qu'ils ne se ressemblent que de structure.
 *
 * Un atelier revient chaque semaine et se paie au forfait ; le prix qu'il porte
 * est celui d'une séance HORS forfait, à facturer en fin de saison. Un stage a
 * lieu une fois, et son prix est ce qu'il coûte. Mélangés dans une même liste,
 * la colonne « prix » voulait dire deux choses à la fois.
 */
const SECTIONS = [
  {
    kind: 'atelier',
    titre: 'Ateliers réguliers',
    aide: 'Séances payées par le forfait. Le prix indiqué est celui d’une séance en dépassement, facturée en fin de saison.',
    items: actifs.filter((c) => c.kind === 'atelier'),
    libellePrix: 'Séance hors forfait (€)',
  },
  {
    kind: 'stage',
    titre: 'Stages thématiques',
    aide: 'Payés à l’unité, hors forfait : un stage ne consomme aucune séance et n’apparaît jamais dans les séances à facturer.',
    items: actifs.filter((c) => c.kind === 'stage'),
    libellePrix: 'Prix du stage (€)',
  },
];
---

<AdminLayout
  title="Ateliers et stages"
  soustitre="Les valeurs reprises automatiquement à la création d’une séance."
>
  {message && (
    <p class="mb-6 rounded-xl bg-[var(--color-bg-accent)] p-4 text-sm text-[var(--color-text)]">{message}</p>
  )}
  {erreur && (
    <p role="alert" class="mb-6 rounded-xl bg-[var(--color-card-bg)] p-4 text-sm text-[var(--color-button)] shadow-md">{erreur}</p>
  )}

  <p class="mb-6 max-w-2xl text-[var(--color-text)]">
    Ces valeurs ne sont qu’un point de départ : modifier un créneau n’affecte
    <strong> aucune séance déjà créée</strong>, seulement celles à venir. Pour corriger
    une séance existante, ouvrez-la depuis l’onglet Séances.
  </p>

  {/*
    Deux formulaires de création plutôt qu'un seul avec un sélecteur : le groupe
    ne concerne que les ateliers, et le masquer selon un choix demanderait du
    JavaScript sur un écran qui doit fonctionner sans. Deux formulaires disent
    aussi plus clairement qu'il s'agit de deux choses différentes.
  */}
  {SECTIONS.map((section) => (
    <section class="mb-10">
      <h2 class="mb-1 text-lg font-bold text-[var(--color-heading)]"
          style="font-family: var(--font-heading)">
        {section.titre}
        <span class="ml-2 text-sm font-normal text-[var(--color-text-light)]">
          {section.items.length}
        </span>
      </h2>
      <p class="mb-4 max-w-2xl text-sm text-[var(--color-text-light)]">{section.aide}</p>

      <details class="mb-4 rounded-xl bg-[var(--color-card-bg)] p-5 shadow-md">
        <summary class="cursor-pointer font-medium text-[var(--color-heading)]">
          {section.kind === 'stage' ? 'Ajouter un stage' : 'Ajouter un atelier'}
        </summary>

        {/*
          Les data-prix ne servent qu'à l'ajustement automatique du tarif : ils
          portent les montants là où le script les lit, plutôt que de les
          recopier dans le script lui-même. Absents sur un stage, dont le prix
          n'a rien à voir avec le public.
        */}
        <form method="post" class="mt-4"
              {...(section.kind === 'atelier'
                ? { 'data-prix-adultes': '40.00', 'data-prix-enfants': '30.00' }
                : {})}>
          <input type="hidden" name="action" value="creer" />
          <input type="hidden" name="kind" value={section.kind} />

          <div>
            <label for={`label-${section.kind}`} class="block text-sm font-medium mb-1">Nom</label>
            <input id={`label-${section.kind}`} name="label" required class="champ sm:max-w-sm"
                   placeholder={section.kind === 'stage' ? 'Stage surjeteuse' : 'Atelier du mercredi matin'} />
          </div>

          {/*
            Lieu et public côte à côte : pour un atelier, ce couple décide à lui
            seul du titre sous lequel il paraît sur le site. Les séparer laissait
            croire à deux réglages indépendants.
          */}
          <div class="mt-4 grid gap-4 sm:grid-cols-2">
            <div>
              <label for={`n-lieu-${section.kind}`} class="block text-sm font-medium mb-1">Lieu</label>
              <select id={`n-lieu-${section.kind}`} name="lieu" class="champ">
                {lieux.map((l) => <option value={l}>{l}</option>)}
              </select>
              <input name="lieu_autre" class="champ mt-2" placeholder="ou un nouveau lieu" />
            </div>
            <div>
              <label for={`audience-n-${section.kind}`} class="block text-sm font-medium mb-1">Public</label>
              <select id={`audience-n-${section.kind}`} name="audience" required class="champ">
                <option value="adultes">Adultes</option>
                <option value="enfants">Enfants</option>
              </select>
              <p class="mt-1 text-sm text-[var(--color-text-light)]">
                Seules les personnes de ce public pourront s’y inscrire.
                {section.kind === 'atelier' &&
                  ' Avec le lieu, il décide du titre sous lequel l’atelier paraît sur le site.'}
              </p>
            </div>
          </div>

          <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            <div>
              <label for={`n-debut-${section.kind}`} class="block text-sm font-medium mb-1">Début</label>
              <input id={`n-debut-${section.kind}`} name="debut" required value="14:00" class="champ"
                     inputmode="numeric" pattern="([01][0-9]|2[0-3]):[0-5][0-9]" placeholder="14:00" />
            </div>
            <div>
              <label for={`n-fin-${section.kind}`} class="block text-sm font-medium mb-1">Fin</label>
              <input id={`n-fin-${section.kind}`} name="fin" required value="17:00" class="champ"
                     inputmode="numeric" pattern="([01][0-9]|2[0-3]):[0-5][0-9]" placeholder="17:00" />
            </div>
            <div>
              <label for={`n-places-${section.kind}`} class="block text-sm font-medium mb-1">Places</label>
              <input id={`n-places-${section.kind}`} name="places" type="number" min="1" required
                     value={section.kind === 'stage' ? '6' : '3'} class="champ" />
            </div>
            <div>
              <label for={`n-prix-${section.kind}`} class="block text-sm font-medium mb-1">{section.libellePrix}</label>
              {/* Aucune note sous le champ : le tarif se règle seul sur le
                  public choisi, et l'annoncer répéterait ce que l'écran vient
                  de faire sous les yeux d'Isabelle. */}
              <input id={`n-prix-${section.kind}`} name="prix" type="number" min="0" step="0.01" required
                     value="40.00" class="champ" />
            </div>
          </div>

          <button type="submit" class="mt-4 rounded-[var(--radius-button)] bg-[var(--color-button)] px-6 py-2 font-medium text-white">
            {section.kind === 'stage' ? 'Créer le stage' : 'Créer l’atelier'}
          </button>
        </form>
      </details>

      {section.items.length === 0 ? (
        <p class="rounded-xl bg-[var(--color-card-bg)] p-5 text-[var(--color-text)] shadow-md">
          {section.kind === 'stage' ? 'Aucun stage pour l’instant.' : 'Aucun atelier pour l’instant.'}
        </p>
      ) : (
        <div class="space-y-4">
          {section.items.map((c) => {
            const seances = (c.sessions ?? []).length;
            return (
              <div class="rounded-xl bg-[var(--color-card-bg)] p-5 shadow-md">
                <form method="post"
                      {...(c.kind === 'atelier'
                        ? { 'data-prix-adultes': '40.00', 'data-prix-enfants': '30.00' }
                        : {})}>
                  <input type="hidden" name="action" value="modifier" />
                  <input type="hidden" name="creneau" value={c.id} />
                  <input type="hidden" name="kind" value={c.kind} />

                  {/*
                    Le nom est un champ, pas un titre figé : une coquille dans
                    un intitulé n'était réparable qu'en SQL. Il porte quand même
                    la graisse d'un titre — c'est lui qui permet de repérer la
                    bonne fiche en faisant défiler la liste.
                  */}
                  <div class="mb-4 flex flex-wrap items-center gap-x-3 gap-y-2">
                    <div class="min-w-[16rem] flex-1">
                      <label for={`label-${c.id}`} class="sr-only">Nom</label>
                      <input id={`label-${c.id}`} name="label" required value={c.label}
                             class="champ font-bold text-[var(--color-heading)]" />
                    </div>
                    <a href={`/espace-membre/admin/seances/?creneau=${c.id}`}
                       class="text-sm text-[var(--color-button)] underline">
                      {seances} séance{seances > 1 ? 's' : ''}
                    </a>
                  </div>

                  {/* Lieu et public côte à côte : ils décident du titre public
                      de l'atelier. */}
                  <div class="grid gap-4 sm:grid-cols-2">
                    <div>
                      <label for={`lieu-${c.id}`} class="block text-sm font-medium mb-1">Lieu</label>
                      <select id={`lieu-${c.id}`} name="lieu" class="champ">
                        {lieux.map((l) => (
                          <option value={l} selected={l === c.default_location}>{l}</option>
                        ))}
                      </select>
                      <input name="lieu_autre" class="champ mt-2" placeholder="ou un nouveau lieu" />
                    </div>
                    <div>
                      <label for={`audience-${c.id}`} class="block text-sm font-medium mb-1">Public</label>
                      <select id={`audience-${c.id}`} name="audience" class="champ">
                        <option value="adultes" selected={c.audience === 'adultes'}>Adultes</option>
                        <option value="enfants" selected={c.audience === 'enfants'}>Enfants</option>
                      </select>
                    </div>
                  </div>

                  <div class="mt-4 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
                    <div>
                      <label for={`debut-${c.id}`} class="block text-sm font-medium mb-1">Début</label>
                      <input id={`debut-${c.id}`} name="debut" required class="champ"
                             inputmode="numeric" pattern="([01][0-9]|2[0-3]):[0-5][0-9]"
                             value={c.default_start_time.slice(0, 5)} />
                    </div>
                    <div>
                      <label for={`fin-${c.id}`} class="block text-sm font-medium mb-1">Fin</label>
                      <input id={`fin-${c.id}`} name="fin" required class="champ"
                             inputmode="numeric" pattern="([01][0-9]|2[0-3]):[0-5][0-9]"
                             value={c.default_end_time.slice(0, 5)} />
                    </div>
                    <div>
                      <label for={`places-${c.id}`} class="block text-sm font-medium mb-1">Places</label>
                      <input id={`places-${c.id}`} name="places" type="number" min="1" required
                             value={c.default_capacity} class="champ" />
                    </div>
                    <div>
                      <label for={`prix-${c.id}`} class="block text-sm font-medium mb-1">{section.libellePrix}</label>
                      <input id={`prix-${c.id}`} name="prix" type="number" min="0" step="0.01" required
                             value={(c.default_unit_price_cents / 100).toFixed(2)} class="champ" />
                    </div>
                  </div>

                  <button type="submit"
                          class="mt-4 rounded-[var(--radius-button)] border-2 border-[var(--color-button)] px-5 py-2 text-sm font-medium text-[var(--color-button)]">
                    Enregistrer
                  </button>
                </form>

                <div class="mt-4 flex flex-wrap items-center gap-4 border-t border-[var(--color-border)] pt-3">
                  <form method="post">
                    <input type="hidden" name="action" value="archiver" />
                    <input type="hidden" name="creneau" value={c.id} />
                    <button type="submit" class="text-sm text-[var(--color-text-light)] underline">
                      Archiver
                    </button>
                  </form>

                  {seances === 0 && (
                    <form method="post">
                      <input type="hidden" name="action" value="supprimer" />
                      <input type="hidden" name="creneau" value={c.id} />
                      <button type="submit" class="text-sm text-[var(--color-button)] underline">
                        Supprimer
                      </button>
                    </form>
                  )}

                  <span class="text-sm text-[var(--color-text-light)]">
                    {seances === 0
                      ? 'Aucune séance : suppression possible.'
                      : 'Des séances existent : archivez plutôt que supprimer.'}
                  </span>
                </div>
              </div>
            );
          })}
        </div>
      )}
    </section>
  ))}

  {archives.length > 0 && (
    <details class="mt-8">
      <summary class="cursor-pointer text-sm text-[var(--color-text-light)]">
        {archives.length} créneau{archives.length > 1 ? 'x' : ''} archivé{archives.length > 1 ? 's' : ''}
      </summary>
      <div class="mt-3 space-y-2">
        {archives.map((c) => (
          <div class="flex flex-wrap items-center gap-4 rounded-xl bg-[var(--color-card-bg)] p-4 shadow-md">
            <span class="font-medium text-[var(--color-heading)]">{c.label}</span>
            <span class="text-sm text-[var(--color-text-light)]">
              {(c.sessions ?? []).length} séance{(c.sessions ?? []).length > 1 ? 's' : ''} conservée{(c.sessions ?? []).length > 1 ? 's' : ''}
            </span>
            <form method="post" class="ml-auto">
              <input type="hidden" name="action" value="reactiver" />
              <input type="hidden" name="creneau" value={c.id} />
              <button type="submit" class="text-sm text-[var(--color-button)] underline">Réactiver</button>
            </form>
          </div>
        ))}
      </div>
    </details>
  )}

  {/*
    Le tarif suit le public choisi : 40 € adulte, 30 € enfant.

    UN CONFORT, PAS UN MÉCANISME. Le champ reste saisissable, et sans
    JavaScript la page fonctionne exactement comme avant — c'est la valeur
    envoyée qui compte, jamais ce script. Poser la règle en base aurait empêché
    un tarif exceptionnel ; la laisser au seul souvenir d'Isabelle produisait des
    ateliers enfants à 40 €.

    Les montants viennent des attributs data du formulaire : les écrire ici
    aussi ferait deux endroits à corriger le jour d'une hausse.
  */}
  <script>
    document.querySelectorAll<HTMLFormElement>('form[data-prix-adultes]').forEach((form) => {
      const cible = form.querySelector<HTMLSelectElement>('select[name="audience"]');
      const prix = form.querySelector<HTMLInputElement>('input[name="prix"]');
      if (!cible || !prix) return;

      cible.addEventListener('change', () => {
        const montant = cible.value === 'enfants'
          ? form.dataset.prixEnfants
          : form.dataset.prixAdultes;
        if (montant) prix.value = montant;
      });
    });
  </script>
</AdminLayout>
