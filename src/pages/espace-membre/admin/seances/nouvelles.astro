---
export const prerender = false;

import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { requireAdmin } from '../../../../utils/guards';
import { getAdminClient } from '../../../../utils/supabase';

const garde = requireAdmin(Astro);
if (garde) return garde;

const supabase = getAdminClient();

const { data: creneaux } = await supabase
  .from('creneaux')
  .select('id, label, kind, jour_semaine, default_start_time, default_end_time, default_location, default_capacity')
  .is('archived_at', null)   // un créneau archivé n'est plus proposé
  .order('label');

/**
 * Accepte « 12/10/2026 », « 12-10-2026 » et « 2026-10-12 ».
 *
 * Conservé pour les stages, dont les dates restent saisies à la main : elles
 * sont irrégulières par nature, et aucune liste ne les devinerait.
 */
function lireDate(ligne: string): string | null {
  const t = ligne.trim();
  if (!t) return null;

  let a: number, m: number, j: number;
  const fr = t.match(/^(\d{1,2})[/\-.](\d{1,2})[/\-.](\d{4})$/);
  const iso = t.match(/^(\d{4})-(\d{1,2})-(\d{1,2})$/);

  if (fr) { j = +fr[1]; m = +fr[2]; a = +fr[3]; }
  else if (iso) { a = +iso[1]; m = +iso[2]; j = +iso[3]; }
  else return null;

  // Contrôle réel, et non seulement de forme : le 31 février s'écrit
  // correctement mais n'existe pas, et Postgres le refuserait plus loin avec
  // un message incompréhensible pour Isabelle.
  const d = new Date(Date.UTC(a, m - 1, j));
  if (d.getUTCFullYear() !== a || d.getUTCMonth() !== m - 1 || d.getUTCDate() !== j) return null;

  return `${a}-${String(m).padStart(2, '0')}-${String(j).padStart(2, '0')}`;
}

/**
 * La saison en cours : de septembre à juin.
 *
 * Juillet et août appartiennent à la saison qui s'ouvre en septembre — c'est le
 * moment où Isabelle prépare son calendrier, et lui proposer la saison écoulée
 * n'aurait aucun intérêt.
 */
const aujourdhui = new Date();
const anneeSaison = aujourdhui.getMonth() >= 6
  ? aujourdhui.getFullYear()
  : aujourdhui.getFullYear() - 1;

const debutSaison = new Date(Date.UTC(anneeSaison, 8, 1));      // 1er septembre
const finSaison = new Date(Date.UTC(anneeSaison + 1, 5, 30));   // 30 juin

/** Toutes les dates de la saison tombant ce jour de la semaine. */
function datesDuJour(jour: number): string[] {
  const dates: string[] = [];
  const d = new Date(debutSaison);
  while (d.getUTCDay() !== jour) d.setUTCDate(d.getUTCDate() + 1);
  while (d <= finSaison) {
    dates.push(d.toISOString().slice(0, 10));
    d.setUTCDate(d.getUTCDate() + 7);
  }
  return dates;
}

// Le créneau vient de l'URL : c'est lui qui décide des dates à proposer, il faut
// donc le connaître avant de dessiner la suite. En GET plutôt qu'en JavaScript,
// pour que l'écran fonctionne sans.
const creneauChoisi = Astro.url.searchParams.get('creneau') ?? '';
let saisie = '';
let erreur: string | null = null;
let creees: number | null = null;
let ignorees = 0;
let illisibles: string[] = [];

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const cible = String(form.get('creneau') ?? '');
  saisie = String(form.get('dates') ?? '');

  // Deux origines possibles : les cases cochées d'un atelier, ou la saisie libre
  // d'un stage. Les cases l'emportent quand il y en a.
  const cochees = form.getAll('date').map(String).filter(Boolean);
  const dates: string[] = [...cochees];

  if (cochees.length === 0) {
    for (const ligne of saisie.split(/\r?\n/).map((l) => l.trim()).filter(Boolean)) {
      const d = lireDate(ligne);
      if (d) dates.push(d);
      else illisibles.push(ligne);
    }
  }

  if (!cible) {
    erreur = 'Choisissez un créneau.';
  } else if (dates.length === 0) {
    erreur = 'Aucune date retenue.';
  } else {
    const uniques = [...new Set(dates)];
    const { data, error } = await supabase.rpc('create_sessions', {
      p_creneau: cible,
      p_dates: uniques,
    });
    if (error) {
      console.error('[seances] create_sessions a échoué :', error);
      erreur = `Création impossible : ${error.message}`;
    } else {
      creees = data as number;
      // Écart entre demandé et créé : ces dates existaient déjà. On le dit,
      // plutôt que de laisser croire à une création intégrale.
      ignorees = uniques.length - (data as number);
    }
  }
}

const creneau = (creneaux ?? []).find((c) => c.id === creneauChoisi) ?? null;
const parJour = creneau?.jour_semaine ?? null;

const propositions = parJour !== null ? datesDuJour(parJour) : [];

// Les dates déjà au calendrier : cochées et verrouillées, pour qu'on voie ce qui
// existe sans pouvoir le recréer.
const { data: existantes } = creneau
  ? await supabase.from('sessions').select('starts_at').eq('creneau_id', creneau.id)
  : { data: [] };

const isoParis = new Intl.DateTimeFormat('en-CA', { timeZone: 'Europe/Paris' });
const dejaLa = new Set((existantes ?? []).map((s) => isoParis.format(new Date(s.starts_at))));

/**
 * Ce qui est déjà prévu aux mêmes heures, tous créneaux confondus.
 *
 * Isabelle n'anime qu'un atelier à la fois. Rien ne l'empêchait pourtant de
 * poser un stage sur une date où un atelier tourne déjà : le conflit ne se
 * découvrait qu'en ouvrant le calendrier, ou le jour même. Cinq existent
 * aujourd'hui dans la saison, tous nés du report des dates 2025-2026.
 *
 * On avertit, on ne bloque pas : deux séances simultanées peuvent être voulues
 * — un atelier adultes et un atelier enfants menés avec de l'aide. Refuser
 * ferait du système l'arbitre d'une décision qui n'est pas la sienne.
 */
const debutCreneau = (creneau?.default_start_time ?? '00:00').slice(0, 5);
const finCreneau = (creneau?.default_end_time ?? '00:00').slice(0, 5);

const { data: agenda } = creneau && propositions.length
  ? await supabase
      .from('sessions')
      .select('starts_at, ends_at, creneaux(label)')
      .eq('status', 'scheduled')
      .neq('creneau_id', creneau.id)
      .gte('starts_at', debutSaison.toISOString())
      .lte('starts_at', finSaison.toISOString())
  : { data: [] };

const heureCourte = new Intl.DateTimeFormat('fr-FR', {
  hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Paris',
});

/**
 * Séances déjà prévues qui empiètent sur ce créneau, à cette date.
 *
 * La comparaison se fait sur des heures RENDUES À PARIS, « 14:00 » contre
 * « 17:30 », et non sur des instants reconstruits. Composer « 2027-01-14T17:15 »
 * en JavaScript l'interpréterait dans le fuseau du serveur — UTC en production —
 * et décalerait tout d'une heure ou deux selon la saison. Les deux séances
 * tombant le même jour à Paris, comparer leurs heures locales suffit et ne peut
 * pas se tromper de fuseau.
 */
function conflitsLe(jour: string): string[] {
  return (agenda ?? [])
    .filter((s: any) => {
      if (isoParis.format(new Date(s.starts_at)) !== jour) return false;
      const debut = heureCourte.format(new Date(s.starts_at));
      const fin = heureCourte.format(new Date(s.ends_at));
      return debut < finCreneau && debutCreneau < fin;
    })
    .map((s: any) =>
      `${(s.creneaux as any)?.label} ${heureCourte.format(new Date(s.starts_at))}–${heureCourte.format(new Date(s.ends_at))}`);
}

const moisFr = new Intl.DateTimeFormat('fr-FR', { month: 'long', year: 'numeric', timeZone: 'UTC' });
const jourFr = new Intl.DateTimeFormat('fr-FR', { weekday: 'short', day: 'numeric', timeZone: 'UTC' });
const nomJour = ['dimanche', 'lundi', 'mardi', 'mercredi', 'jeudi', 'vendredi', 'samedi'];

const parMois = new Map<string, string[]>();
for (const d of propositions) {
  const cle = moisFr.format(new Date(`${d}T12:00:00Z`));
  parMois.set(cle, [...(parMois.get(cle) ?? []), d]);
}
---

<AdminLayout title="Créer des séances" soustitre="Un créneau, autant de dates que nécessaire.">

  {creees !== null && (
    <div class="mb-8 rounded-xl bg-[var(--color-bg-accent)] p-5">
      <p class="font-medium text-[var(--color-heading)]">
        {creees} séance{creees > 1 ? 's' : ''} créée{creees > 1 ? 's' : ''}.
      </p>
      {ignorees > 0 && (
        <p class="mt-1 text-sm text-[var(--color-text)]">
          {ignorees} date{ignorees > 1 ? 's' : ''} déjà présente{ignorees > 1 ? 's' : ''}, ignorée{ignorees > 1 ? 's' : ''}.
        </p>
      )}
      <a href={`/espace-membre/admin/seances/?creneau=${creneauChoisi}`}
         class="mt-3 inline-block text-sm underline">
        Voir les séances
      </a>
    </div>
  )}

  {illisibles.length > 0 && (
    <div role="alert" class="mb-8 rounded-xl bg-[var(--color-card-bg)] p-5 shadow-md">
      <p class="font-medium text-[var(--color-button)]">
        {illisibles.length} ligne{illisibles.length > 1 ? 's' : ''} non comprise{illisibles.length > 1 ? 's' : ''}, donc ignorée{illisibles.length > 1 ? 's' : ''} :
      </p>
      <ul class="mt-2 list-disc pl-5 text-sm text-[var(--color-text)]">
        {illisibles.map((l) => <li>{l}</li>)}
      </ul>
    </div>
  )}

  {erreur && (
    <p role="alert" class="mb-6 rounded-xl bg-[var(--color-card-bg)] p-4 text-sm text-[var(--color-button)] shadow-md">
      {erreur}
    </p>
  )}

  <form method="get" class="mb-8 flex flex-wrap items-end gap-3">
    <div class="min-w-[18rem] flex-1">
      <label for="creneau" class="block text-sm font-medium mb-1">Créneau</label>
      <select id="creneau" name="creneau" required class="champ">
        <option value="">Choisir…</option>
        {(creneaux ?? []).map((c) => (
          <option value={c.id} selected={c.id === creneauChoisi}>
            {c.label} — {c.default_start_time.slice(0, 5)} à {c.default_end_time.slice(0, 5)},
            {' '}{c.default_location}, {c.default_capacity} places
          </option>
        ))}
      </select>
    </div>
    <button type="submit" data-si-sans-script
            class="rounded-[var(--radius-button)] border border-[var(--color-border-prominent)] px-5 py-2 text-sm font-medium text-[var(--color-text)]">
      Voir les dates
    </button>
  </form>

  {creneau && (
    <form method="post" class="space-y-6">
      <input type="hidden" name="creneau" value={creneau.id} />

      <p class="rounded-xl bg-[var(--color-bg-accent)] p-4 text-sm text-[var(--color-text)]">
        <strong class="text-[var(--color-heading)]">{creneau.label}</strong> —
        {' '}{creneau.default_start_time.slice(0, 5)} à {creneau.default_end_time.slice(0, 5)},
        {' '}{creneau.default_location}, {creneau.default_capacity} places.
        Chaque séance reste modifiable ensuite.
      </p>

      {parJour !== null ? (
        <div>
          <p class="mb-1 text-sm font-medium">
            Saison {anneeSaison}–{anneeSaison + 1}, tous les {nomJour[parJour]}s
          </p>
          <p class="mb-4 text-sm text-[var(--color-text-light)]">
            Cochez les dates où l’atelier a lieu. Les vacances et les absences se règlent
            en ne les cochant pas. Les dates déjà au calendrier sont grisées.
          </p>

          <div class="space-y-5">
            {[...parMois.entries()].map(([mois, jours]) => (
              <fieldset>
                <legend class="mb-2 text-sm font-medium text-[var(--color-heading)] first-letter:uppercase">
                  {mois}
                </legend>
                <div class="flex flex-wrap gap-2">
                  {jours.map((d) => {
                    const existe = dejaLa.has(d);
                    const conflits = existe ? [] : conflitsLe(d);
                    return (
                      <label title={conflits.length ? `Déjà prévu : ${conflits.join(' · ')}` : undefined}
                             class={`rounded-[var(--radius-button)] border px-3 py-2 text-sm transition-colors ${
                        existe
                          ? 'cursor-not-allowed border-[var(--color-border)] bg-[var(--color-bg-accent)] text-[var(--color-text-light)]'
                          : conflits.length
                            ? 'cursor-pointer border-[var(--color-button)] hover:bg-[var(--color-bg-accent)]'
                            : 'cursor-pointer border-[var(--color-border-prominent)] hover:bg-[var(--color-bg-accent)]'
                      }`}>
                        <input type="checkbox" name="date" value={d} disabled={existe}
                               class="mr-2 align-middle" />
                        {jourFr.format(new Date(`${d}T12:00:00Z`))}
                        {existe && ' ✓'}
                        {/* Le conflit est nommé, pas seulement signalé : « déjà
                            occupé » obligerait à aller voir par quoi. */}
                        {conflits.length > 0 && (
                          <span class="ml-1 block text-xs text-[var(--color-button)]">
                            déjà : {conflits.join(', ')}
                          </span>
                        )}
                      </label>
                    );
                  })}
                </div>
              </fieldset>
            ))}
          </div>
        </div>
      ) : (
        <div>
          {/*
            Pas de jour fixe : saisie libre. C'est le cas des stages, dont les
            dates sont irrégulières — le forfait découverte tient sur un
            mercredi, un jeudi et un vendredi de suite.
          */}
          <label for="dates" class="block text-sm font-medium mb-1">Dates, une par ligne</label>
          <textarea id="dates" name="dates" rows="8" required
                    placeholder={'09/10/2026\n23/10/2026\n06/11/2026'}
                    class="champ font-mono text-sm">{saisie}</textarea>
          <p class="mt-1 text-sm text-[var(--color-text-light)]">
            Formats acceptés : 09/10/2026 ou 2026-10-09. Une date déjà enregistrée est ignorée,
            vous pouvez donc relancer sans risque de doublon.
            {creneau.kind === 'atelier' && (
              <>
                {' '}Pour que les dates soient proposées à cocher, indiquez le jour de la semaine
                {' '}<a href={`/espace-membre/admin/creneaux/${creneau.id}/`}
                        class="text-[var(--color-button)] underline">sur la fiche de l’atelier</a>.
              </>
            )}
          </p>
        </div>
      )}

      <button type="submit"
              class="rounded-[var(--radius-button)] bg-[var(--color-button)] px-6 py-3 font-medium text-white">
        Créer les séances
      </button>
    </form>
  )}

  <script>
    const choix = document.querySelector<HTMLSelectElement>('select#creneau');
    if (choix) {
      choix.addEventListener('change', () => choix.form?.submit());
      choix.form?.querySelectorAll<HTMLElement>('[data-si-sans-script]')
        .forEach((el) => { el.hidden = true; });
    }
  </script>
</AdminLayout>
