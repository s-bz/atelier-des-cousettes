---
export const prerender = false;

import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { requireAdmin } from '../../../../utils/guards';
import { getAdminClient } from '../../../../utils/supabase';

const garde = requireAdmin(Astro);
if (garde) return garde;

const supabase = getAdminClient();

let message: string | null = null;

// Lancement manuel : l'auto-inscription tourne chaque nuit et à chaque nouvel
// abonnement, mais après avoir ajouté des séances il est utile de la
// déclencher sans attendre — et de VOIR qu'elle a tourné.
if (Astro.request.method === 'POST') {
  const { data, error } = await supabase.rpc('run_auto_enrolment', { p_horizon_days: 60 });
  if (error) {
    message = `Auto-inscription impossible : ${error.message}`;
  } else {
    const n = (data as number) ?? 0;
    message = n > 0
      ? `${n} place${n > 1 ? 's réservées' : ' réservée'} d’office.`
      : 'Rien à inscrire : tout le monde est déjà placé sur les séances à venir.';
  }
}

/**
 * À venir par défaut, passé sur demande.
 *
 * Une saison compte 100 à 140 séances. Tout afficher, c'est obliger Isabelle à
 * faire défiler des mois révolus pour atteindre la semaine prochaine — ce
 * qu'elle regarde presque toujours.
 *
 * La bascule passe par l'URL et non par du JavaScript : l'écran doit
 * fonctionner sans, et un lien reste partageable.
 */
const passe = Astro.url.searchParams.get('quand') === 'passe';

// La journée entière compte comme « à venir » : une séance de cet après-midi
// ne doit pas basculer dans le passé à midi.
const debutDuJour = new Date();
debutDuJour.setHours(0, 0, 0, 0);

// Filtre par créneau, pour arriver ici depuis l'écran des ateliers et stages.
// Sur un stage, c'est le seul moyen de voir ses quelques dates sans les
// chercher parmi les cent-vingt séances de la saison.
const creneauFiltre = Astro.url.searchParams.get('creneau');

let requete = supabase
  .from('sessions')
  .select('id, creneau_id, starts_at, ends_at, capacity, status, bookings(status), creneaux(label, kind)');

if (creneauFiltre) requete = requete.eq('creneau_id', creneauFiltre);

const { data: seances } = passe
  ? await requete.lt('starts_at', debutDuJour.toISOString()).order('starts_at', { ascending: false })
  : await requete.gte('starts_at', debutDuJour.toISOString()).order('starts_at');

const { data: creneauNomme } = creneauFiltre
  ? await supabase.from('creneaux').select('label, kind').eq('id', creneauFiltre).maybeSingle()
  : { data: null };

// Compte de l'autre côté, pour que l'onglet annonce ce qu'il contient.
let compte = supabase
  .from('sessions')
  .select('id', { count: 'exact', head: true })
  [passe ? 'gte' : 'lt']('starts_at', debutDuJour.toISOString());
if (creneauFiltre) compte = compte.eq('creneau_id', creneauFiltre);
const { count: nombreAutre } = await compte;

// La bascule à venir/passé doit conserver le filtre : le perdre renverrait sur
// les cent-vingt séances de la saison, sans dire pourquoi.
const lien = (quand?: string) => {
  const p = new URLSearchParams();
  if (quand) p.set('quand', quand);
  if (creneauFiltre) p.set('creneau', creneauFiltre);
  const q = p.toString();
  return `/espace-membre/admin/seances/${q ? `?${q}` : ''}`;
};

type Seance = NonNullable<typeof seances>[number];

const occupees = (s: Seance) =>
  (s.bookings ?? []).filter((b: { status: string }) => b.status === 'booked').length;

const dateFr = new Intl.DateTimeFormat('fr-FR', {
  weekday: 'long', day: 'numeric', month: 'long', timeZone: 'Europe/Paris',
});
const heureFr = new Intl.DateTimeFormat('fr-FR', {
  hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Paris',
});
const moisFr = new Intl.DateTimeFormat('fr-FR', {
  month: 'long', year: 'numeric', timeZone: 'Europe/Paris',
});

// Groupées par mois plutôt que par créneau : au quotidien, Isabelle cherche une
// date, pas un créneau. Le créneau devient une mention sur chaque ligne.
const parMois = new Map<string, Seance[]>();
for (const s of seances ?? []) {
  const cle = moisFr.format(new Date(s.starts_at));
  parMois.set(cle, [...(parMois.get(cle) ?? []), s]);
}
---

<AdminLayout
  title={creneauNomme ? creneauNomme.label : 'Séances'}
  soustitre={creneauNomme
    ? (creneauNomme.kind === 'stage' ? 'Les dates de ce stage.' : 'Les séances de cet atelier.')
    : 'Le calendrier de la saison.'}
>

  {creneauFiltre && (
    <p class="mb-6 flex flex-wrap items-center gap-3 rounded-xl bg-[var(--color-bg-accent)] p-4 text-sm text-[var(--color-text)]">
      Vous ne voyez que ce créneau.
      <a href="/espace-membre/admin/seances/" class="text-[var(--color-button)] underline">
        Voir toute la saison
      </a>
    </p>
  )}

  {message && (
    <p class="mb-6 rounded-xl bg-[var(--color-bg-accent)] p-4 text-sm text-[var(--color-text)]">{message}</p>
  )}

  <div class="mb-8 flex flex-wrap items-center gap-3">
    <a href="/espace-membre/admin/seances/nouvelles/"
       class="rounded-[var(--radius-button)] bg-[var(--color-button)] px-6 py-3 font-medium text-white">
      Créer des séances
    </a>

    <form method="post">
      <button type="submit"
              class="rounded-[var(--radius-button)] border-2 border-[var(--color-button)] px-5 py-3 text-sm font-medium text-[var(--color-button)]">
        Inscrire d’office
      </button>
    </form>

    <nav class="ml-auto flex gap-2" aria-label="Période">
      <a href={lien()}
         aria-current={!passe ? 'page' : undefined}
         class={`rounded-[var(--radius-button)] px-4 py-2 text-sm font-medium ${
           !passe ? 'bg-[var(--color-button)] text-white'
                  : 'border border-[var(--color-border-prominent)] text-[var(--color-text)]'}`}>
        À venir{!passe ? '' : ` (${nombreAutre ?? 0})`}
      </a>
      <a href={lien('passe')}
         aria-current={passe ? 'page' : undefined}
         class={`rounded-[var(--radius-button)] px-4 py-2 text-sm font-medium ${
           passe ? 'bg-[var(--color-button)] text-white'
                 : 'border border-[var(--color-border-prominent)] text-[var(--color-text)]'}`}>
        Passées{passe ? '' : ` (${nombreAutre ?? 0})`}
      </a>
    </nav>
  </div>

  {(seances ?? []).length === 0 && (
    <p class="rounded-xl bg-[var(--color-card-bg)] p-5 text-[var(--color-text)] shadow-md">
      {passe
        ? 'Aucune séance passée.'
        : 'Aucune séance à venir. Créez-en pour un créneau.'}
    </p>
  )}

  {[...parMois.entries()].map(([mois, liste]) => (
    <div class="mb-8">
      <h2 class="mb-3 text-lg font-bold text-[var(--color-heading)] first-letter:uppercase">
        {mois}
      </h2>
      <ul class="space-y-2">
        {liste.map((s) => {
          const prises = occupees(s);
          const complet = prises >= s.capacity;
          const annulee = s.status === 'cancelled';
          return (
            <li>
              <a href={`/espace-membre/admin/seances/${s.id}/`}
                 class={`flex flex-wrap items-center gap-x-4 gap-y-1 rounded-xl bg-[var(--color-card-bg)] p-4 shadow-md transition-opacity hover:opacity-80 ${annulee ? 'opacity-50' : ''}`}>
                <span class="font-medium text-[var(--color-heading)] first-letter:uppercase">
                  {dateFr.format(new Date(s.starts_at))}
                </span>
                <span class="text-sm text-[var(--color-text-light)]">
                  {heureFr.format(new Date(s.starts_at))} – {heureFr.format(new Date(s.ends_at))}
                </span>
                <span class="text-sm text-[var(--color-text-light)]">
                  {(s.creneaux as any)?.label}
                </span>
                <span class={`ml-auto text-sm font-medium ${complet && !annulee ? 'text-[var(--color-button)]' : 'text-[var(--color-text-light)]'}`}>
                  {annulee ? 'Annulée' : `${prises} / ${s.capacity}`}
                </span>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  ))}
</AdminLayout>
