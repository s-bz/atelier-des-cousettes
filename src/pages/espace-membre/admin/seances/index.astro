---
export const prerender = false;

import AdminLayout from '../../../../layouts/AdminLayout.astro';
import { requireAdmin } from '../../../../utils/guards';
import { getAdminClient } from '../../../../utils/supabase';

const garde = requireAdmin(Astro);
if (garde) return garde;

const supabase = getAdminClient();

const { data: creneaux } = await supabase
  .from('creneaux')
  .select('id, label, default_capacity')
  .order('label');

const { data: seances } = await supabase
  .from('sessions')
  .select('id, creneau_id, starts_at, ends_at, capacity, status, bookings(status)')
  .order('starts_at');

type Seance = NonNullable<typeof seances>[number];

const parCreneau = new Map<string, Seance[]>();
for (const s of seances ?? []) {
  const liste = parCreneau.get(s.creneau_id) ?? [];
  liste.push(s);
  parCreneau.set(s.creneau_id, liste);
}

const occupees = (s: Seance) =>
  (s.bookings ?? []).filter((b: { status: string }) => b.status === 'booked').length;

const dateFr = new Intl.DateTimeFormat('fr-FR', {
  weekday: 'long', day: 'numeric', month: 'long',
  timeZone: 'Europe/Paris',
});
const heureFr = new Intl.DateTimeFormat('fr-FR', {
  hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Paris',
});
---

<AdminLayout title="Séances" soustitre="Le calendrier de la saison, créneau par créneau.">

  <a
    href="/espace-membre/admin/seances/nouvelles/"
    class="mb-8 inline-block rounded-[var(--radius-button)] bg-[var(--color-button)] px-6 py-3 font-medium text-white"
  >
    Créer des séances
  </a>

  {(seances ?? []).length === 0 && (
    <p class="rounded-xl bg-white p-5 text-[var(--color-text)] shadow-md">
      Aucune séance pour l’instant. Commencez par en créer pour un créneau.
    </p>
  )}

  {(creneaux ?? []).map((creneau) => {
    const liste = parCreneau.get(creneau.id) ?? [];
    if (liste.length === 0) return null;
    return (
      <div class="mb-10">
        <h2 class="mb-3 text-lg font-bold text-[var(--color-heading)]">{creneau.label}</h2>
        <ul class="space-y-2">
          {liste.map((s) => {
            const prises = occupees(s);
            const complet = prises >= s.capacity;
            const annulee = s.status === 'cancelled';
            return (
              <li>
                <a
                  href={`/espace-membre/admin/seances/${s.id}/`}
                  class={`flex flex-wrap items-center gap-x-4 gap-y-1 rounded-xl bg-white p-4 shadow-md transition-opacity hover:opacity-80 ${annulee ? 'opacity-50' : ''}`}
                >
                  <span class="font-medium text-[var(--color-heading)]">
                    {dateFr.format(new Date(s.starts_at))}
                  </span>
                  <span class="text-sm text-[var(--color-text-light)]">
                    {heureFr.format(new Date(s.starts_at))} – {heureFr.format(new Date(s.ends_at))}
                  </span>
                  <span class={`ml-auto text-sm font-medium ${complet && !annulee ? 'text-[var(--color-button)]' : 'text-[var(--color-text-light)]'}`}>
                    {annulee ? 'Annulée' : `${prises} / ${s.capacity}`}
                  </span>
                </a>
              </li>
            );
          })}
        </ul>
      </div>
    );
  })}
</AdminLayout>
