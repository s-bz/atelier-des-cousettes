---
export const prerender = false;

import AdminLayout from '../../../layouts/AdminLayout.astro';
import { requireAdmin } from '../../../utils/guards';
import { getAdminClient } from '../../../utils/supabase';
import { releverRemboursements } from '../../../utils/remboursements';
import { previenLaListe } from '../../../utils/membre';
import { notifier } from '../../../utils/emails';

const garde = requireAdmin(Astro);
if (garde) return garde;

const supabase = getAdminClient();

/*
 * LES REMBOURSEMENTS REPÉRÉS, EN ATTENTE DE VOTRE ACCORD.
 *
 * La tâche quotidienne interroge HelloAsso et dépose ici ce qu'elle y trouve :
 * un paiement remboursé, ou des échéances arrêtées. Elle n'agit pas — libérer
 * les places de quelqu'un est irréversible pour lui, sa date partant à un
 * autre, et un état mal lu ne doit pas vider un planning tout seul.
 *
 * CONFIRMER LIBÈRE LES SÉANCES NON SUIVIES, jamais celles déjà passées : elles
 * racontent une présence, et les effacer réécrirait les feuilles d'appel.
 */

let message: string | null = null;
let erreur: string | null = null;

if (Astro.request.method === 'POST') {
  const form = await Astro.request.formData();
  const id = String(form.get('id') ?? '');
  const commande = String(form.get('commande') ?? '');

  if (form.get('action') === 'verifier') {
    /*
     * LE MÊME RELEVÉ QUE LA NUIT, à la demande. Un remboursement arrive par
     * notification en quelques secondes ; une annulation d'échéances n'en émet
     * aucune et n'apparaîtrait qu'au prochain passage. Ce bouton évite
     * d'attendre demain pour voir ce qu'on vient de faire.
     */
    const releve = await releverRemboursements(supabase);
    message = releve.deposes > 0
      ? `${releve.deposes} nouveau(x) mouvement(s) trouvé(s) sur ${releve.commandes} commande(s).`
      : `Rien de neuf — ${releve.commandes} commande(s) vérifiée(s).`;
    if (releve.echecs) erreur = `${releve.echecs} commande(s) illisible(s) ; voir le journal.`;
  } else if (form.get('action') === 'ignorer') {
    const { error } = await supabase.from('remboursements')
      .update({ confirme_le: new Date().toISOString(), bilan: 'Écarté sans action.' })
      .eq('commande', commande).is('confirme_le', null);
    if (error) erreur = `Impossible : ${error.message}`;
    else message = 'Écarté. Rien n’a été libéré.';
  } else {
    const { data, error } = await supabase.rpc('annuler_pour_remboursement', { p_commande: commande });

    if (error) {
      erreur = `Libération impossible : ${error.message}`;
    } else {
      const issue = data as {
        liberees?: number; gardees?: number;
        seances?: { starts_at: string; ends_at: string; location: string; attente: string[] }[];
        qui?: { prenom?: string; email?: string } | null;
      };

      const rendues = issue.seances ?? [];

      /*
       * ON PRÉVIENT L'ADHÉRENT. Il voit sinon ses dates disparaître de son
       * planning sans un mot — seize, dans le premier cas réel.
       */
      const dateLongue = new Intl.DateTimeFormat('fr-FR', {
        weekday: 'long', day: 'numeric', month: 'long', year: 'numeric', timeZone: 'Europe/Paris',
      });

      const lignes = rendues.map((s) => `    ${dateLongue.format(new Date(s.starts_at))}`);
      const dates = lignes.length
        ? `Les séances suivantes sont rendues :\n${lignes.join('\n')}`
        : 'Aucune séance à venir n’était réservée.';

      if (issue.qui?.email) {
        await notifier('remboursement', issue.qui.email, {
          prenom: issue.qui.prenom ?? '',
          dates,
        });
      }

      /*
       * ET LES GENS QUI ATTENDAIENT CES PLACES. C'est à eux qu'elles reviennent ;
       * les libérer sans le dire les laisserait attendre devant une place vide.
       */
      let prevenus = 0;
      for (const seance of rendues) {
        if (seance.attente?.length) {
          prevenus += await previenLaListe(seance.attente, seance);
        }
      }

      const bilan = `${issue.liberees ?? 0} séance(s) libérée(s), `
        + `${issue.gardees ?? 0} déjà suivie(s) conservée(s)`
        + (prevenus ? `, ${prevenus} personne(s) prévenue(s) sur liste d’attente.` : '.');
      /*
       * TOUTES LES LIGNES DE LA COMMANDE, et non celle qu'on a cliquée. Une
       * seule annulation d'échéancier en produit autant qu'il restait
       * d'échéances — neuf, sur le premier cas réel. Les laisser une à une
       * ferait confirmer neuf fois la même décision, et les huit suivantes ne
       * trouveraient plus rien à libérer.
       */
      await supabase.from('remboursements')
        .update({ confirme_le: new Date().toISOString(), bilan })
        .eq('commande', commande).is('confirme_le', null);
      message = bilan;
    }
  }
}

const { data: lignes } = await supabase
  .from('remboursements')
  .select('id, commande, paiement, montant_cents, etat, repere_le')
  .is('confirme_le', null)
  .order('repere_le', { ascending: false });

/*
 * UNE CARTE PAR COMMANDE, pas par paiement. Annuler un échéancier de dix mois
 * produit neuf lignes — une par échéance restante — et les afficher telles
 * quelles demanderait de confirmer neuf fois la même décision.
 */
interface Groupe {
  id: string; commande: string; montant_cents: number;
  etats: Set<string>; combien: number; repere_le: string;
}

const attente: Groupe[] = [];
for (const l of lignes ?? []) {
  let g = attente.find((x) => x.commande === l.commande);
  if (!g) {
    g = { id: l.id, commande: l.commande, montant_cents: 0,
          etats: new Set(), combien: 0, repere_le: l.repere_le };
    attente.push(g);
  }
  g.montant_cents += l.montant_cents ?? 0;
  g.etats.add(l.etat);
  g.combien += 1;
}

const { data: faits } = await supabase
  .from('remboursements')
  .select('id, commande, montant_cents, etat, confirme_le, bilan')
  .not('confirme_le', 'is', null)
  .order('confirme_le', { ascending: false })
  .limit(10);

/*
 * À QUI CETTE COMMANDE APPARTIENT-ELLE ? Sans ce rapprochement, l'écran
 * n'afficherait qu'un numéro : impossible de décider quoi que ce soit.
 */
const commandes = [...new Set(attente.map((r) => r.commande))];

const { data: parAbonnement } = commandes.length
  ? await supabase
      .from('subscriptions')
      .select('helloasso_order_id, participants(first_name, last_name, accounts(email))')
      .in('helloasso_order_id', commandes)
  : { data: [] };

const { data: parPlace } = commandes.length
  ? await supabase
      .from('bookings')
      .select('helloasso_order_id, participants(first_name, last_name, accounts(email))')
      .in('helloasso_order_id', commandes)
  : { data: [] };

const quiEst = new Map<string, string>();
for (const l of [...(parAbonnement ?? []), ...(parPlace ?? [])] as any[]) {
  const p = l.participants;
  if (p && l.helloasso_order_id) {
    quiEst.set(l.helloasso_order_id,
      `${p.first_name} ${p.last_name}${p.accounts?.email ? ` — ${p.accounts.email}` : ''}`);
  }
}

const euros = (c: number) => (c / 100).toFixed(2).replace('.', ',').replace(',00', '');
const dateFr = new Intl.DateTimeFormat('fr-FR', {
  day: 'numeric', month: 'long', hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Paris',
});

const motDe = (etat: string) =>
  etat === 'Canceled' ? 'échéances arrêtées' : 'remboursé';
---

<AdminLayout title="Remboursements" soustitre="Repérés chez HelloAsso, à confirmer.">
  <form method="post" class="mb-6">
    <input type="hidden" name="action" value="verifier" />
    <button type="submit"
            class="rounded-[var(--radius-button)] border-2 border-[var(--color-button)] px-5 py-2 text-sm font-medium text-[var(--color-button)]">
      Vérifier maintenant
    </button>
    <span class="ml-3 text-sm text-[var(--color-text-light)]">
      Interroge HelloAsso commande par commande. Utile après une annulation d’échéances, qui
      n’envoie aucun avis.
    </span>
  </form>

  {message && <p class="mb-6 rounded-xl bg-[var(--color-bg-accent)] px-4 py-3">{message}</p>}
  {erreur && <p class="mb-6 rounded-xl bg-[var(--color-bg-pink)] px-4 py-3 text-white">{erreur}</p>}

  {!attente.length ? (
    <p class="rounded-xl bg-[var(--color-card-bg)] p-5 text-[var(--color-text)] shadow-md">
      Rien à confirmer. Un remboursement fait sur HelloAsso apparaît ici dans la minute — c'est
      HelloAsso qui nous prévient. Une vérification a lieu chaque nuit par sécurité, au cas où
      l'avis se perdrait.
    </p>
  ) : (
    <ul class="space-y-4">
      {attente.map((r) => (
        <li class="rounded-xl bg-[var(--color-card-bg)] p-5 shadow-md">
          <p class="font-medium text-[var(--color-heading)]">
            {quiEst.get(r.commande) ?? `Commande ${r.commande} — personne inconnue`}
          </p>
          <p class="mt-1 text-sm text-[var(--color-text-light)]">
            {euros(r.montant_cents)} € · {[...r.etats].map(motDe).join(' et ')}
            {r.combien > 1 && ` · ${r.combien} échéances`}
            {' · '}repéré le {dateFr.format(new Date(r.repere_le))}
            {' · '}commande {r.commande}
          </p>

          {!quiEst.has(r.commande) && (
            <p class="mt-2 rounded-xl bg-[var(--color-bg-accent)] px-3 py-2 text-sm">
              Aucune inscription ne porte cette commande. Elle a peut-être été passée hors du
              site, ou déjà défaite à la main — il n’y a alors rien à libérer.
            </p>
          )}

          <div class="mt-3 flex flex-wrap gap-3">
            <form method="post">
              <input type="hidden" name="id" value={r.id} />
              <input type="hidden" name="commande" value={r.commande} />
              <button type="submit"
                      class="rounded-[var(--radius-button)] bg-[var(--color-button)] px-5 py-2 text-sm font-medium text-white">
                Libérer les séances à venir
              </button>
            </form>
            <form method="post">
              <input type="hidden" name="action" value="ignorer" />
              <input type="hidden" name="id" value={r.id} />
              <button type="submit" class="text-sm text-[var(--color-text-light)] underline">
                Écarter — ne rien faire
              </button>
            </form>
          </div>

          <p class="mt-2 text-sm text-[var(--color-text-light)]">
            Les séances déjà suivies sont conservées ; seules celles à venir repartent aux autres.
          </p>
        </li>
      ))}
    </ul>
  )}

  {faits && faits.length > 0 && (
    <details class="mt-8">
      <summary class="cursor-pointer text-sm text-[var(--color-text-light)]">
        {faits.length} déjà traité{faits.length > 1 ? 's' : ''}
      </summary>
      <ul class="mt-3 space-y-2 text-sm text-[var(--color-text-light)]">
        {faits.map((r) => (
          <li class="rounded-xl bg-[var(--color-card-bg)] p-3 shadow-md">
            <span class="font-mono">{r.commande}</span> · {euros(r.montant_cents)} € ·
            {' '}{r.confirme_le && dateFr.format(new Date(r.confirme_le))} · {r.bilan}
          </li>
        ))}
      </ul>
    </details>
  )}
</AdminLayout>
