---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import DetailCard from '../../components/DetailCard.astro';
import IntroSection from '../../components/IntroSection.astro';
import CrossLinksSection from '../../components/CrossLinksSection.astro';
import CalendrierCreneau from '../../components/CalendrierCreneau.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import FaqSection from '../../components/FaqSection.astro';
import { getPageContext, reader } from '../../utils/reader';
import { resolveImage, resolveImageUrl } from '../../utils/images';
import { toSlug, splitParagraphs } from '../../utils/strings';
import { buildServicePageSchemas } from '../../utils/schema';
import { getAdminClient } from '../../utils/supabase';

/**
 * Aperçu : la page des stages, ses dates et ses tarifs lus en base.
 *
 * LA LISTE DES STAGES vient de la base, et c'est ici que la bascule change le
 * plus de choses : le contenu décrit six stages, la base en porte sept — la
 * formule complète et la formule courte du stage découverte y sont deux produits
 * distincts, avec deux prix et deux calendriers. La page publiée les mélange
 * dans un seul bloc de texte.
 *
 * TOUT LE TEXTE RESTE. Les descriptions longues, les prérequis, la FAQ, les
 * liens croisés, le JSON-LD sont rendus comme sur la page publiée : ce sont des
 * paragraphes d'Isabelle, et rien dans une table ne les remplacera. On les
 * rapproche par le NOM, seul pont existant — les identifiants de la base ont été
 * inventés par le script d'amorçage et ne correspondent pas aux titres.
 *
 * noIndex, et exclue du plan du site.
 */

const page = await reader.singletons.stagesThematiques.read();
if (!page) throw new Error('Contenu des stages introuvable');

const { settings, siteUrl } = await getPageContext(Astro.site);

const coverGlob = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/covers/**/*.{jpg,jpeg,png,webp}');
const couverture = await resolveImage(page.coverImage, coverGlob);
const ogImage = await resolveImageUrl(page.coverImage, coverGlob, Astro.site);

const faqItems = page.faqItems ?? [];
const schemas = buildServicePageSchemas({
  title: page.title,
  seoDescription: page.seoDescription,
  pageUrl: new URL(Astro.url.pathname, Astro.site).toString(),
  siteUrl,
  settings,
  offers: page.schemaOffers ?? [],
  faqItems,
});

const supabase = getAdminClient();

const { data: stages, error } = await supabase
  .from('creneaux')
  .select(`
    id, label, audience, default_location, default_capacity,
    default_unit_price_cents, seances_par_stage,
    sessions(starts_at, ends_at, capacity, places_attente, status, bookings(status))
  `)
  .eq('kind', 'stage')
  .is('archived_at', null)
  .order('label');

const maintenant = new Date().toISOString();

/**
 * Le texte du contenu qui décrit ce stage, s'il en existe un.
 *
 * Rapprochement par préfixe : « Stage découverte de la couture — formule
 * complète » commence par « Stage découverte de la couture ». Les deux formules
 * héritent donc de la même description, ce qui est exact — c'est le même stage,
 * proposé sur deux durées.
 */
const descriptions = page.stages ?? [];
const descriptionDe = (label: string) =>
  descriptions.find((d) => label === d.name || label.startsWith(d.name)) ?? null;

const avecDates = (stages ?? []).map((c) => {
  const aVenir = ((c.sessions ?? []) as any[]).filter(
    (s) => s.status === 'scheduled' && s.starts_at > maintenant,
  );

  // Durée totale d'un stage : la somme de ses `seances_par_stage` premières
  // dates. C'est le chiffre annoncé — « 95 € pour 7 h » — et il ne se lit nulle
  // part ailleurs, les trois matinées faisant 2 h, 2 h et 3 h.
  const pourUneSession = [...((c.sessions ?? []) as any[])]
    .sort((a, b) => a.starts_at.localeCompare(b.starts_at))
    .slice(0, c.seances_par_stage);
  const minutes = pourUneSession.reduce(
    (n, s) => n + (new Date(s.ends_at).getTime() - new Date(s.starts_at).getTime()) / 60000,
    0,
  );

  return {
    ...c,
    aVenir,
    description: descriptionDe(c.label),
    heures: minutes > 0
      ? (minutes % 60 === 0 ? `${minutes / 60} h` : `${Math.floor(minutes / 60)} h ${minutes % 60}`)
      : null,
  };
});

const euros = (cents: number) => (cents / 100).toFixed(cents % 100 === 0 ? 0 : 2);

// « En N séances » et non « forfait de N séances ». Dans cette maison, un forfait
// est un lot de séances d'atelier payé d'avance et posé sur les dates de son
// choix ; un stage en plusieurs séances est l'inverse — une progression, aux
// dates fixées, où l'on vient à toutes. Le même mot pour les deux ferait croire
// qu'on peut n'en prendre qu'une.
const formule = (n: number) => (n > 1 ? `Stage en ${n} séances` : 'Une séance');
---

<BaseLayout title={`${page.title} — aperçu`} description={page.seoDescription}
            ogImage={ogImage} noIndex={true}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schemas).replace(/<\//g, '<\\/')} />
  </Fragment>

  <Hero title={page.title} subtitle={page.subtitle}
        coverImage={couverture ?? undefined} altText={page.coverImageAlt ?? undefined} />

  <div class="bg-[var(--color-bg-accent)] py-3">
    <p class="mx-auto max-w-4xl px-4 text-sm text-[var(--color-text)]">
      <strong class="text-[var(--color-button)]">Aperçu.</strong> Les stages, leurs dates, leurs
      tarifs et leur disponibilité sont lus en base. La version publiée reste
      {' '}<a href="/stages-thematiques/" class="text-[var(--color-button)] underline">ici</a>.
    </p>
  </div>

  {page.introduction && (
    <IntroSection text={page.introduction} ctaLabel={page.ctaLabel} />
  )}

  {avecDates.length === 0 ? (
    <section class="py-16 md:py-20">
      <div class="mx-auto max-w-3xl px-4">
        <div class="rounded-xl bg-[var(--color-bg-accent)] p-5">
          <CalendrierCreneau seances={[]} erreur={Boolean(error)}
                             vide="Aucun stage programmé pour l’instant — me contacter." />
        </div>
      </div>
    </section>
  ) : (
    <Fragment>
      <section class="bg-[var(--color-bg-accent)] py-16 md:py-20">
        <div class="mx-auto max-w-4xl px-4">
          <h2 class="mb-10 text-center text-2xl md:text-3xl font-bold text-[var(--color-heading)]">
            {page.stagesSectionTitle}
          </h2>
          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {avecDates.map((c) => (
              <DetailCard
                name={c.label}
                anchorId={toSlug(c.label)}
                primaryBadge={`${euros(c.default_unit_price_cents)} €`}
                secondaryBadge={c.heures ?? undefined}
                details={[
                  c.description?.shortDescription,
                  `${formule(c.seances_par_stage)} · ${c.default_location}`,
                ].filter((l): l is string => Boolean(l))}
              />
            ))}
          </div>
        </div>
      </section>

      <section class="py-16 md:py-20">
        <div class="mx-auto max-w-3xl space-y-16 px-4">
          {avecDates.map((c) => (
            <div id={toSlug(c.label)} class="scroll-mt-24">
              <h2 class="mb-2 text-xl md:text-2xl font-bold text-[var(--color-heading)]">
                {c.label}
                <span class="ml-2 text-base font-medium text-[var(--color-button)]">
                  {euros(c.default_unit_price_cents)} €{c.heures && ` — ${c.heures}`}
                </span>
              </h2>
              <p class="mb-4 text-sm text-[var(--color-text-light)]">
                {formule(c.seances_par_stage)}
                {' · '}{c.default_location}
                {' · '}{c.default_capacity} places
                {c.audience === 'enfants' && ' · enfants'}
              </p>
              {c.description?.prerequisite && (
                <p class="mb-4 text-sm italic text-[var(--color-text-light)]">
                  {c.description.prerequisite}
                </p>
              )}
              {c.description?.fullDescription && (
                <div class="prose">
                  {splitParagraphs(c.description.fullDescription).map((para) => <p>{para}</p>)}
                </div>
              )}
              <div class="mt-4 rounded-xl bg-[var(--color-bg-accent)] p-4">
                <p class="mb-2 text-sm font-semibold text-[var(--color-heading)]">
                  {c.seances_par_stage > 1 ? 'Dates du stage' : page.datesLabel}
                </p>
                <CalendrierCreneau seances={c.aVenir} erreur={Boolean(error)}
                                   vide="Prochaine session à venir — me contacter." />
              </div>
            </div>
          ))}
          <ContactCTA label={page.ctaLabel} />
        </div>
      </section>
    </Fragment>
  )}

  <FaqSection title={page.faqSectionTitle} items={faqItems} ctaLabel={page.ctaLabel} />

  {page.crossLinksText && (
    <CrossLinksSection text={page.crossLinksText} excludeHref="/stages-thematiques/" />
  )}
</BaseLayout>
