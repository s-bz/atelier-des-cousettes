---
export const prerender = false;

import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import DetailCard from '../../components/DetailCard.astro';
import IntroSection from '../../components/IntroSection.astro';
import CrossLinksSection from '../../components/CrossLinksSection.astro';
import CalendrierCreneau from '../../components/CalendrierCreneau.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import FaqSection from '../../components/FaqSection.astro';
import { getPageContext, reader } from '../../utils/reader';
import { resolveImage, resolveImageUrl } from '../../utils/images';
import { toSlug, splitParagraphs } from '../../utils/strings';
import { buildServicePageSchemas } from '../../utils/schema';
import { getAdminClient } from '../../utils/supabase';

/**
 * Aperçu : la page des stages, ses dates et ses tarifs lus en base.
 *
 * LA LISTE DES STAGES vient de la base, et c'est ici que la bascule change le
 * plus de choses : le contenu décrit six stages, la base en porte sept — la
 * formule complète et la formule courte du stage découverte y sont deux produits
 * distincts, avec deux prix et deux calendriers. La page publiée les mélange
 * dans un seul bloc de texte.
 *
 * TOUT LE TEXTE RESTE. Les descriptions longues, les prérequis, la FAQ, les
 * liens croisés, le JSON-LD sont rendus comme sur la page publiée : ce sont des
 * paragraphes d'Isabelle, et rien dans une table ne les remplacera. On les
 * rapproche par le NOM, seul pont existant — les identifiants de la base ont été
 * inventés par le script d'amorçage et ne correspondent pas aux titres.
 *
 * noIndex, et exclue du plan du site.
 */

const page = await reader.singletons.stagesThematiques.read();
if (!page) throw new Error('Contenu des stages introuvable');

const { settings, siteUrl } = await getPageContext(Astro.site);

const coverGlob = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/covers/**/*.{jpg,jpeg,png,webp}');
const couverture = await resolveImage(page.coverImage, coverGlob);
const ogImage = await resolveImageUrl(page.coverImage, coverGlob, Astro.site);

const faqItems = page.faqItems ?? [];


const supabase = getAdminClient();

const { data: stages, error } = await supabase
  .from('creneaux')
  .select(`
    id, label, audience, default_location, default_capacity,
    default_unit_price_cents, seances_par_stage,
    sessions(starts_at, ends_at, capacity, places_attente, status, bookings(status))
  `)
  .eq('kind', 'stage')
  .is('archived_at', null)
  .order('label');

const maintenant = new Date().toISOString();

/**
 * Le texte du contenu qui décrit ce stage, s'il en existe un.
 *
 * Rapprochement par préfixe : « Stage découverte de la couture — formule
 * complète » commence par « Stage découverte de la couture ». Les deux formules
 * héritent donc de la même description, ce qui est exact — c'est le même stage,
 * proposé sur deux durées.
 */
const descriptions = page.stages ?? [];
const descriptionDe = (label: string) =>
  descriptions.find((d) => label === d.name || label.startsWith(d.name)) ?? null;

const minutesDe = (s: any) =>
  (new Date(s.ends_at).getTime() - new Date(s.starts_at).getTime()) / 60000;

const enHeures = (m: number) =>
  m % 60 === 0 ? `${m / 60} h` : `${Math.floor(m / 60)} h ${m % 60}`;

/** « A, B ou C » — on choisit entre des options, on ne parcourt pas une échelle. */
const enumerer = (parts: string[]) =>
  parts.length < 2 ? (parts[0] ?? '') : `${parts.slice(0, -1).join(', ')} ou ${parts.at(-1)}`;

const avecDates = (stages ?? []).map((c) => {
  const toutes = [...((c.sessions ?? []) as any[])]
    .sort((a, b) => a.starts_at.localeCompare(b.starts_at));
  const aVenir = toutes.filter((s) => s.status === 'scheduled' && s.starts_at > maintenant);

  /**
   * La durée annoncée, et elle ne se calcule pas de la même façon des deux côtés.
   *
   * FORFAIT (plusieurs séances) : la somme des séances du stage. C'est le chiffre
   * annoncé — « 95 € pour 7 h » — et il ne se lit nulle part ailleurs, les trois
   * matinées faisant 2 h, 2 h et 3 h.
   *
   * DATES INDÉPENDANTES : chaque date est une séance à part entière, et RIEN NE
   * LES OBLIGE À DURER PAREIL. L'initiation machine à coudre le montre : trois
   * jeudis de 2 h 30 et un samedi de 3 h. Prendre la durée de la première date
   * pour celle du stage — ce que faisait ce calcul — annonçait 2 h 30 à qui
   * venait le samedi.
   */
  const dureesSeules = [...new Set(aVenir.map(minutesDe))].sort((a, b) => a - b);
  const minutesForfait = toutes
    .slice(0, c.seances_par_stage)
    .reduce((n, s) => n + minutesDe(s), 0);

  const heures = c.seances_par_stage > 1
    ? enHeures(minutesForfait)
    : enumerer(dureesSeules.map(enHeures));

  return {
    ...c,
    aVenir,
    description: descriptionDe(c.label),
    heures: heures || null,
    // Sert à ordonner les formules d'un même stage, de la plus courte à la plus
    // longue. Pour des dates indépendantes, la plus brève fait référence.
    minutes: c.seances_par_stage > 1 ? minutesForfait : (dureesSeules[0] ?? 0),
  };
});

const euros = (cents: number) => (cents / 100).toFixed(cents % 100 === 0 ? 0 : 2);

/**
 * La fourchette de prix de la FAQ, recalculée à chaque visite.
 *
 * Elle était écrite à la main — « de 45 € à 95 € » — et fausse depuis ce midi :
 * la formule de 2 h 30 de l'initiation est à 38 €, donc le plancher a bougé
 * sans que personne ne pense à la phrase qui l'annonce. C'est le propre d'un
 * chiffre recopié.
 *
 * Seuls les NOMBRES sont remplacés : la phrase reste celle d'Isabelle, et si
 * elle la réécrit sans la tournure « de X € à Y € », la réponse passe
 * inchangée plutôt que d'être mutilée.
 */
const prixStages = (stages ?? []).map((c) => c.default_unit_price_cents);
const fourchette = prixStages.length
  ? `de ${euros(Math.min(...prixStages))} € à ${euros(Math.max(...prixStages))} €`
  : null;

const faqAJour = faqItems.map((q) => ({
  ...q,
  answer: fourchette
    ? q.answer.replace(/de\s+\d+(?:,\d+)?\s*€\s+à\s+\d+(?:,\d+)?\s*€/, fourchette)
    : q.answer,
}));
/**
 * Les schémas se calculent ici, après la FAQ et les stages : Astro exécute le
 * frontmatter dans l'ordre.
 *
 * Les offres viennent de la base et non du contenu. Celles du CMS énuméraient
 * six stages quand la base en porte sept, et l'initiation à 45 € quand sa
 * formule courte est à 38 € — un inventaire recopié qui vieillit à chaque
 * changement de tarif, sous les yeux de personne puisque c'est Google qui le
 * lit.
 */
const schemas = buildServicePageSchemas({
  title: page.title,
  seoDescription: page.seoDescription,
  pageUrl: new URL(Astro.url.pathname, Astro.site).toString(),
  siteUrl,
  settings,
  offers: (stages ?? []).map((c) => ({
    name: c.label,
    price: euros(c.default_unit_price_cents),
  })),
  faqItems: faqAJour,
});


// « En N séances » et non « forfait de N séances ». Dans cette maison, un forfait
// est un lot de séances d'atelier payé d'avance et posé sur les dates de son
// choix ; un stage en plusieurs séances est l'inverse — une progression, aux
// dates fixées, où l'on vient à toutes. Le même mot pour les deux ferait croire
// qu'on peut n'en prendre qu'une.
const formule = (n: number) => (n > 1 ? `Stage en ${n} séances` : 'Une séance');

/**
 * Un stage, ses formules regroupées sous un seul titre.
 *
 * La base porte deux lignes nommées « Stage découverte de la couture — formule
 * complète » et « … — formule courte », et c'est juste : ce sont deux cohortes
 * distinctes, chacune avec son prix, ses dates, ses places et sa réservation en
 * bloc. Mais deux cartes aux titres presque identiques, portant la même
 * description, se lisent comme un doublon et laissent le lecteur chercher ce qui
 * les sépare.
 *
 * On les réunit donc à l'affichage : un titre, la description une fois, puis
 * chaque formule avec ce qui la distingue vraiment — sa durée, son prix, ses
 * dates. Le regroupement se fait sur ce qui précède le tiret cadratin, seule
 * marque commune aux deux libellés.
 *
 * Les formules vont de la plus courte à la plus longue : on choisit en pesant ce
 * qu'on est prêt à y consacrer, et la progression se lit dans ce sens.
 */
type Formule = (typeof avecDates)[number] & { variante: string | null };

const familles: { base: string; formules: Formule[] }[] = [];
for (const c of avecDates) {
  const [base, ...reste] = c.label.split('—');
  const famille = familles.find((f) => f.base === base.trim());
  const entree = { ...c, variante: reste.join('—').trim() || null };
  if (famille) famille.formules.push(entree);
  else familles.push({ base: base.trim(), formules: [entree] });
}
// De la plus courte à la plus longue, sur le temps qu'elle demande — non sur le
// nombre de séances, qui vaut 1 des deux côtés dès que les formules se
// distinguent par la durée d'une séance unique.
for (const f of familles) {
  f.formules.sort((a, b) => a.minutes - b.minutes);
}

/**
 * L'ORDRE DES STAGES SUIT CELUI DU CONTENU, et non l'alphabet.
 *
 * Isabelle range ses stages dans le CMS, et cet ordre veut dire quelque chose :
 * l'initiation ouvre, la découverte suit, les stages techniques viennent après.
 * Trier sur le libellé effaçait ce classement et remontait la banane en
 * deuxième position, entre l'initiation et la découverte, pour la seule raison
 * qu'elle commence par un B.
 *
 * Conséquence heureuse : les deux pages affichent enfin les stages dans le même
 * ordre, ce qui rend la comparaison possible.
 *
 * Un stage que le contenu ne décrit pas passe à la fin, où il se remarque —
 * c'est un stage à décrire, pas un stage à cacher.
 */
const rangDansLeContenu = (base: string) => {
  const i = descriptions.findIndex((d) => base === d.name || base.startsWith(d.name));
  return i === -1 ? Number.MAX_SAFE_INTEGER : i;
};
familles.sort(
  (a, b) => rangDansLeContenu(a.base) - rangDansLeContenu(b.base) || a.base.localeCompare(b.base),
);

/**
 * Le tarif d'une formule, son prix et sa durée appariés : « 70 € pour 5 h ».
 *
 * Deux fourchettes côte à côte — « 70 € – 95 € » puis « 5 h – 7 h » — obligeaient
 * à deviner laquelle allait avec laquelle. Rien n'y disait que la moins chère
 * était la plus courte : c'est vrai ici, ce n'est pas une loi.
 */
const prixEtDuree = (c: Formule) =>
  c.heures
    ? `${euros(c.default_unit_price_cents)} € pour ${c.heures}`
    : `${euros(c.default_unit_price_cents)} €`;

const stagesGroupes = familles.map((f) => {
  const prix = f.formules.map((c) => c.default_unit_price_cents);
  const heures = f.formules.map((c) => c.heures).filter(Boolean) as string[];
  // Lieu et nombre de places ne remontent en tête que s'ils valent pour toutes
  // les formules. Sinon chacune porte les siens : mieux vaut le répéter que
  // laisser croire qu'un stage se tient là où il ne se tient pas.
  const lieux = new Set(f.formules.map((c) => c.default_location));
  const places = new Set(f.formules.map((c) => c.default_capacity));
  return {
    ...f,
    // La description est celle du stage, pas de la formule : c'est le même stage.
    description: f.formules[0].description,
    audience: f.formules[0].audience,
    // Une seule formule : le prix en couleur, la durée en gris à côté — il n'y a
    // rien à apparier. Plusieurs : chaque prix porte sa durée, d'un bloc.
    tarifPrincipal: f.formules.length > 1
      ? enumerer(f.formules.map(prixEtDuree))
      : `${euros(prix[0])} €`,
    tarifSecondaire: f.formules.length > 1 ? null : (heures[0] ?? null),
    lieuCommun: lieux.size === 1 ? f.formules[0].default_location : null,
    placesCommunes: places.size === 1 ? f.formules[0].default_capacity : null,
  };
});
---

<BaseLayout title={`${page.title} — aperçu`} description={page.seoDescription}
            ogImage={ogImage} noIndex={true}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schemas).replace(/<\//g, '<\\/')} />
  </Fragment>

  <Hero title={page.title} subtitle={page.subtitle}
        coverImage={couverture ?? undefined} altText={page.coverImageAlt ?? undefined} />


  {page.introduction && (
    <IntroSection text={page.introduction} cta={false} />
  )}

  {avecDates.length === 0 ? (
    <section class="py-16 md:py-20">
      <div class="mx-auto max-w-3xl px-4">
        <div class="rounded-xl bg-[var(--color-bg-accent)] p-5">
          <CalendrierCreneau seances={[]} erreur={Boolean(error)}
                             vide="Aucun stage programmé pour l’instant." />
        </div>
      </div>
    </section>
  ) : (
    <Fragment>
      <section class="bg-[var(--color-bg-accent)] py-16 md:py-20">
        <div class="mx-auto max-w-4xl px-4">
          <h2 class="mb-10 text-center text-2xl md:text-3xl font-bold text-[var(--color-heading)]">
            {page.stagesSectionTitle}
          </h2>
          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3">
            {stagesGroupes.map((f) => (
              <DetailCard
                name={f.base}
                anchorId={toSlug(f.base)}
                primaryBadge={f.tarifPrincipal}
                secondaryBadge={f.tarifSecondaire ?? undefined}
                details={[
                  f.description?.shortDescription,
                  f.formules.length > 1
                    ? `${f.formules.length} formules${f.lieuCommun ? ` · ${f.lieuCommun}` : ''}`
                    : `${formule(f.formules[0].seances_par_stage)}${f.lieuCommun ? ` · ${f.lieuCommun}` : ''}`,
                ].filter((l): l is string => Boolean(l))}
              />
            ))}
          </div>
        </div>
      </section>

      <section class="py-16 md:py-20">
        <div class="mx-auto max-w-3xl space-y-8 px-4">
          {/*
            Le même conteneur que sur les deux autres pages : carte blanche,
            calendriers dans leurs encadrés à l'intérieur. Une seule colonne ici,
            contrairement aux ateliers — un stage porte deux paragraphes de
            description, qui ne se lisent pas sur une demi-largeur.
          */}
          {stagesGroupes.map((f) => (
            <div
              id={toSlug(f.base)}
              class="scroll-mt-24 rounded-xl bg-white p-5 shadow-md md:p-6 dark:bg-[var(--color-card-bg)]"
            >
              {/*
                LE PRIX SEUL DANS LE TITRE. « 70 € — 5 h » y mêlait le montant et
                la durée par un tiret qui ne disait pas leur rapport, tandis que
                la ligne suivante annonçait « Stage en 2 séances » : trois
                caractéristiques éparpillées sur deux niveaux.

                La durée rejoint donc les autres faits descriptifs, et le titre
                ne porte plus que le chiffre qui décide. Un stage à plusieurs
                formules garde son appariement — « 70 € pour 5 h ou 95 € pour
                7 h » — parce que là, prix et durée vont vraiment par paires.
              */}
              <h2 class="mb-2 text-xl md:text-2xl font-bold text-[var(--color-heading)]">
                {f.base}
                <span class="ml-2 text-base font-medium text-[var(--color-button)]">
                  {f.tarifPrincipal}
                </span>
              </h2>
              <p class="mb-4 text-sm text-[var(--color-text-light)]">
                {f.formules.length > 1
                  ? `${f.formules.length} formules au choix`
                  : formule(f.formules[0].seances_par_stage)}
                {f.tarifSecondaire && ` · ${f.tarifSecondaire}`}
                {f.lieuCommun && ` · ${f.lieuCommun}`}
                {f.placesCommunes && ` · ${f.placesCommunes} places`}
                {f.audience === 'enfants' && ' · enfants'}
              </p>

              {/*
                Le prérequis en note marquée, non en italique perdu entre deux
                paragraphes. C'est la seule ligne qui peut faire renoncer — ou
                rassurer : « recommandée » n'est pas « exigée », et il vaut mieux
                le lire avant la description que le découvrir après.

                Il vaut pour le stage entier, comme la description : les répéter
                sous chaque formule les ferait passer pour des différences entre
                elles.
              */}
              {f.description?.prerequisite && (
                <p class="mb-4 border-l-4 border-[var(--color-button)] py-1 pl-4 text-sm text-[var(--color-text)]">
                  <span class="font-semibold text-[var(--color-heading)]">Prérequis</span>
                  {' — '}{f.description.prerequisite}
                </p>
              )}
              {f.description?.fullDescription && (
                <div class="prose">
                  {splitParagraphs(f.description.fullDescription).map((para) => <p>{para}</p>)}
                </div>
              )}

              <div class="mt-4 space-y-4">
                {f.formules.map((c) => (
                  <div class="rounded-xl bg-[var(--color-bg-accent)] p-4">
                    {/*
                      L'en-tête d'une formule ne s'affiche que s'il y en a
                      plusieurs. Sur un stage à formule unique, « Formule
                      complète » ferait chercher l'autre.
                    */}
                    {f.formules.length > 1 ? (
                      <p class="mb-2 text-sm font-semibold text-[var(--color-heading)]">
                        {c.variante
                          ? c.variante.charAt(0).toUpperCase() + c.variante.slice(1)
                          : 'Autre formule'}
                        <span class="ml-2 font-medium text-[var(--color-button)]">
                          {euros(c.default_unit_price_cents)} €
                        </span>
                        <span class="ml-2 font-normal text-[var(--color-text-light)]">
                          {c.heures && `${c.heures} · `}{formule(c.seances_par_stage).toLowerCase()}
                          {!f.lieuCommun && ` · ${c.default_location}`}
                          {!f.placesCommunes && ` · ${c.default_capacity} places`}
                        </span>
                      </p>
                    ) : (
                      <p class="mb-2 text-sm font-semibold text-[var(--color-heading)]">
                        {c.seances_par_stage > 1 ? 'Dates du stage' : page.datesLabel}
                      </p>
                    )}
                    <CalendrierCreneau seances={c.aVenir} erreur={Boolean(error)} />
                  </div>
                ))}
              </div>

              <ContactCTA label={page.ctaLabel} />
            </div>
          ))}
        </div>
      </section>
    </Fragment>
  )}

  <FaqSection title={page.faqSectionTitle} items={faqAJour} ctaLabel={page.ctaLabel} />

  {page.crossLinksText && (
    <CrossLinksSection text={page.crossLinksText} excludeHref="/stages-thematiques/" />
  )}
</BaseLayout>
