---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Hero from '../../components/Hero.astro';
import BlogCard from '../../components/BlogCard.astro';
import ContactCTA from '../../components/ContactCTA.astro';
import { getPageContext, reader } from '../../utils/reader';
import { renderMarkdoc } from '../../utils/markdoc-components';
import { resolveImage } from '../../utils/images';
import { formatFrenchDate } from '../../utils/strings';
import { filterPublishedPosts, pickRelatedPosts } from '../../utils/blog';
import { buildBreadcrumbSchema, buildFaqSchema, buildHowToSchema } from '../../utils/schema';
import FaqSection from '../../components/FaqSection.astro';

export async function getStaticPaths() {
  const posts = await reader.collections.blog.all();
  return filterPublishedPosts(posts).map((post) => ({
    params: { slug: post.slug },
  }));
}

const { slug } = Astro.params;
const post = await reader.collections.blog.read(slug!, { resolveLinkedFiles: true });
if (!post) return Astro.redirect('/blog/');

// SECURITY: Markdoc HTML is rendered with set:html (no sanitisation).
// This is safe because content is authored by a single trusted editor via Keystatic.
// If adding untrusted editors, add sanitisation (e.g. sanitize-html) here.
const renderedContent = renderMarkdoc(post.content.node);
const { settings, siteUrl } = await getPageContext(Astro.site);

const formattedDate = post.publishDate ? formatFrenchDate(post.publishDate) : '';

/*
 * LES DEUX DOSSIERS OÙ PEUT VIVRE LA COUVERTURE D'UN ARTICLE.
 *
 * Le champ Keystatic écrit dans `src/assets/images/blog/`, ce motif ne lisait
 * que `covers/` : une image déposée depuis le CMS n'était jamais retrouvée.
 * `resolveImage` renvoyait null, et null ne casse rien — pas de balise `<img>`,
 * pas d'`image` dans le schéma Article, l'og:image qui retombe sur celle par
 * défaut. L'avertissement, lui, n'existe qu'en développement. On pouvait donc
 * téléverser vingt-deux couvertures et n'en voir aucune, sans un message.
 */
const coverGlob = import.meta.glob<{ default: ImageMetadata }>([
  '/src/assets/images/covers/**/*.{jpg,jpeg,png,webp}',
  '/src/assets/images/blog/**/*.{jpg,jpeg,png,webp}',
]);
const resolvedCover = await resolveImage(post.coverImage, coverGlob);
const ogImage = resolvedCover ? new URL(resolvedCover.src, Astro.site).toString() : undefined;

const blogIndex = await reader.singletons.blogIndex.read();
const authorName = settings?.authorName ?? 'L\'Atelier des Cousettes';
const dateModified = post.lastModified || post.publishDate;

// Related articles: chronological cycle so every post receives inbound links
// evenly (see pickRelatedPosts) — "most recent 3" starved older posts of
// internal links and Google left them unindexed.
const allPosts = await reader.collections.blog.all();
const relatedPosts = pickRelatedPosts(slug!, filterPublishedPosts(allPosts));

/*
 * CE QU'UN MOTEUR DE RÉPONSE SAIT EXTRAIRE DE CET ARTICLE.
 *
 * Les deux schémas ne paraissent que remplis, et c'est délibéré : un FAQPage
 * sans question ou un HowTo sans étape promet à Google une page qu'il ne
 * trouvera pas, ce qu'il traite comme du balisage trompeur. Les vingt-deux
 * articles partent donc sans, et chacun gagne le sien le jour où quelqu'un
 * écrit les questions — le champ est là, vide, dans le CMS.
 *
 * La FAQ n'est PAS un ajout invisible : ce qui est balisé est affiché, à la
 * suite de l'article. C'est la condition posée par Google, et de toute façon la
 * seule qui vaille — des questions que personne ne lit ne valent pas d'être
 * écrites.
 */
const pageUrl = new URL(Astro.url.pathname, Astro.site).toString();
const faqItems = post.faqItems ?? [];
const faqSchema = buildFaqSchema(faqItems);
const howToSchema = buildHowToSchema({
  name: post.title,
  description: post.seoDescription ?? '',
  pageUrl,
  steps: post.howToSteps ?? [],
  duree: post.howToDuree,
  fournitures: post.howToFournitures,
  image: ogImage,
});
---

<BaseLayout title={post.seoTitle || post.title} description={post.seoDescription} ogImage={ogImage} ogType="article" articlePublishedTime={post.publishDate ?? undefined} articleAuthor={authorName} appendSiteName={false}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify([
      buildBreadcrumbSchema([
        { name: 'Accueil', url: siteUrl },
        { name: 'Blog couture', url: `${siteUrl}/blog/` },
        { name: post.title },
      ]),
      {
        "@context": "https://schema.org",
        "@type": "Article",
        "headline": post.title,
        "description": post.seoDescription,
        "url": new URL(Astro.url.pathname, Astro.site).toString(),
        "datePublished": post.publishDate,
        "dateModified": dateModified,
        "author": {
          "@type": "Person",
          "name": authorName,
          "jobTitle": settings?.authorJobTitle,
          "url": `${siteUrl}/la-couturiere/`
        },
        "publisher": {
          "@type": "Organization",
          "name": settings?.siteName,
          "url": siteUrl
        },
        "isPartOf": { "@id": `${siteUrl}/#website` },
        ...(ogImage ? { "image": ogImage } : {})
      },
      ...(faqSchema ? [faqSchema] : []),
      ...(howToSchema ? [howToSchema] : []),
    ]).replace(/<\//g, '<\\/')} />
  </Fragment>

  <!-- 1. Hero -->
  <Hero title={post.title} coverImage={resolvedCover ?? undefined} altText={post.coverImageAlt || undefined} />

  <!-- 2. Article content -->
  <section class="py-16 md:py-20">
    <div class="max-w-3xl mx-auto px-4">
      {formattedDate && (
        <div class="flex items-center gap-2 text-sm text-[var(--color-text-light)] mb-8">
          <time datetime={post.publishDate ?? ''}>{formattedDate}</time>
          <span>&middot;</span>
          <span>Par {authorName}</span>
        </div>
      )}

      <div class="prose overflow-visible">
        <Fragment set:html={renderedContent} />
      </div>
    </div>
  </section>

  <!-- 3. FAQ de l'article (affichée seulement si l'article en porte une) -->
  <FaqSection title={blogIndex?.faqSectionTitle} items={faqItems} cta={false} />

  <!-- 4. Related articles -->
  {relatedPosts.length > 0 && (
    <section class="py-16 md:py-20">
      <div class="max-w-4xl mx-auto px-4">
        <h2 class="text-2xl md:text-3xl font-bold text-[var(--color-heading)] text-center mb-8">
          {blogIndex?.relatedTitle}
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
          {relatedPosts.map((related) => (
            <BlogCard
              title={related.entry.title}
              slug={related.slug}
              publishDate={related.entry.publishDate}
              description={related.entry.seoDescription ?? ''}
              readMoreLabel={blogIndex?.readMoreLabel ?? ''}
            />
          ))}
        </div>
      </div>
    </section>
  )}

  <!-- 5. CTA + Back to blog -->
  <section class="bg-[var(--color-bg-accent)] py-16 md:py-20">
    <div class="max-w-3xl mx-auto px-4 text-center">
      {blogIndex?.ctaText && (
        <p class="text-base md:text-lg leading-relaxed text-[var(--color-text)] mb-2">{blogIndex.ctaText}</p>
      )}
      <ContactCTA label={blogIndex?.ctaLabel} />
      <a href="/blog/" class="mt-6 inline-block text-sm font-semibold text-[var(--color-link)] hover:text-[var(--color-button)] transition-colors">
        &larr; {blogIndex?.backToListLabel}
      </a>
    </div>
  </section>
</BaseLayout>
