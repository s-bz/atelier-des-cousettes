---
export const prerender = false;

import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import AvisProvisoire from '../components/AvisProvisoire.astro';
import CrossLinksSection from '../components/CrossLinksSection.astro';
import CalendrierCreneau from '../components/CalendrierCreneau.astro';
import ContactCTA from '../components/ContactCTA.astro';
import FaqSection from '../components/FaqSection.astro';
import { getPageContext, reader } from '../utils/reader';
import { resolveImage, resolveImageUrl } from '../utils/images';
import { splitParagraphs, toSlug } from '../utils/strings';
import { buildServicePageSchemas } from '../utils/schema';
import { getAdminClient } from '../utils/supabase';

/**
 * Une séance sans engagement : ses dates lues en base.
 *
 * LA PAGE S'APPELAIT « Un après-midi couture » et listait pourtant près de la
 * moitié de ses séances le matin ou en fin de journée. Elle a été renommée ; son
 * adresse, elle, ne bouge pas — onze articles, l'accueil et le menu y renvoient,
 * et une URL est une adresse, pas une promesse.
 *
 * CETTE FORMULE N'A PAS DE CRÉNEAU PROPRE, et n'en a pas besoin : venir une
 * fois, c'est prendre une place dans un atelier existant. Ses dates sont donc
 * exactement celles des ateliers réguliers, et son prix est celui d'une séance
 * hors forfait — 45 € pour un adulte, 35 € pour un enfant. C'est le même
 * montant, parce que c'est la même chose : une séance que rien ne couvre.
 *
 * Les dates sont présentées CHRONOLOGIQUEMENT et non par créneau : celui qui
 * vient une fois cherche « quand puis-je venir », pas « quel atelier suivre ».
 * Le nom de l'atelier reste sur chaque ligne, faute de quoi « jeudi 8 octobre »
 * ne dirait pas où se rendre.
 *
 * Adultes et enfants sont séparés : les durées diffèrent — 3 h contre 2 h — les
 * prix aussi, et surtout on ne s'inscrit pas dans le mauvais groupe.
 *
 * AUCUN REPLI sur les dates du contenu : elles seraient périmées dès la première
 * séance déplacée, et afficher une date qui n'existe plus ferait se déplacer
 * quelqu'un pour rien. En cas de panne, on le dit et on invite à revenir.
 *
 * Tout le reste — l'introduction, le bloc d'informations, la description, la
 * liste « pour qui », la FAQ, les liens croisés, le JSON-LD — est rendu comme
 * attendu d'une page de formule.
 */

const page = await reader.singletons.apresMidiCouture.read();
if (!page) throw new Error('Contenu de l’après-midi couture introuvable');

const { settings, siteUrl } = await getPageContext(Astro.site);

const coverGlob = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/covers/**/*.{jpg,jpeg,png,webp}');
const couverture = await resolveImage(page.coverImage, coverGlob);
const ogImage = await resolveImageUrl(page.coverImage, coverGlob, Astro.site);

const faqItems = page.faqItems ?? [];



const audienceItems = page.audienceItems ?? [];



const supabase = getAdminClient();

const { data: seances, error } = await supabase
  .from('sessions')
  .select(`
    starts_at, ends_at, capacity, places_attente, status,
    bookings(status),
    creneaux!inner(label, audience, default_location, kind, archived_at)
  `)
  .eq('status', 'scheduled')
  .eq('creneaux.kind', 'atelier')
  .is('creneaux.archived_at', null)
  .gt('starts_at', new Date().toISOString())
  .order('starts_at')
  .limit(120);

const aplati = ((seances ?? []) as any[]).map((s) => ({
  starts_at: s.starts_at,
  ends_at: s.ends_at,
  capacity: s.capacity,
  places_attente: s.places_attente,
  bookings: s.bookings,
  lieu: s.creneaux?.default_location ?? null,
  audience: s.creneaux?.audience ?? 'adultes',
}));

/**
 * Les créneaux d'atelier — d'eux viennent les LIEUX, les publics, les tarifs et
 * les horaires.
 *
 * Et non des séances : un lieu dont aucune date n'est encore programmée
 * disparaîtrait alors de la page, alors que c'est précisément là qu'il faut
 * inviter à écrire. Verdalle est dans ce cas aujourd'hui — le créneau existe,
 * son calendrier est vide.
 *
 * Le prix vient de la base et non du contenu : c'est le même champ qui sert à
 * facturer une séance hors forfait, et deux endroits pour un seul montant
 * finiraient par se contredire.
 */
const { data: creneauxAtelier } = await supabase
  .from('creneaux')
  .select('audience, default_location, default_unit_price_cents, default_start_time, default_end_time')
  .eq('kind', 'atelier')
  .is('archived_at', null);

const euros = (cents: number) => (cents / 100).toFixed(0);

/** « 3 h », « 2 h 30 » — lu sur les horaires du créneau, non recopié à la main. */
const duree = (debut: string, fin: string) => {
  const min = (t: string) => Number(t.slice(0, 2)) * 60 + Number(t.slice(3, 5));
  const m = min(fin) - min(debut);
  return m <= 0 ? null : m % 60 === 0 ? `${m / 60} h` : `${Math.floor(m / 60)} h ${m % 60}`;
};

const PUBLICS = [
  { cle: 'adultes', titre: 'Adultes' },
  { cle: 'enfants', titre: 'Enfants' },
];

/**
 * Un lieu, et pour chacun de ses publics ses dates.
 *
 * Segmenter par lieu d'abord : c'est ce qui décide si l'on peut venir. Un tarif
 * se compare, une date se choisit, mais un village à trente minutes de route ne
 * se découvre pas au dernier moment.
 *
 * Le nom de l'atelier ne figure plus sur les lignes. « Atelier du samedi
 * après-midi » sous « Samedi 12 septembre 2026 · 14:00 – 17:00 » ne disait rien
 * que la date et l'heure ne disaient déjà, et doublait la hauteur de chacune des
 * 59 lignes — sur un téléphone, la liste en devenait illisible.
 */
/**
 * Le tarif et la durée de chaque public, pour les pastilles de tête.
 *
 * Elles annonçaient « 40 € » et « 3h » depuis le contenu : le prix d'avant
 * l'adhésion comprise, et la durée des seuls adultes. Un enfant venu pour deux
 * heures à 35 € ne se reconnaissait dans aucun des deux chiffres.
 *
 * Une pastille par public plutôt qu'une seule : ils n'ont ni le même prix ni la
 * même durée, et une moyenne n'aurait décrit personne.
 */
const parPublic = PUBLICS.map(({ cle, titre }) => {
  const cs = (creneauxAtelier ?? []).filter((c) => c.audience === cle);
  if (cs.length === 0) return null;
  const durees = [...new Set(cs.map((c) => duree(c.default_start_time, c.default_end_time)).filter(Boolean))];
  return { titre, prix: euros(cs[0].default_unit_price_cents), duree: durees.join(' ou ') };
}).filter((p): p is NonNullable<typeof p> => p !== null);

/**
 * Les offres du schéma viennent des tarifs en base, non du contenu.
 *
 * Celles du CMS annonçaient encore « Après-midi couture (3h) » à 40 € : le nom
 * d'avant et le prix d'avant, tandis que la page affiche 45 € et 35 €. C'est ce
 * que Google lit ; le champ a donc été retiré du contenu plutôt que corrigé,
 * pour qu'il n'ait plus l'occasion de dériver.
 */
const schemas = buildServicePageSchemas({
  title: page.title,
  seoDescription: page.seoDescription,
  pageUrl: new URL(Astro.url.pathname, Astro.site).toString(),
  siteUrl,
  settings,
  offers: parPublic.map((p) => ({
    name: `Séance sans engagement — ${p.titre.toLowerCase()}`,
    price: p.prix,
  })),
  faqItems: faqItems,
});

const lieux = [...new Set((creneauxAtelier ?? []).map((c) => c.default_location))]
  .map((lieu) => {
    const publics = PUBLICS.map(({ cle, titre }) => {
      const cs = (creneauxAtelier ?? []).filter(
        (c) => c.default_location === lieu && c.audience === cle,
      );
      if (cs.length === 0) return null;
      const durees = [...new Set(cs.map((c) => duree(c.default_start_time, c.default_end_time)).filter(Boolean))];
      return {
        cle, titre,
        prix: euros(cs[0].default_unit_price_cents),
        duree: durees.length === 1 ? durees[0] : durees.join(' ou '),
        // Le lieu est retiré des lignes : il titre déjà la section qui les porte.
        items: aplati
          .filter((s) => s.lieu === lieu && s.audience === cle)
          .map(({ lieu: _, ...reste }) => reste),
      };
    }).filter((p): p is NonNullable<typeof p> => p !== null);
    return { lieu, publics, total: publics.reduce((n, p) => n + p.items.length, 0) };
  })
  // Le lieu le plus fourni d'abord : c'est là que la plupart des gens iront.
  // Un tri sur le nombre de dates se corrige tout seul si l'équilibre change,
  // là où un ordre écrit en dur resterait faux.
  .sort((a, b) => b.total - a.total || a.lieu.localeCompare(b.lieu));

---

<BaseLayout title={page.title} description={page.seoDescription}
            ogImage={ogImage}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schemas).replace(/<\//g, '<\\/')} />
  </Fragment>

  <AvisProvisoire texte={settings?.avisProvisoire} />

  {/* `flush` : la marge basse du héros doublait celle de l'introduction. */}
  <Hero flush title={page.title} subtitle={page.subtitle}
        coverImage={couverture ?? undefined} altText={page.coverImageAlt ?? undefined} />


  {page.introduction && (
    <section class="bg-[var(--color-bg-accent)] pt-12 pb-10 md:pt-16 md:pb-12">
      <div class="mx-auto max-w-3xl px-4 text-center">
        <p class="text-base md:text-lg leading-relaxed text-[var(--color-text)]">
          {page.introduction}
        </p>
        {(parPublic.length > 0 || page.location) && (
          <div class="mt-8 flex flex-wrap justify-center gap-4">
            {parPublic.map((p) => (
              <div class="rounded-xl bg-[var(--color-bg-accent)] px-5 py-3 text-center">
                <p class="heading-font text-2xl font-bold text-[var(--color-button)]">{p.prix} €</p>
                <p class="text-xs text-[var(--color-text-light)]">
                  {page.priceLabel}, {p.titre.toLowerCase()}{p.duree && ` (${p.duree})`}
                </p>
              </div>
            ))}
            {page.location && (
              <div class="rounded-xl bg-[var(--color-bg-accent)] px-5 py-3 text-center">
                <p class="heading-font text-2xl font-bold text-[var(--color-heading)]">{page.location}</p>
                {page.locationLabel && (
                  <p class="text-xs text-[var(--color-text-light)]">{page.locationLabel}</p>
                )}
              </div>
            )}
          </div>
        )}
        {/*
          LES DATES EN PREMIER, ET EN BOUTON. Sur cette page, ce sont elles qui
          décident : qui ne peut se libérer aucun de ces jours n'écrira pas, et
          lui proposer d'abord d'écrire lui fait franchir une étape qu'il devra
          défaire. Les tarifs et le lieu se lisent au-dessus ; les dates sont
          trois écrans plus bas.

          Le contact passe en lien, sans disparaître : celui qui a une question
          plutôt qu'une date à choisir le trouve encore.
        */}
        {/*
          DEUX BOUTONS, ET AUCUN QUI DEMANDE D'ÉCRIRE. Les deux questions de qui
          arrive ici sont « quand ? » et « comment ça se passe ? » — écrire vient
          après, et la page l'offre cinq fois plus bas, au pied de chaque lieu et
          dans la FAQ. Le proposer ici faisait franchir une étape avant d'avoir
          de quoi la décider.

          Le plein pour les dates, le contour pour le déroulement : à l'œil, l'un
          est l'action, l'autre le complément.
        */}
        <div class="mt-8 mb-8 flex flex-wrap justify-center gap-3 not-prose">
          <a
            href="#dates"
            class="inline-block rounded-[var(--radius-button)] bg-[var(--color-button)] px-8 py-3 text-sm font-medium text-white no-underline transition-all hover:scale-[1.02] hover:bg-[var(--color-button-hover)]"
          >
            {page.lienDates}
          </a>
          <a
            href="#deroulement"
            class="inline-block rounded-[var(--radius-button)] border-2 border-[var(--color-button)] px-8 py-3 text-sm font-medium text-[var(--color-button)] no-underline transition-colors hover:bg-[var(--color-button)] hover:text-white"
          >
            {page.lienDeroulement}
          </a>
        </div>
      </div>
    </section>
  )}

  {(page.description || audienceItems.length > 0) && (
    <section id="deroulement" class="scroll-mt-24 py-16 md:py-20">
      <div class="mx-auto max-w-3xl px-4">
        {page.description && (
          <div class="mb-12">
            {page.descriptionTitle && (
              <h2 class="mb-6 text-center text-2xl md:text-3xl font-bold text-[var(--color-heading)]">
                {page.descriptionTitle}
              </h2>
            )}
            <div class="prose max-w-none">
              {splitParagraphs(page.description).map((para) => <p>{para}</p>)}
            </div>
          </div>
        )}
        {audienceItems.length > 0 && (
          <div>
            {page.audienceTitle && (
              <h2 class="mb-6 text-center text-2xl md:text-3xl font-bold text-[var(--color-heading)]">
                {page.audienceTitle}
              </h2>
            )}
            <ul class="space-y-3">
              {audienceItems.map((item) => (
                <li class="flex items-baseline gap-3">
                  <span class="text-sm text-[var(--color-button)]">&#10003;</span>
                  <span class="text-[var(--color-text)]">{item}</span>
                </li>
              ))}
            </ul>
          </div>
        )}
      </div>
    </section>
  )}

  <section id="dates" class="scroll-mt-24 bg-[var(--color-bg-accent)] py-16 md:py-20">
    <div class="mx-auto max-w-4xl px-4">
      {page.datesTitle && (
        <h2 class="mb-2 text-center text-2xl md:text-3xl font-bold text-[var(--color-heading)]">
          {page.datesTitle}
        </h2>
      )}
      <p class="mb-8 text-center text-sm text-[var(--color-text-light)]">
        Venir une fois, c’est prendre une place dans un atelier existant : toutes les dates
        ci-dessous sont ouvertes, dans la limite des places libres.
      </p>

      {error ? (
        <div class="rounded-xl bg-[var(--color-bg-accent)] p-4">
          <CalendrierCreneau seances={[]} erreur={true} />
        </div>
      ) : lieux.length === 0 ? (
        <div class="rounded-xl bg-[var(--color-bg-accent)] p-4">
          <CalendrierCreneau seances={[]} />
        </div>
      ) : (
        <Fragment>
          {/*
            Les mêmes pastilles que sur la page des ateliers. Deux lieux
            seulement ici, mais celui qui ne peut pas se rendre à Verdalle a
            autant besoin de sauter la section que sur l'autre page — et deux
            pages qui présentent les mêmes dates n'ont pas à se naviguer
            différemment.

            Elles ne s'affichent qu'à partir de deux lieux : une pastille unique
            ne mènerait qu'à ce qu'on a déjà sous les yeux.
          */}
          {lieux.length > 1 && (
            <nav class="mb-12 flex flex-wrap justify-center gap-3">
              {lieux.map((l) => (
                <a
                  href={`#${toSlug(l.lieu)}`}
                  class="inline-block rounded-[var(--radius-button)] border-2 border-[var(--color-button)] px-5 py-2 text-sm font-medium text-[var(--color-button)] transition-colors hover:bg-[var(--color-button)] hover:text-white"
                >
                  {l.lieu}
                </a>
              ))}
            </nav>
          )}

        <div class="space-y-12">
          {lieux.map((l) => (
            <div id={toSlug(l.lieu)} class="scroll-mt-24">
              <h3 class="mb-6 text-xl md:text-2xl font-bold text-[var(--color-heading)]">
                {l.lieu}
              </h3>
              {/*
                Même gabarit que la page des ateliers : une carte blanche par
                bloc, le calendrier dans son encadré à l'intérieur, deux colonnes
                au plus. Les deux pages montrent la même chose — des dates
                groupées — et les présenter différemment obligeait à réapprendre
                la lecture en passant de l'une à l'autre.
              */}
              <div class="grid grid-cols-1 gap-6 md:grid-cols-2">
                {l.publics.map((p) => (
                  <div class="rounded-xl bg-white p-5 shadow-md dark:bg-[var(--color-card-bg)]">
                    <h4 class="mb-1 text-lg font-bold text-[var(--color-heading)]">
                      {p.titre}
                      {p.prix && (
                        <span class="ml-2 text-base font-medium text-[var(--color-button)]">
                          {p.prix} € la séance
                        </span>
                      )}
                    </h4>
                    <p class="mb-3 text-sm text-[var(--color-text-light)]">
                      {p.duree} d’accompagnement
                      {p.items.length > 0 &&
                        ` · ${p.items.length} date${p.items.length > 1 ? 's' : ''} à venir`}
                    </p>
                    <div class="rounded-xl bg-[var(--color-bg-accent)] p-4">
{/*
                        SIX DATES ICI, contre trois sur la page des ateliers.
                        Là-bas une carte ne montre qu'un créneau, et l'on sait
                        déjà quel jour on cherche ; ici la liste mêle tous les
                        ateliers d'un lieu, et trois dates ne couvraient parfois
                        qu'une quinzaine. Six laissent voir un mois, de quoi
                        juger si l'on peut se libérer.

                        Le reste se replie : cette page déroulait 59 dates pour
                        les adultes et 35 pour les enfants.
                      */}
                      <CalendrierCreneau seances={p.items} limite={6} />
                    </div>
                  </div>
                ))}
              </div>

              {/*
                Un bouton par lieu, au pied de ses cartes. Celui qui vient à
                Revel n'a plus à traverser Verdalle pour trouver de quoi écrire
                — même parti que sur la page des ateliers.
              */}
              <ContactCTA label={page.ctaLabel} />
            </div>
          ))}
        </div>
        </Fragment>
      )}

      {page.datesNote && (
        <p class="mt-4 text-center text-sm italic text-[var(--color-text-light)]">
          {page.datesNote}
        </p>
      )}
    </div>
  </section>

  <FaqSection title={page.faqSectionTitle} items={faqItems} ctaLabel={page.ctaLabel} fond={false} />

  {page.crossLinksText && (
    <CrossLinksSection text={page.crossLinksText} excludeHref="/seances-sans-engagement/" class="bg-[var(--color-bg-accent)]" />
  )}
</BaseLayout>
