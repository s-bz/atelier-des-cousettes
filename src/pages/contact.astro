---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Temoignages from '../components/Temoignages.astro';
import { getPageContext, reader } from '../utils/reader';
import { resolveImage, resolveImageUrl } from '../utils/images';
import { buildPageSchemas } from '../utils/schema';
import { splitParagraphs } from '../utils/strings';
import { lienWhatsApp } from '../utils/contact';

const page = await reader.singletons.contact.read();
if (!page) throw new Error('Contact content not found');

const { settings, siteUrl } = await getPageContext(Astro.site);

/*
 * LE POINT LE PLUS ÉTROIT DU SITE ÉTAIT LE MOINS ÉQUIPÉ.
 *
 * Tous les boutons du site aboutissent ici, et cette page n'offrait qu'une
 * iframe : pas un numéro, pas un avis, pas un délai. Or c'est le moment où
 * l'on hésite le plus — on s'apprête à écrire à quelqu'un qu'on ne connaît
 * pas, sans savoir quand ni si l'on obtiendra une réponse. Les trois choses
 * qui manquaient existaient déjà ailleurs sur le site.
 *
 * LE NUMÉRO N'EST PAS UN SECOND BOUTON qui disputerait le premier. Il est sous
 * le formulaire, pour qui ne veut pas écrire — une partie du public de
 * l'atelier appelle plutôt qu'elle ne tape.
 */
const mobile = settings?.phones?.[0];
const telHref = mobile ? `tel:${mobile.replace(/[-.\s]/g, '')}` : null;
const whatsapp = lienWhatsApp(settings?.whatsappNumber ?? mobile);

const schemas = buildPageSchemas({
  title: page.title,
  seoDescription: page.seoDescription,
  pageUrl: new URL(Astro.url.pathname, Astro.site).toString(),
  siteUrl,
  settings,
});

// Les témoignages, désormais sous le formulaire, portent le fond chaud : les
// informations pratiques qui les suivent s'en passent donc, pour que deux
// sections de même teinte ne se touchent pas.
const contactSections = page.sections ?? [];

const coverGlob = import.meta.glob<{ default: ImageMetadata }>('/src/assets/images/covers/**/*.{jpg,jpeg,png,webp}');
const resolvedCover = await resolveImage(page.coverImage, coverGlob);
const ogImage = await resolveImageUrl(page.coverImage, coverGlob, Astro.site);
---

<BaseLayout title={page.title} description={page.seoDescription} ogImage={ogImage}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(schemas).replace(/<\//g, '<\\/')} />
  </Fragment>

  <!-- 1. Hero -->
  <Hero title={page.title} subtitle={page.subtitle} coverImage={resolvedCover ?? undefined} altText={page.coverImageAlt ?? undefined} />

  <!-- 2. Introduction -->
  {page.introduction && (
    <section class="py-16 md:py-20">
      <div class="max-w-3xl mx-auto px-4 text-center">
        {splitParagraphs(page.introduction).map((para) => (
          <p class="text-lg leading-relaxed mb-4">{para}</p>
        ))}
      </div>
    </section>
  )}

  <!-- 3. Tally embedded form -->
  <section class="py-16 md:py-20">
    <div class="max-w-3xl mx-auto px-4">
      {/*
        LE DÉLAI DE RÉPONSE, JUSTE AU-DESSUS DU FORMULAIRE.

        « Nous vous répondrons dans les meilleurs délais » ne promet rien : il
        n'existe aucun envoi dont on puisse dire après coup qu'il a manqué à
        cette phrase. Une durée écrite, elle, est une promesse — et c'est la
        seule chose qu'attend celui qui hésite à cliquer sur « Envoyer ».
      */}
      {page.delaiReponse?.trim() && (
        <p class="mx-auto mb-8 max-w-xl rounded-xl bg-[var(--color-bg-accent)] px-5 py-4 text-center text-sm leading-relaxed text-[var(--color-text)]">
          {page.delaiReponse}
        </p>
      )}

      <iframe
        id="tally-formulaire"
        data-tally-src="https://tally.so/embed/wvGxVA?hideTitle=1&transparentBackground=1&dynamicHeight=1&formEventsForwarding=1"
        loading="lazy"
        width="100%"
        height="571"
        frameborder="0"
        marginheight="0"
        marginwidth="0"
        title="Demande d'informations"
      ></iframe>

      {/*
        LA SORTIE DE SECOURS DE CELUI QUI N'ÉCRIRA PAS.

        Elle est sous le formulaire et non au-dessus : proposée en premier, elle
        détournerait ceux que le formulaire n'arrêtait pas. Sous lui, elle ne
        récupère que ceux qui allaient partir.

        Elle survit à une iframe qui ne charge pas — le seul contenu de cette
        page venait d'un tiers, et une panne chez Tally n'y laissait rien du
        tout.
      */}
      {telHref && mobile && (
        <p class="mt-8 text-center text-sm text-[var(--color-text)]">
          {page.alternativeTexte?.trim() || 'Vous préférez parler de vive voix ?'}{' '}
          <a href={telHref} class="font-medium text-[var(--color-button)]">
            {mobile}
          </a>
          {whatsapp && (
            <Fragment>
              {' — '}
              <a href={whatsapp} class="font-medium text-[var(--color-button)]">
                aussi sur WhatsApp
              </a>
            </Fragment>
          )}
        </p>
      )}
    </div>
  </section>

  {/*
    4. Ce que disent les élèves — SOUS le formulaire.

    La note Google est vérifiable d'un clic, et c'est ce qui la distingue de tout
    ce que nous écririons nous-mêmes sur notre propre page : elle vaut d'être
    montrée où qu'elle soit.

    Elle était au-dessus du formulaire, au motif qu'une preuve lue après la
    décision ne rassure plus personne. Elle passe dessous sur demande — et l'un
    des deux placements se mesure : si le taux d'envoi du formulaire ne bouge
    pas, c'est que l'ordre n'était pas ce qui retenait les visiteurs.
  */}
  <Temoignages page="contact" fond />

  <!-- 5. Informations pratiques -->
  {contactSections.map((section, i) => (
    <section class={i % 2 === 0 ? 'py-16 md:py-20' : 'bg-[var(--color-bg-accent)] py-16 md:py-20'}>
      <div class="max-w-4xl mx-auto px-4">
        <h2 class="text-2xl md:text-3xl font-bold text-[var(--color-heading)] text-center mb-8">
          {section.title}
        </h2>
        <div class="prose max-w-3xl mx-auto">
          {section.text && splitParagraphs(section.text).map((para) => (
            <p>{para}</p>
          ))}
        </div>
      </div>
    </section>
  ))}
</BaseLayout>

{/*
  L'ORIGINE ENTRE DANS L'ADRESSE DU FORMULAIRE, AVANT QUE TALLY NE LA LISE.

  Ce script précède celui qui charge Tally, et c'est la seule chose qui compte
  dans son ordre : `Tally.loadEmbeds()` recopie `data-tally-src` dans `src` sans
  jamais y revenir. L'attribut modifié après coup ne serait plus regardé.

  La page est statique — elle ne peut donc pas lire le paramètre à la
  construction, il n'existe qu'au moment du clic. D'où ce détour par le
  navigateur plutôt qu'un rendu à la demande pour un seul mot.

  Le champ `origine` doit exister côté Tally, en champ caché du même nom. S'il
  manque, le paramètre est simplement ignoré : la page ne casse pas, et
  l'origine reste lisible dans PostHog par le script du dessous.
*/}
<script is:inline>
  (function () {
    var cadre = document.getElementById('tally-formulaire');
    if (!cadre) return;
    var origine = new URLSearchParams(location.search).get('origine');
    // La même forme stricte que côté serveur : cette valeur retourne dans une URL.
    if (!origine || !/^[a-z0-9-]{1,64}$/.test(origine)) return;
    cadre.dataset.tallySrc += '&origine=' + origine;
  })();
</script>

<script is:inline>
  var d=document,w="https://tally.so/widgets/embed.js",v=function(){"undefined"!=typeof Tally?Tally.loadEmbeds():d.querySelectorAll("iframe[data-tally-src]:not([src])").forEach((function(e){e.src=e.dataset.tallySrc}))};if("undefined"!=typeof Tally)v();else if(d.querySelector('script[src="'+w+'"]')==null){var s=d.createElement("script");s.src=w,s.onload=v,s.onerror=v,d.body.appendChild(s);}
</script>

{/*
  CE QUE LE FORMULAIRE RACONTE, ENFIN ÉCOUTÉ.

  `formEventsForwarding=1` était dans l'adresse de l'iframe depuis le début :
  Tally publiait déjà ses événements à la page qui l'héberge, et personne ne
  s'était abonné. On savait donc combien de gens VOYAIENT le formulaire — la
  page est mesurée comme les autres — mais rien de ce qu'ils en faisaient.

  Les trois événements suffisent à faire un entonnoir : affiché → parcouru →
  envoyé. `origine` accompagne les trois, si bien qu'on lit non seulement
  combien de demandes arrivent, mais depuis quelle page — ce qui est la seule
  façon de savoir si un bouton sert.

  ON VÉRIFIE `origin` AVANT DE FAIRE CONFIANCE AU MESSAGE. N'importe quelle
  iframe, n'importe quel onglet peut poster à cette fenêtre ; sans ce contrôle,
  la mesure serait à la portée du premier venu.
*/}
<script is:inline>
  (function () {
    var origine = new URLSearchParams(location.search).get('origine');
    if (origine && !/^[a-z0-9-]{1,64}$/.test(origine)) origine = null;

    var noms = {
      'Tally.FormLoaded': 'formulaire_affiche',
      'Tally.FormPageView': 'formulaire_page_vue',
      'Tally.FormSubmitted': 'formulaire_envoye',
    };

    window.addEventListener('message', function (e) {
      if (e.origin !== 'https://tally.so') return;
      if (typeof e.data !== 'string') return;

      var message;
      try {
        message = JSON.parse(e.data);
      } catch (err) {
        return;
      }

      var nom = message && message.event && noms[message.event];
      if (!nom) return;

      // PostHog est absent en développement sans clé, et peut avoir été refusé.
      if (typeof window.posthog === 'undefined') return;

      var charge = message.payload || {};
      window.posthog.capture(nom, {
        origine: origine || 'inconnue',
        formulaire: charge.formId,
        // Seul `FormPageView` porte un numéro de page ; ailleurs il est absent.
        page: charge.page,
      });
    });
  })();
</script>
