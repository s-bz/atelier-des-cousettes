---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '@vercel/analytics/astro';
import '../styles/global.css';

// Mesure d'audience PostHog. Le préfixe PUBLIC_ est nécessaire ici — contrairement
// aux clés Supabase — parce que ce script s'exécute dans le navigateur. Une clé de
// projet PostHog est conçue pour être publique ; elle n'ouvre aucun accès en lecture.
const posthogKey = import.meta.env.PUBLIC_POSTHOG_KEY;
const posthogHost = import.meta.env.PUBLIC_POSTHOG_HOST ?? 'https://eu.i.posthog.com';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  noIndex?: boolean;
  ogType?: 'website' | 'article';
  articlePublishedTime?: string;
  articleAuthor?: string;
}

const { title, description = "Cours de couture, ateliers et stages dans le Tarn — L'Atelier des Cousettes à Revel et Verdalle", ogImage, noIndex = false, ogType = 'website', articlePublishedTime, articleAuthor } = Astro.props;
const pathname = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonicalURL = new URL(pathname, Astro.site);
const fullTitle = title === "L'Atelier des Cousettes" ? title : `${title} | L'Atelier des Cousettes`;
const resolvedOgImage = ogImage || new URL('/og-default.jpg', Astro.site).toString();
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="description" content={description} />
    <meta name="robots" content={noIndex ? 'noindex, follow' : 'index, follow'} />

    <!-- Preconnect hints -->
    <link rel="preconnect" href="https://img.youtube.com" />
    <link rel="dns-prefetch" href="https://img.youtube.com" />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="L'Atelier des Cousettes" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {articlePublishedTime && <meta property="article:published_time" content={articlePublishedTime} />}
    {articleAuthor && <meta property="article:author" content={articleAuthor} />}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />

    <title>{fullTitle}</title>
    <slot name="head" />

    <script async src="https://tally.so/widgets/embed.js"></script>

    {/*
      PostHog, cloud UE, sans cookie.

      `persistence: 'memory'` supprime tout stockage persistant : aucun cookie,
      rien dans localStorage. Sans cookie ni identifiant durable, la mesure
      d'audience n'exige pas de bandeau de consentement — ce qui évite d'en
      construire un, et rend la politique de confidentialité exacte.

      Le compromis est réel et assumé, et plus fort qu'il n'y paraît : sur un
      site multi-pages, la mémoire est vidée à chaque navigation, donc CHAQUE
      page vue repart d'un identifiant neuf. Le nombre de pages vues reste
      juste — c'est ce qu'on veut savoir — mais toute métrique de « visiteurs
      uniques » est dénuée de sens et ne doit pas être lue. Distinguer les
      visiteurs ne vaut pas un bandeau que personne ne veut voir.

      `person_profiles: 'identified_only'` est la conséquence indispensable de
      ce choix : sans lui, PostHog créerait un profil de personne par page vue,
      soit des milliers de profils fantômes qui gonfleraient la facturation
      pour rien. Personne n'étant jamais identifié ici, aucun profil n'est créé.

      L'enregistrement de session est coupé : il capterait le contenu saisi
      dans l'espace membre.

      Le bloc ne s'affiche que si la clé est définie, pour que rien ne casse
      tant que le projet PostHog n'existe pas.
    */}
    {posthogKey && (
      <script is:inline define:vars={{ posthogKey, posthogHost }}>
        !function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.crossOrigin="anonymous",p.async=!0,p.src=s.api_host.replace(".i.posthog.com","-assets.i.posthog.com")+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],u.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},u.people.toString=function(){return u.toString(1)+".people (stub)"},o="init capture register register_once register_for_session unregister unregister_for_session getFeatureFlag getFeatureFlagPayload isFeatureEnabled reloadFeatureFlags updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures on onFeatureFlags onSessionId getSurveys getActiveMatchingSurveys renderSurvey canRenderSurvey getNextSurveyStep identify setPersonProperties group resetGroups setPersonPropertiesForFlags resetPersonPropertiesForFlags setGroupPropertiesForFlags resetGroupPropertiesForFlags reset get_distinct_id getGroups get_session_id get_session_replay_url alias set_config startSessionRecording stopSessionRecording sessionRecordingStarted captureException loadToolbar get_property getSessionProperty createPersonProfile opt_in_capturing opt_out_capturing has_opted_in_capturing has_opted_out_capturing clear_opt_in_out_capturing debug getPageViewId captureTraceFeedback captureTraceMetric".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);
        posthog.init(posthogKey, {
          api_host: posthogHost,
          persistence: 'memory',
          person_profiles: 'identified_only',
          disable_session_recording: true,
          autocapture: false,
        });
      </script>
    )}

    <Analytics />
  </head>
  <body class="min-h-screen flex flex-col">
    <Header />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer />

    <!-- Floating contact button (links to /contact, upgraded to Tally popup if script loads) -->
    <a
      href="/contact/"
      data-tally-fallback
      aria-label="Nous contacter"
      class="floating-contact-btn fixed bottom-6 right-6 z-50 flex items-center gap-2 px-5 py-3 rounded-[var(--radius-button)] bg-[var(--color-button)] text-white font-medium text-sm shadow-lg transition-all hover:bg-[var(--color-button-hover)] hover:scale-105 hover:shadow-xl no-underline"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
      </svg>
      <span class="hidden sm:inline">Nous contacter</span>
    </a>

    <!-- Upgrade contact links to Tally popups if script loaded -->
    <script is:inline>
      (function() {
        if (typeof Tally === 'undefined') return;
        var els = document.querySelectorAll('[data-tally-fallback]');
        for (var i = 0; i < els.length; i++) {
          var el = els[i];
          el.setAttribute('data-tally-open', 'wvGxVA');
          el.setAttribute('data-tally-align-left', '1');
          el.setAttribute('data-tally-hide-title', '1');
          el.setAttribute('data-tally-overlay', '1');
          el.setAttribute('data-tally-emoji-text', '🧵');
          el.setAttribute('data-tally-emoji-animation', 'wave');
          el.setAttribute('data-tally-auto-close', '2000');
          el.removeAttribute('href');
          el.removeAttribute('data-tally-fallback');
          el.style.cursor = 'pointer';
        }
        Tally.loadEmbeds();
      })();
    </script>

    <!-- Markdoc YouTube embed: click-to-play -->
    <script>
      document.addEventListener('click', (e) => {
        const container = (e.target as HTMLElement).closest('.markdoc-youtube');
        if (!container) return;
        const videoId = container.getAttribute('data-video-id');
        if (!videoId) return;
        const iframe = document.createElement('iframe');
        iframe.src = `https://www.youtube-nocookie.com/embed/${encodeURIComponent(videoId)}?autoplay=1`;
        iframe.title = 'YouTube video';
        iframe.setAttribute('frameborder', '0');
        iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
        iframe.allowFullscreen = true;
        container.replaceChildren(iframe);
      });
    </script>
  </body>
</html>
