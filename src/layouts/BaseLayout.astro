---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Analytics from '@vercel/analytics/astro';
import { lienContact } from '../utils/origine';
import '../styles/global.css';

// Mesure d'audience PostHog. Le préfixe PUBLIC_ est nécessaire ici — contrairement
// aux clés Supabase — parce que ce script s'exécute dans le navigateur. Une clé de
// projet PostHog est conçue pour être publique ; elle n'ouvre aucun accès en lecture.
const posthogKey = import.meta.env.PUBLIC_POSTHOG_KEY;
const posthogHost = import.meta.env.PUBLIC_POSTHOG_HOST ?? 'https://eu.i.posthog.com';

/*
 * QUI EST CONNECTÉ, POUR LE DIRE À LA MESURE.
 *
 * `Astro.locals` n'est renseigné que sur /espace-membre/ — le middleware sort
 * avant pour tout le reste — et les pages publiques sont prérendues, où il vaut
 * null au moment du build. Aucune adresse ne peut donc se retrouver figée dans
 * une page publique : le rendu qui en porte une est toujours un rendu à la
 * demande, pour la personne concernée.
 */
const membreEmail = Astro.locals.account?.email ?? null;
const membreRole = Astro.locals.account?.role ?? null;

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  noIndex?: boolean;
  ogType?: 'website' | 'article';
  articlePublishedTime?: string;
  articleAuthor?: string;
  /**
   * Le suffixe « | L'Atelier des Cousettes » derrière le titre. Vrai par défaut.
   *
   * IL COÛTE VINGT-SIX CARACTÈRES, sur les soixante que Google affiche. Les
   * pages du site ont des titres courts et s'en accommodent ; les articles du
   * blog, non — vingt et un des vingt-deux dépassaient la limite, et c'était
   * chaque fois la fin du titre qui tombait, celle qui dit de quoi l'article
   * parle. « Coudre une trousse à fermeture éclair (20 cm) : tutoriel… »
   *
   * Le supprimer ne perd pas la marque : Google affiche le nom du site à part,
   * sous l'adresse, et l'ajoute de lui-même au titre quand il le juge utile.
   * On ne le répète donc que là où la place ne manque pas.
   */
  appendSiteName?: boolean;
}

const { title, description = "Cours de couture, ateliers et stages dans le Tarn — L'Atelier des Cousettes à Revel et Verdalle", ogImage, noIndex = false, ogType = 'website', articlePublishedTime, articleAuthor, appendSiteName = true } = Astro.props;
const pathname = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
const canonicalURL = new URL(pathname, Astro.site);
const fullTitle = !appendSiteName || title === "L'Atelier des Cousettes" ? title : `${title} | L'Atelier des Cousettes`;
const resolvedOgImage = ogImage || new URL('/og-default.jpg', Astro.site).toString();
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.ico" sizes="32x32" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={canonicalURL} />
    <meta name="description" content={description} />
    <meta name="robots" content={noIndex ? 'noindex, follow' : 'index, follow'} />

    <!-- Preconnect hints -->
    <link rel="preconnect" href="https://img.youtube.com" />
    <link rel="dns-prefetch" href="https://img.youtube.com" />

    <!-- Open Graph -->
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="L'Atelier des Cousettes" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:locale" content="fr_FR" />
    <meta property="og:image" content={resolvedOgImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    {articlePublishedTime && <meta property="article:published_time" content={articlePublishedTime} />}
    {articleAuthor && <meta property="article:author" content={articleAuthor} />}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={resolvedOgImage} />

    <title>{fullTitle}</title>
    <slot name="head" />

    <script async src="https://tally.so/widgets/embed.js"></script>

    {/*
      PostHog, cloud UE.

      LE SITE DÉPOSE UN COOKIE DE MESURE, ET IDENTIFIE L'ADHÉRENT CONNECTÉ.
      Ce n'était pas le cas : la mesure tournait en `cookieless_mode`, sans rien
      écrire sur l'appareil, ce qui la dispensait de bandeau de consentement mais
      lui interdisait `identify()` — un adhérent connecté était indistinguable
      d'un visiteur de passage, et le parcours « je découvre, je paie, je réserve
      mes dates » se lisait en trois morceaux sans lien entre eux.

      Le cookie tient un an, plafond que la CNIL fixe à treize mois.

      LA CONTREPARTIE EST ASSUMÉE, ET ELLE EST JURIDIQUE : mesure d'audience avec
      cookie ET rapprochement avec un compte, cela sort de l'exemption de
      consentement. Aucun bandeau n'est affiché — c'est une décision de
      l'association, pas un oubli. La politique de confidentialité décrit ce qui
      est réellement déposé, sans prétendre que le consentement ne serait pas dû.

      L'enregistrement de session reste coupé, et la capture automatique aussi :
      l'un filmerait ce qui se saisit dans l'espace adhérent, l'autre remonterait
      le texte des boutons — dont des noms de participants. Ce qui est mesuré est
      donc uniquement ce que ce fichier et les pages nomment explicitement.

      Le bloc ne s'affiche que si la clé est définie, pour que rien ne casse
      tant que le projet PostHog n'existe pas.
    */}
    {posthogKey && (
      <script is:inline define:vars={{ posthogKey, posthogHost, membreEmail, membreRole }}>
        !function(t,e){var o,n,p,r;e.__SV||(window.posthog=e,e._i=[],e.init=function(i,s,a){function g(t,e){var o=e.split(".");2==o.length&&(t=t[o[0]],e=o[1]),t[e]=function(){t.push([e].concat(Array.prototype.slice.call(arguments,0)))}}(p=t.createElement("script")).type="text/javascript",p.crossOrigin="anonymous",p.async=!0,p.src=s.api_host.replace(".i.posthog.com","-assets.i.posthog.com")+"/static/array.js",(r=t.getElementsByTagName("script")[0]).parentNode.insertBefore(p,r);var u=e;for(void 0!==a?u=e[a]=[]:a="posthog",u.people=u.people||[],u.toString=function(t){var e="posthog";return"posthog"!==a&&(e+="."+a),t||(e+=" (stub)"),e},u.people.toString=function(){return u.toString(1)+".people (stub)"},o="init capture register register_once register_for_session unregister unregister_for_session getFeatureFlag getFeatureFlagPayload isFeatureEnabled reloadFeatureFlags updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures on onFeatureFlags onSessionId getSurveys getActiveMatchingSurveys renderSurvey canRenderSurvey getNextSurveyStep identify setPersonProperties group resetGroups setPersonPropertiesForFlags resetPersonPropertiesForFlags setGroupPropertiesForFlags resetGroupPropertiesForFlags reset get_distinct_id getGroups get_session_id get_session_replay_url alias set_config startSessionRecording stopSessionRecording sessionRecordingStarted captureException loadToolbar get_property getSessionProperty createPersonProfile opt_in_capturing opt_out_capturing has_opted_in_capturing has_opted_out_capturing clear_opt_in_out_capturing debug getPageViewId captureTraceFeedback captureTraceMetric".split(" "),n=0;n<o.length;n++)g(u,o[n]);e._i.push([i,s,a])},e.__SV=1)}(document,window.posthog||[]);
        posthog.init(posthogKey, {
          api_host: posthogHost,
          defaults: '2026-01-30',
          // Un an, sous le plafond de treize mois. Au-delà, un visiteur revenu
          // après deux saisons serait compté comme le même — ce qu'il n'est
          // plus vraiment — et la durée cesserait d'être défendable.
          cookie_expiration: 365,
          // `defaults` vaut ici `person_profiles: 'identified_only'` : un
          // visiteur anonyme est compté sans qu'une fiche naisse à son nom.
          // Seules les personnes identifiées ci-dessous en ont une.
          disable_session_recording: true,
          autocapture: false,
        });

        /*
         * LA DÉCONNEXION EFFACE L'IDENTITÉ, ET ELLE SEULE.
         *
         * Sans cela, l'ordinateur familial attribuerait à la mère les pages lues
         * ensuite par la fille. `reset()` n'a pas sa place ailleurs : appelé sur
         * chaque page anonyme, il redonnerait un identifiant neuf à chaque
         * chargement et rendrait tout comptage de visiteurs absurde.
         *
         * Le paramètre vient de /espace-membre/deconnexion/, qui redirige ici.
         */
        if (new URLSearchParams(location.search).get('deconnecte') === '1') {
          posthog.reset();
        }

        /*
         * L'ADHÉRENT CONNECTÉ SE NOMME, ET C'EST SON ADRESSE QUI LE NOMME.
         *
         * Le serveur a déjà résolu la session ; la page ne fait que reprendre
         * ce qu'il en dit. L'adresse sert d'identifiant plutôt que l'UUID du
         * compte parce que la moitié du parcours se joue AVANT le compte : une
         * famille achète sans être connue, et le serveur ne dispose alors que
         * de son adresse. Les deux moitiés se rejoignent sur cette clé.
         */
        if (membreEmail) {
          posthog.identify(membreEmail, { email: membreEmail, role: membreRole });
        }
      </script>
    )}

    <Analytics />
  </head>
  <body class="min-h-screen flex flex-col">
    <Header />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer />

    <!-- Floating contact button (links to /contact, upgraded to Tally popup if script loads) -->
    <a
      href={lienContact(pathname)}
      data-tally-fallback
      aria-label="Nous contacter"
      class="floating-contact-btn fixed bottom-6 right-6 z-50 flex items-center gap-2 px-5 py-3 rounded-[var(--radius-button)] bg-[var(--color-button)] text-white font-medium text-sm shadow-lg transition-all hover:bg-[var(--color-button-hover)] hover:scale-105 hover:shadow-xl no-underline"
    >
      <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
      </svg>
      <span class="hidden sm:inline">Nous contacter</span>
    </a>

    <!-- Upgrade contact links to Tally popups if script loaded -->
    <script is:inline>
      (function() {
        if (typeof Tally === 'undefined') return;
        var els = document.querySelectorAll('[data-tally-fallback]');
        for (var i = 0; i < els.length; i++) {
          var el = els[i];
          el.setAttribute('data-tally-open', 'wvGxVA');
          el.setAttribute('data-tally-align-left', '1');
          el.setAttribute('data-tally-hide-title', '1');
          el.setAttribute('data-tally-overlay', '1');
          el.setAttribute('data-tally-emoji-text', '🧵');
          el.setAttribute('data-tally-emoji-animation', 'wave');
          el.setAttribute('data-tally-auto-close', '2000');
          el.removeAttribute('href');
          el.removeAttribute('data-tally-fallback');
          el.style.cursor = 'pointer';
        }
        Tally.loadEmbeds();
      })();
    </script>

    <!-- Markdoc YouTube embed: click-to-play -->
    <script>
      document.addEventListener('click', (e) => {
        const container = (e.target as HTMLElement).closest('.markdoc-youtube');
        if (!container) return;
        const videoId = container.getAttribute('data-video-id');
        if (!videoId) return;
        const iframe = document.createElement('iframe');
        iframe.src = `https://www.youtube-nocookie.com/embed/${encodeURIComponent(videoId)}?autoplay=1`;
        iframe.title = 'YouTube video';
        iframe.setAttribute('frameborder', '0');
        iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
        iframe.allowFullscreen = true;
        container.replaceChildren(iframe);
      });
    </script>

    {/*
      LES DÉPARTS VERS L'ACHAT.

      L'autocapture est coupée : sans elle, plus rien ne relie « a lu la page
      des ateliers » à « a ouvert le formulaire d'inscription », et le premier
      décrochage du parcours — de loin le plus gros — est invisible. Plutôt que
      de rallumer une capture qui remonterait le texte de tous les boutons, y
      compris les noms de participants de l'espace adhérent, on ne nomme que
      les liens qui mènent à un achat.

      Un écouteur délégué sur le document : les liens sont nombreux, dispersés
      dans une douzaine de composants, et aucun n'a à savoir qu'il est mesuré.
    */}
    <script is:inline>
      (function () {
        var VERS_ACHAT = /^\/(ateliers-reguliers|espace-membre)\/inscription\/$|^\/(stages-thematiques|seances-sans-engagement)\/reserver\/$/;

        document.addEventListener('click', function (e) {
          if (typeof window.posthog === 'undefined') return;
          if (!e.target || !e.target.closest) return;

          /*
           * LE BOUTON FLOTTANT OUVRE UN FORMULAIRE, PAS UNE PAGE. Tally
           * l'intercepte et retire le `href` ; sans ce cas, le seul geste de
           * contact visible depuis n'importe quelle page ne serait mesuré nulle
           * part. Les événements du formulaire lui-même viennent de /contact/.
           */
          var tally = e.target.closest('[data-tally-open], [data-tally-fallback]');
          if (tally) {
            window.posthog.capture('contact_ouvert', { depuis: location.pathname });
            return;
          }

          var lien = e.target.closest('a[href]');
          if (!lien) return;

          var brut = lien.getAttribute('href') || '';

          /*
           * APPELER, ÉCRIRE, ENVOYER UN MESSAGE : trois conversions qui quittent
           * le site sans laisser la moindre trace. Une page vue de plus ne dit
           * pas qu'on a décroché son téléphone.
           */
          var direct = brut.slice(0, 7).toLowerCase();
          if (direct.indexOf('tel:') === 0 || direct.indexOf('mailto:') === 0) {
            window.posthog.capture('contact_direct', {
              moyen: direct.indexOf('tel:') === 0 ? 'telephone' : 'courriel',
              depuis: location.pathname,
            });
            return;
          }

          var url;
          try {
            url = new URL(brut, location.href);
          } catch (err) {
            return;
          }

          if (url.hostname === 'wa.me' || url.hostname === 'api.whatsapp.com') {
            window.posthog.capture('contact_direct', {
              moyen: 'whatsapp',
              depuis: location.pathname,
            });
            return;
          }

          if (url.origin !== location.origin) return;
          if (!VERS_ACHAT.test(url.pathname)) return;

          window.posthog.capture('depart_vers_achat', {
            destination: url.pathname,
            depuis: location.pathname,
            // Le libellé du lien, borné : « Réserver ma place » et « S'inscrire »
            // ne se valent pas, et savoir lequel décide vaut la peine. Les
            // liens visés sont publics, aucun ne porte de nom de personne.
            libelle: (lien.textContent || '').trim().slice(0, 60),
          });
        });
      })();
    </script>
  </body>
</html>
