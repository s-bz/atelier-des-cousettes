---
interface Props {
  name: string;
  /**
   * L'adresse de la carte — une vraie page, non une ancre.
   *
   * Ces cartes ont d'abord pointé vers un `#identifiant` plus bas sur la même
   * page : les six stages y tenaient leur description l'un sous l'autre, et
   * cliquer ne faisait que descendre. Chaque stage ayant sa page, elles portent
   * une URL, et le clic mène quelque part.
   */
  href: string;
  /** Primary badge (price, highlighted colour) */
  primaryBadge: string;
  /** Secondary badge (duration, time, muted colour) */
  secondaryBadge?: string;
  /** Description lines shown below the name */
  details?: string[];
  /** Optional italic note */
  note?: string;
  /**
   * Le libellé d'un bouton visible en pied de carte.
   *
   * RENDU EN <span>, ET NON EN <a> : la carte entière est déjà un lien, et
   * imbriquer une ancre dans une ancre est invalide — les navigateurs la
   * remontent d'un cran, ce qui casse silencieusement la carte. Le pointeur et
   * le clic viennent du lien qui l'entoure ; ce bouton ne fait que le dire.
   */
  actionLabel?: string;
}

const { name, href, primaryBadge, secondaryBadge, details = [], note, actionLabel } = Astro.props;
---

<a href={href} class="detail-card group flex flex-col rounded-xl bg-white dark:bg-[var(--color-card-bg)] overflow-hidden transition-all p-5 h-full" aria-label={name}>
  <h3 class="text-lg font-semibold text-[var(--color-heading)]">
    {name}
  </h3>
  {(details.length > 0 || note) && (
    <div class="mt-2 flex-1 space-y-1 text-sm text-[var(--color-text)]">
      {details.map((line) => (
        <p>{line}</p>
      ))}
      {note && <p class="italic text-[var(--color-text-light)]">{note}</p>}
    </div>
  )}
  <div class="mt-3 flex items-center gap-3 text-sm font-medium">
    <span class="text-[var(--color-button)]">{primaryBadge}</span>
    {secondaryBadge && <span class="text-[var(--color-text-light)]">{secondaryBadge}</span>}
  </div>
  {actionLabel && (
    <span class="mt-4 inline-block self-start rounded-[var(--radius-button)] border-2 border-[var(--color-button)] px-5 py-2 text-sm font-medium text-[var(--color-button)] transition-colors group-hover:bg-[var(--color-button)] group-hover:text-white">
      {actionLabel}
    </span>
  )}
</a>

<style>
  .detail-card {
    box-shadow: var(--shadow-ring), var(--shadow-whisper);
    transition: box-shadow 0.2s ease, transform 0.2s ease;
  }
  .detail-card:hover {
    box-shadow: var(--shadow-ring), 0 4px 12px rgba(0, 0, 0, 0.1);
    transform: translateY(-2px);
  }
</style>
