---
import ContactCTA from './ContactCTA.astro';
import { splitParagraphs } from '../utils/strings';

interface Props {
  title?: string;
  items: readonly { readonly question: string; readonly answer: string }[];
  ctaLabel?: string;
  /** Fond chaud. Vrai par défaut ; à mettre à faux pour respecter l'alternance. */
  fond?: boolean;
  /**
   * Le bouton de contact sous les questions. Vrai par défaut — c'est la fin
   * d'une page de formule, et l'endroit où l'on écrit. Faux sur un article de
   * blog, qui porte déjà le sien plus bas : deux boutons à trois paragraphes
   * d'écart ne se lisent pas comme une insistance mais comme un doublon.
   */
  cta?: boolean;
}

const { title, items, ctaLabel, fond = true, cta = true } = Astro.props;
---

{items.length > 0 && (
  <section class={`py-16 md:py-20 ${fond ? 'bg-[var(--color-bg-accent)]' : ''}`}>
    <div class="max-w-3xl mx-auto px-4">
      <h2 class="text-2xl md:text-3xl font-bold text-[var(--color-heading)] text-center mb-10">
        {title}
      </h2>
      <div class="space-y-6">
        {items.map((item) => (
          <div>
            <h3 class="faq-question text-lg font-semibold text-[var(--color-heading)]">
              {item.question}
            </h3>
            {/*
              `faq-answer` n'est pas décorative : le schéma FAQPage déclare
              `speakable` sur `.faq-question` et `.faq-answer`, et la seconde
              classe ne figurait sur aucun élément. Le sélecteur ne désignait
              donc rien — un assistant vocal ne trouvait que les questions.
            */}
            {/*
              PLUSIEURS PARAGRAPHES, quand la réponse en compte.
              Le gabarit rendait tout dans un seul `<p>` : une réponse écrite en
              deux temps — ce qu'on fait en 1 h 30, puis ce qu'on fait en 3 h —
              se recollait en un bloc, les retours à la ligne ne valant rien en
              HTML. Une réponse d'un seul paragraphe rend exactement comme
              avant, un `<p>` unique.

              `faq-answer` PASSE SUR LE CONTENEUR, et c'est délibéré : le
              schéma FAQPage déclare `speakable` sur cette classe. La laisser
              sur le premier paragraphe seul ferait lire la moitié d'une réponse
              par un assistant vocal.
            */}
            <div class="faq-answer mt-2 text-[var(--color-text)] leading-relaxed">
              {splitParagraphs(item.answer).map((para) => (
                <p class="mt-3 first:mt-0">{para}</p>
              ))}
            </div>
          </div>
        ))}
      </div>
      {cta && <ContactCTA label={ctaLabel} telephone />}
    </div>
  </section>
)}
