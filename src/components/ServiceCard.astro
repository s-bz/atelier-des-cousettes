---
import { Image } from 'astro:assets';

interface Props {
  label: string;
  href: string;
  resolvedImage?: ImageMetadata;
  imageAlt: string;
  priceRange?: string;
  shortDescription?: string;
}

const { label, href, resolvedImage, imageAlt, priceRange, shortDescription } = Astro.props;
const safeHref = href?.startsWith('/') ? href : '#';
---

{/*
  COLONNE FLEXIBLE, et non plus un simple bloc.
  La description n'est plus tronquée (voir plus bas) : les trois cartes ont donc
  des textes de longueurs différentes. Sans cette colonne, le prix se collait
  sous le texte et les trois pastilles se retrouvaient à trois hauteurs. Il est
  maintenant poussé en bas de carte, aligné d'une carte à l'autre.
*/}
<a href={safeHref} class="service-card group flex flex-col rounded-xl bg-white dark:bg-[var(--color-card-bg)] overflow-hidden transition-all" aria-label={label}>
  {resolvedImage && (
    <Image
      src={resolvedImage}
      alt={imageAlt || label}
      class="w-full h-48 sm:h-56 object-cover group-hover:opacity-90 transition-opacity"
      format="webp"
      quality={80}
      widths={[320, 480, 640]}
      sizes="(max-width: 640px) 100vw, 33vw"
    />
  )}
  <div class="flex flex-1 flex-col p-4">
    <h3 class="text-lg font-semibold text-[var(--color-heading)]">
      {label}
    </h3>
    {/*
      PLUS DE `line-clamp-2`. La coupe à deux lignes gardait les cartes bien
      carrées tant que les descriptions tenaient en deux lignes ; passé cette
      longueur elle escamotait la fin sans le dire. La mention « Nouveau cette
      saison : une séance courte d'1 h 30 » a été écrite pour être lue, et ne
      l'était jamais — une carte qui tronque le seul argument neuf de la saison
      n'est pas plus courte, elle est muette.
    */}
    {shortDescription && (
      <p class="mt-1 text-sm text-[var(--color-text)]">{shortDescription}</p>
    )}
    {priceRange && (
      <span class="mt-auto pt-3 self-start text-sm font-medium text-[var(--color-button)]">
        {priceRange}
      </span>
    )}
  </div>
</a>

<style>
  .service-card {
    box-shadow: var(--shadow-ring), var(--shadow-whisper);
  }
  .service-card:hover {
    box-shadow: var(--shadow-ring), 0 4px 12px rgba(0, 0, 0, 0.1);
    transform: translateY(-2px);
  }
</style>
