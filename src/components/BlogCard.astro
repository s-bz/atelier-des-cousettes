---
import { Image } from 'astro:assets';
import { formatFrenchDate } from '../utils/strings';

interface Props {
  title: string;
  slug: string;
  publishDate: string;
  description: string;
  readMoreLabel: string;
  coverImage?: ImageMetadata;
  /*
   * Le texte alternatif de la couverture — celui de l'article, pas son titre.
   *
   * Vide plutôt que faux : le lien porte déjà `aria-label={title}`, qui donne
   * son nom accessible à la carte entière. Une image sans alt propre est donc
   * décorative ici, et `alt=""` est ce qui le dit correctement. Y recopier le
   * titre ferait annoncer deux fois la même phrase par un lecteur d'écran, et
   * décrirait l'article là où l'attribut doit décrire l'image.
   */
  coverImageAlt?: string;
}

const { title, slug, publishDate, description, readMoreLabel, coverImage, coverImageAlt } = Astro.props;

const formattedDate = formatFrenchDate(publishDate);
---

<a href={`/blog/${slug}/`} class="group block overflow-hidden rounded-lg bg-white dark:bg-[var(--color-card-bg)] transition-all" style="box-shadow: var(--shadow-ring), var(--shadow-whisper);" aria-label={title}>
  {coverImage && (
    <Image
      src={coverImage}
      alt={coverImageAlt ?? ''}
      widths={[320, 480, 640]}
      sizes="(max-width: 768px) 100vw, 50vw"
      format="webp"
      quality={80}
      class="w-full h-44 md:h-48 object-cover"
    />
  )}
  <div class="p-6">
    <time datetime={publishDate} class="text-sm text-[var(--color-text-light)]">{formattedDate}</time>
    <h2 class="mt-2 text-xl font-medium leading-tight group-hover:text-[var(--color-link)] transition-colors">
      {title}
    </h2>
    {description && (
      <p class="mt-2 text-sm text-[var(--color-text)] line-clamp-2 md:line-clamp-3">{description}</p>
    )}
    <span class="mt-4 inline-block text-sm font-semibold text-[var(--color-link)] group-hover:text-[var(--color-button)] transition-colors">
      {readMoreLabel} &rarr;
    </span>
  </div>
</a>

<style>
  a.group:hover {
    box-shadow: var(--shadow-ring), var(--shadow-whisper);
  }
</style>
