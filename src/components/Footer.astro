---
import { reader } from '../utils/reader';
import { footerLinks } from '../utils/navLinks';

const settings = await reader.singletons.siteSettings.read();
// Sept liens sur deux colonnes : la première en prend quatre, pour que la
// seconde ne dépasse jamais la première en hauteur.
const navLeft = footerLinks.slice(0, 4);
const navRight = footerLinks.slice(4);

/*
 * wa.me n'accepte que des chiffres, indicatif pays compris et sans « + ».
 * Le champ Keystatic, lui, est saisi comme on écrit un numéro à la main :
 * points, espaces, 0 initial. On absorbe les deux écritures ici plutôt que
 * d'exiger un format exact d'Isabelle — une saisie « normale » ne doit pas
 * produire un lien mort.
 */
const whatsappDigits = settings?.whatsappNumber?.replace(/\D/g, '');
const whatsappUrl = whatsappDigits
  ? `https://wa.me/${whatsappDigits.startsWith('0') ? `33${whatsappDigits.slice(1)}` : whatsappDigits}`
  : null;
---

<footer class="bg-[var(--color-bg-dark)]">
  <div class="max-w-5xl mx-auto px-4 py-14 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-8 text-sm">
    <!-- Contact + Social -->
    <div>
      <h2 class="font-medium mb-3 text-[#faf9f5]">Contact</h2>
      <ul class="space-y-2 text-[var(--color-dark-text)]">
        {settings?.email && (
          <li>
            <a href={`mailto:${settings.email}`} class="hover:text-white transition-colors">
              📧 {settings.email}
            </a>
          </li>
        )}
        {settings?.phones?.map((phone) => (
          <li>
            <a href={`tel:${phone.replace(/[-.\s]/g, '')}`} class="hover:text-white transition-colors">
              📱 {phone}
            </a>
          </li>
        ))}
        {whatsappUrl && (
          <li>
            <a
              href={whatsappUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-white transition-colors inline-flex items-center gap-1.5"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51a12.8 12.8 0 0 0-.57-.01c-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.872.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 0 1-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 0 1-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884a9.82 9.82 0 0 1 6.988 2.896 9.83 9.83 0 0 1 2.893 6.994c-.003 5.45-4.437 9.886-9.885 9.886m8.413-18.297A11.82 11.82 0 0 0 12.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.88 11.88 0 0 0 5.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.82 11.82 0 0 0-3.48-8.413Z"/></svg>
              WhatsApp
            </a>
          </li>
        )}
        {settings?.facebookUrl && (
          <li>
            <a
              href={settings.facebookUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-white transition-colors inline-flex items-center gap-1.5"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
              Facebook
            </a>
          </li>
        )}
        {settings?.googleBusinessUrl && (
          <li>
            <a
              href={settings.googleBusinessUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-white transition-colors inline-flex items-center gap-1.5"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 92 92"><path d="M46 2C27.7 2 13 16.7 13 35c0 25.4 33 55 33 55s33-29.6 33-55C79 16.7 64.3 2 46 2zm0 46c-7.2 0-13-5.8-13-13s5.8-13 13-13 13 5.8 13 13-5.8 13-13 13z"/></svg>
              Google
            </a>
          </li>
        )}
        {settings?.googleReviewUrl && (
          <li>
            <a
              href={settings.googleReviewUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="hover:text-white transition-colors inline-flex items-center gap-1.5"
            >
              <svg class="w-4 h-4" fill="currentColor" viewBox="0 0 24 24"><path d="M12 17.27L18.18 21l-1.64-7.03L22 9.24l-7.19-.61L12 2 9.19 8.63 2 9.24l5.46 4.73L5.82 21z"/></svg>
              Laisser un avis
            </a>
          </li>
        )}
      </ul>
    </div>

    <!-- Navigation — split into 2 sub-columns -->
    <div class="lg:col-span-2">
      <h2 class="font-medium mb-3 text-[#faf9f5]">Navigation</h2>
      <nav aria-label="Navigation pied de page">
        <ul class="grid grid-cols-2 gap-x-8 gap-y-2 text-[var(--color-dark-text)]">
          {navLeft.map((link) => (
            <li><a href={link.href} class="hover:text-white transition-colors">{link.label}</a></li>
          ))}
          {navRight.map((link) => (
            <li><a href={link.href} class="hover:text-white transition-colors">{link.label}</a></li>
          ))}
          {/*
            L'espace adhérent est ici et non dans le menu principal : il ne
            concerne qu'une vingtaine de personnes déjà inscrites, et le placer
            en tête donnerait à un visiteur l'impression qu'il faut un compte
            pour venir coudre. En pied de page, il reste trouvable — « tout en
            bas du site » se dit au téléphone — sans encombrer la navigation.
          */}
          <li>
            <a href="/espace-membre/" class="hover:text-white transition-colors">
              Espace adhérent
            </a>
          </li>
        </ul>
      </nav>
    </div>
  </div>

  <div class="border-t border-[rgba(255,255,255,0.1)] py-4 text-center text-xs text-[var(--color-dark-text)]">
    &copy; <span id="footer-year"></span> {settings?.siteName || "L'Atelier des Cousettes"} · <a href="/mentions-legales/" class="hover:text-white transition-colors">Mentions légales</a> · <a href="/confidentialite/" class="hover:text-white transition-colors">Confidentialité</a>
  </div>

  <script>
    document.getElementById('footer-year')!.textContent = String(new Date().getFullYear());
  </script>
</footer>
