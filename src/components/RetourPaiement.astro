---
import { getAdminClient } from '../utils/supabase';
import { lireIntention } from '../utils/helloasso';
import { lireCommande, provisionner } from '../utils/provisionnement';
import { mesurer } from '../utils/mesure';

interface Props {
  /** Ce qu'on dit quand tout s'est bien passé. */
  messageCree: string;
  /** Quand la commande avait déjà été provisionnée : ce n'est pas une erreur. */
  messageDeja: string;
  /** Quand un code couvrait la totalité et qu'il n'y a rien eu à régler. */
  messageGratuit: string;
  /** Le règlement par chèque ou en espèces. Absent là où il ne peut pas arriver. */
  messageHorsLigne?: string;
  /** Ce qui préfixe les traces, pour retrouver le parcours en cause. */
  contexte: string;
}

const { messageCree, messageDeja, messageGratuit, messageHorsLigne, contexte } = Astro.props;

/*
 * LE RETOUR DU PAYEUR, SANS COMPTE.
 *
 * Cette page ne peut pas exiger de session : la famille n'en avait pas en
 * arrivant, et son compte vient tout juste d'être créé par le provisionnement.
 * Elle ne montre donc rien de personnel — seulement que le règlement est passé
 * et comment ouvrir son accès. EN PARTICULIER PAS L'ADRESSE DU PAYEUR : elle
 * n'a que `checkoutIntentId` pour savoir à qui elle parle, et ce paramètre
 * s'invente. L'afficher revenait à lire l'adresse d'autrui à qui devinait un
 * identifiant.
 *
 * Elle ne se fie pas non plus aux paramètres de l'URL, que la documentation
 * HelloAsso signale falsifiables : ils disent QUOI relire, l'API dit ce qui a
 * été payé. Et elle appelle le même `provisionner` que la notification et que
 * le retour de l'espace adhérent.
 *
 * PARTAGÉ ENTRE LES DEUX PARCOURS — le forfait d'une saison et la place à
 * l'unité — parce que tout ce qui précède est délicat et n'a aucune raison
 * d'exister en deux exemplaires : la validation de l'identifiant, la mise en
 * file d'une commande illisible, et le fait de ne jamais dire « erreur » à
 * quelqu'un qui vient de payer. Seuls les mots de la réussite diffèrent.
 */

const supabase = getAdminClient();

/*
 * L'IDENTIFIANT EST UN NOMBRE, ET RIEN D'AUTRE.
 *
 * Il part tel quel dans le chemin d'un appel authentifié à HelloAsso
 * (`/checkout-intents/${id}`), où `fetch` réduit les `..` : un identifiant
 * fantaisiste y désignerait une autre ressource de l'association. On le refuse
 * ici plutôt que de s'en remettre à la forme de l'URL.
 */
const brutIntention = Astro.url.searchParams.get('checkoutIntentId');
const idIntention = brutIntention && /^\d{1,20}$/.test(brutIntention) ? brutIntention : null;

let titre = 'Votre inscription';
let message: string | null = null;
let ennui: string | null = null;

const RATTACHEMENT_EN_COURS =
  'Votre règlement est bien enregistré. Il nous reste à finir de vous inscrire — '
  + 'Isabelle s’en occupe et vous recevrez une confirmation.';

if (Astro.url.searchParams.get('horsligne') === '1') {
  /*
   * Le chèque était déjà encaissé quand le code a été remis : il n'y a ni
   * paiement à relire ni intention à retrouver, l'inscription a été enregistrée
   * avant la redirection. Et surtout : ce n'est PAS une place offerte — le dire
   * ainsi ferait croire à la famille qu'elle n'a rien payé.
   */
  titre = 'C’est enregistré, bienvenue';
  message = messageHorsLigne ?? messageCree;
} else if (Astro.url.searchParams.get('gratuit') === '1') {
  // Le total étant nul, aucun paiement n'a eu lieu et il n'y a pas d'intention
  // à relire : l'inscription a été enregistrée avant la redirection.
  titre = 'C’est enregistré, bienvenue';
  message = messageGratuit;
} else if (!idIntention) {
  ennui = 'Nous n’avons pas retrouvé le paiement. Si vous avez été débité, écrivez-nous à '
    + 'info@atelier-des-cousettes.fr.';
} else {
  const intention = await lireIntention(idIntention);

  if (!intention.ok) {
    ennui = 'Nous n’arrivons pas à vérifier ce paiement pour l’instant. S’il a été prélevé, '
      + 'il est bien enregistré chez HelloAsso : écrivez-nous et nous le rattacherons.';
  } else {
    const commande = lireCommande(intention.valeur);

    if (!commande.ok) {
      /*
       * ON NE DIT JAMAIS « ERREUR » À QUELQU'UN QUI VIENT DE PAYER. Son
       * règlement est passé ; c'est notre rattachement qui manque. L'événement
       * est consigné pour qu'Isabelle le reprenne.
       */
      await supabase.from('helloasso_events').upsert(
        {
          cle: `Retour:${idIntention}`,
          type: 'Retour',
          identifiant: String(idIntention),
          authentifie: true,
          charge_utile: intention.valeur as never,
        },
        { onConflict: 'cle', ignoreDuplicates: true },
      );
      console.error(`[${contexte}] ${idIntention} : ${commande.erreur}`);
      /*
       * L'ÉVÉNEMENT LE PLUS IMPORTANT DE TOUT LE SITE : quelqu'un a payé et
       * n'est inscrit nulle part. Il est déjà en base, dans la file d'Isabelle
       * — mais une file ne se regarde que si l'on sait qu'elle se remplit.
       * Sans adresse : c'est justement la commande qu'on n'a pas su lire.
       */
      await mesurer('paiement_a_rattacher', null, {
        contexte,
        intention: idIntention,
        motif: commande.erreur,
      });
      ennui = RATTACHEMENT_EN_COURS;
    } else {
      const fait = await provisionner(supabase, commande.valeur);

      if (!fait.ok) {
        /*
         * MÊME TRAITEMENT POUR UNE PLACE PRISE ENTRE-TEMPS. Deux personnes
         * peuvent régler la dernière place d'un stage à la même seconde : la
         * seconde arrive ici avec un paiement valide et une séance complète.
         * On consigne, et quelqu'un tranche — une place ajoutée, ou un
         * remboursement. Aucun des deux ne se décide tout seul.
         */
        await supabase.from('helloasso_events').upsert(
          {
            cle: `Retour:${idIntention}`,
            type: 'Retour',
            identifiant: String(idIntention),
            authentifie: true,
            charge_utile: intention.valeur as never,
          },
          { onConflict: 'cle', ignoreDuplicates: true },
        );
        console.error(`[${contexte}] ${idIntention} : ${fait.erreur}`);
        // Même signal, l'adresse en plus : la commande était lisible, c'est
        // l'inscription qui n'a pas pu se faire — une place prise entre-temps,
        // le plus souvent.
        await mesurer('paiement_a_rattacher', commande.valeur.email, {
          contexte,
          intention: idIntention,
          motif: fait.erreur,
          produit: commande.valeur.produit,
        });
        ennui = RATTACHEMENT_EN_COURS;
      } else {
        titre = 'C’est réglé, bienvenue';
        message = fait.valeur.cree ? messageCree : messageDeja;
      }
    }
  }
}
---

<section class="mx-auto max-w-3xl px-4 py-16 md:py-20">
  <h1 class="text-2xl md:text-3xl font-bold" style="font-family: var(--font-heading)">{titre}</h1>

  {message && <p class="mt-4 text-[var(--color-text)]">{message}</p>}

  {ennui && (
    <p class="mt-4 rounded-xl bg-[var(--color-bg-accent)] px-4 py-3 text-[var(--color-text)]">
      {ennui}
    </p>
  )}

  {message && <slot />}

  <p class="mt-8 text-sm text-[var(--color-text-light)]">
    Une question ? <a href="mailto:info@atelier-des-cousettes.fr" class="underline">
    info@atelier-des-cousettes.fr</a>
  </p>
</section>
