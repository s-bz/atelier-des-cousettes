---
import { lienContact } from '../utils/origine';

interface Seance {
  starts_at: string;
  ends_at: string;
  capacity: number;
  places_attente: number;
  bookings: { status: string }[] | null;
  /*
   * Volontairement, RIEN d'autre que la date, l'heure et l'état.
   *
   * Ce composant a porté un temps le nom de l'atelier sur chaque ligne, puis son
   * lieu. Les deux doublaient la hauteur de chaque entrée sur un téléphone, pour
   * une information que l'entête de section dit une fois et mieux : le nom se
   * devinait déjà de la date et de l'heure, et le lieu décide si l'on peut venir
   * — il mérite un titre, pas une répétition sur soixante lignes.
   *
   * Une liste qui mêle plusieurs lieux se découpe par lieu ; elle ne s'annote pas.
   */
}

import LigneSeance from './LigneSeance.astro';

interface Props {
  seances: Seance[];
  /**
   * Nombre de dates montrées d'emblée ; les suivantes se replient.
   *
   * Vingt dates par créneau, sept créneaux : la page devenait un rouleau où
   * l'on ne trouvait plus les créneaux eux-mêmes. Les trois prochaines suffisent
   * à savoir si l'on peut venir ; les autres restent à un clic, sans JavaScript.
   */
  limite?: number;
  /**
   * L'horaire figure déjà au-dessus de la liste : ne pas le répéter sur chaque
   * date.
   *
   * N'a d'effet que si TOUTES les séances partagent le même horaire. Une seule
   * qui s'en écarte et les heures reviennent sur toutes les lignes : mieux vaut
   * une répétition qu'une personne devant une porte close à 14 h parce que
   * l'entête annonçait 14 h et que cette séance-là commençait à 10 h.
   */
  heuresEnTete?: boolean;
  /** Message affiché quand aucune date n'est programmée. */
  vide?: string;
  /** La suite de la phrase, après le lien de contact. */
  contactSuite?: string;
  /** La base n'a pas répondu. À distinguer d'un calendrier réellement vide. */
  erreur?: boolean;
  /**
   * Proposer d'écrire à Isabelle sous un calendrier vide. Vrai par défaut.
   *
   * À mettre à faux pour les messages qui ne s'adressent pas au public — une
   * anomalie de configuration, par exemple : inviter à écrire n'y répondrait à
   * rien et déplacerait le problème sur Isabelle.
   */
  contact?: boolean;
}

const {
  seances,
  /*
   * « Aucune date programmée » se lisait comme une fin de non-recevoir, et
   * c'était faux : à Verdalle les dates se calent AVEC le groupe, elles ne
   * manquent pas, elles n'existent pas encore. Dire l'un pour l'autre faisait
   * renoncer là où il fallait écrire.
   */
  vide = 'Les dates de ce créneau se fixent avec le groupe.',
  erreur = false,
  contact = true,
  contactSuite = 'pour en convenir.',
  limite,
  heuresEnTete = false,
} = Astro.props;

/**
 * Les dates d'un créneau, avec ce qu'il y reste de place.
 *
 * Partagé par les trois pages d'aperçu : le calcul des états est le même
 * partout, et le recopier trois fois garantirait qu'une des trois finisse par
 * dire autre chose que les deux autres.
 *
 * On ne publie AUCUN nom, aucune adresse : ces pages sont publiques, et la liste
 * des personnes inscrites n'y a rien à faire.
 */
/**
 * Ce qu'il y a à dire d'une séance — et rien de plus.
 *
 * TANT QU'IL RESTE DE LA PLACE, ON NE DIT RIEN. Le nombre exact de places libres
 * ne change pas la démarche de qui veut s'inscrire, et un décompte affiché finit
 * par travailler contre l'atelier : « 5 places » laisse croire qu'on peut
 * attendre, « 1 place » met une pression que personne n'a demandée. Une date sans
 * mention est une date où l'on peut venir, ce qui est le cas le plus courant.
 *
 * Restent les deux seuls moments où la démarche change vraiment. « Complet »
 * ferme la porte, « liste d'attente » l'entrouvre : les confondre ferait
 * renoncer quelqu'un qui aurait pu venir.
 */
function etatDe(s: Seance) {
  const prises = (s.bookings ?? []).filter((b) => b.status === 'booked').length;
  const enFile = (s.bookings ?? []).filter((b) => b.status === 'waiting').length;

  if (s.capacity - prises > 0) return null;
  if (enFile < s.places_attente) return { libelle: 'liste d’attente', ton: 'normal' };
  return { libelle: 'complet', ton: 'sourd' };
}

const lignes = [...seances]
  .sort((a, b) => a.starts_at.localeCompare(b.starts_at))
  .map((s) => ({ ...s, etat: etatDe(s) }));

const visibles = limite ? lignes.slice(0, limite) : lignes;
const repliees = limite ? lignes.slice(limite) : [];

// Horaires comparés sur leur rendu à Paris, non sur l'instant : deux séances
// séparées par un changement d'heure commencent au même moment de la journée
// tout en différant d'une heure en UTC.
const heureFr = new Intl.DateTimeFormat('fr-FR', {
  hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Paris',
});
const creneauxHoraires = new Set(
  lignes.map((s) => `${heureFr.format(new Date(s.starts_at))}${heureFr.format(new Date(s.ends_at))}`),
);
const heures = !(heuresEnTete && creneauxHoraires.size === 1);
---

{/*
  Une panne ne se déguise pas en calendrier vide. « Aucune date » ferait renoncer
  quelqu'un alors que les dates existent : dire qu'on n'a pas pu les lire invite
  à revenir, ce qu'un calendrier vide n'invite pas à faire.

  Et surtout : PAS de repli sur les dates saisies à la main. Elles seraient
  périmées dès la première séance déplacée, et afficher une date qui n'existe
  plus est pire que n'afficher aucune date — quelqu'un se déplacerait.
*/}
{erreur ? (
  <p role="status" class="text-sm text-[var(--color-button)]">
    Le calendrier n’a pas pu être chargé. Merci de réessayer dans quelques minutes.
  </p>
) : lignes.length === 0 ? (
  <p class="text-sm text-[var(--color-text-light)]">
    {/*
      Un calendrier vide n'invite à rien. Sans une porte de sortie, il se lit
      comme une fin de non-recevoir alors qu'une date se cale souvent d'un
      message. Le lien ouvre le formulaire, et retombe sur /contact/ si le script
      n'a pas chargé — une invitation qui ne s'ouvre pas vaudrait moins que rien.
    */}
    {vide}
    {contact && (
      <Fragment>
        {' '}
        <a
          href={lienContact(Astro.url.pathname)}
          data-tally-fallback
          class="font-medium text-[var(--color-button)] underline"
        >
          Contactez Isabelle
        </a>
        {' '}{contactSuite}
      </Fragment>
    )}
  </p>
) : (
  <Fragment>
    <ul class="space-y-1.5 text-sm">
      {visibles.map((s) => <LigneSeance {...s} heures={heures} />)}
    </ul>

    {/*
      Un <details> plutôt qu'un bouton : le repli fonctionne sans JavaScript, et
      le contenu reste dans la page — donc lisible par un lecteur d'écran et
      trouvable par la recherche du navigateur, ce qu'un affichage différé
      n'offrirait pas.
    */}
    {repliees.length > 0 && (
      <details class="mt-2 text-sm" data-dates>
        <summary class="cursor-pointer font-medium text-[var(--color-button)]">
          Voir les {repliees.length} autres dates
        </summary>
        <ul class="mt-2 space-y-1.5">
          {repliees.map((s) => <LigneSeance {...s} heures={heures} />)}
        </ul>
      </details>
    )}
  </Fragment>
)}

<script>
  /*
   * DEUX CARTES CÔTE À CÔTE S'OUVRENT ENSEMBLE.
   *
   * Déplier les sept dates d'un créneau allongeait sa carte seule et laissait
   * sa voisine flotter au-dessus d'un grand vide — le lecteur perdait la
   * comparaison entre les deux, qui est précisément ce qu'il était en train de
   * faire.
   *
   * SUR LA MÊME RANGÉE SEULEMENT, et non tout le groupe : sur un téléphone la
   * grille tombe à une colonne, chaque carte est sa propre rangée, et déplier
   * l'une n'en déplie aucune autre. C'est l'alignement qu'on répare, pas un
   * comportement qu'on impose.
   *
   * Le repli reste un <details> : sans JavaScript, tout continue de fonctionner,
   * carte par carte.
   */
  const replis = [...document.querySelectorAll('details[data-dates]')];

  /** L'enfant direct de la grille qui contient ce repli — sa « carte ». */
  function carte(repli: Element): HTMLElement | null {
    let el: HTMLElement | null = repli as HTMLElement;
    while (el?.parentElement && getComputedStyle(el.parentElement).display !== 'grid') {
      el = el.parentElement;
    }
    return el?.parentElement ? el : null;
  }

  let enCours = false;

  for (const repli of replis) {
    repli.addEventListener('toggle', () => {
      // Ouvrir une voisine déclenche son propre « toggle » : sans ce garde, les
      // deux s'appelleraient l'une l'autre.
      if (enCours) return;

      const mienne = carte(repli);
      if (!mienne) return;
      const rangee = mienne.offsetTop;
      const grille = mienne.parentElement;

      enCours = true;
      for (const autre of replis) {
        if (autre === repli) continue;
        const sienne = carte(autre);
        if (!sienne || sienne.parentElement !== grille) continue;
        if (Math.abs(sienne.offsetTop - rangee) > 1) continue;
        (autre as HTMLDetailsElement).open = (repli as HTMLDetailsElement).open;
      }
      enCours = false;
    });
  }
</script>
