---
import { reader } from '../utils/reader';
import { lienContact } from '../utils/origine';

interface Props {
  label?: string;
  /**
   * Ajouter le téléphone et WhatsApp sous le bouton.
   *
   * FAUX PAR DÉFAUT, et c'est délibéré : ce composant apparaît quatre à cinq
   * fois par page. Répété partout, le rappel cesserait d'être remarqué — c'est
   * déjà ce qui est arrivé à un bouton qu'on avait mis six fois. On ne
   * l'affiche donc qu'au dernier, sous la FAQ, là où celui qui n'a pas trouvé
   * sa réponse est le plus près de renoncer.
   */
  telephone?: boolean;
}

const settings = await reader.singletons.siteSettings.read();
const { label = settings?.defaultCtaLabel, telephone = false } = Astro.props;

/**
 * Le mobile d'abord — c'est celui qui porte WhatsApp.
 *
 * Une partie du public de l'atelier appelle plutôt qu'elle n'écrit, et le
 * numéro ne vivait jusqu'ici que dans le pied de page, cinq écrans plus bas.
 */
const numeros = settings?.phones ?? [];
const mobile = numeros[0];
const chiffres = mobile?.replace(/\D/g, '');
const whatsapp = chiffres?.startsWith('0') ? `https://wa.me/33${chiffres.slice(1)}` : null;
---

<div class="mt-8 mb-8 text-center not-prose">
  <a
    href={lienContact(Astro.url.pathname)}
    data-tally-fallback
    class="cta-button inline-block px-8 py-3 rounded-[var(--radius-button)] font-medium text-sm bg-[var(--color-button)] text-white transition-all hover:bg-[var(--color-button-hover)] hover:scale-[1.02] no-underline"
  >
    {label}
  </a>

  {telephone && mobile && (
    <p class="mt-4 text-sm text-[var(--color-text)]">
      ou appelez Isabelle au{' '}
      <a href={`tel:${mobile.replace(/[.\s]/g, '')}`} class="font-medium text-[var(--color-button)]">
        {mobile}
      </a>
      {whatsapp && (
        <Fragment>
          {' — '}
          <a href={whatsapp} class="font-medium text-[var(--color-button)]">
            aussi sur WhatsApp
          </a>
        </Fragment>
      )}
    </p>
  )}
</div>

<style>
  .cta-button {
    color: white !important;
    text-decoration: none !important;
  }
</style>
