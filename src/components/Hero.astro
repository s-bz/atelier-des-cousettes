---
import { Image, getImage } from 'astro:assets';

interface Props {
  title: string;
  subtitle?: string;
  /** Pre-resolved cover image (use resolveImage() in the page). */
  coverImage?: ImageMetadata;
  altText?: string;
  flush?: boolean;
  /**
   * Un lien discret sous le sous-titre — les deux ensemble ou rien.
   *
   * Volontairement pas un bouton de contact : les pages en portent déjà
   * plusieurs plus bas, et en ajouter un ici les affaiblirait tous. Celui-ci ne
   * demande pas d'écrire, il fait descendre — c'est un autre geste, qui ne
   * dispute rien au premier.
   */
  actionLabel?: string;
  actionHref?: string;
}

const { title, subtitle, coverImage, altText, flush = false, actionLabel, actionHref } = Astro.props;

const action = actionLabel?.trim() && actionHref ? { label: actionLabel, href: actionHref } : null;

// Generate optimized image URL for preloading
const preloadImage = coverImage
  ? await getImage({ src: coverImage, width: 640, format: 'webp', quality: 60 })
  : null;
---

{preloadImage && (
  <link rel="preload" as="image" type="image/webp" href={preloadImage.src} />
)}

{coverImage ? (
  <section class={`relative h-64 md:h-80 overflow-hidden bg-[var(--color-bg-dark)] ${flush ? '' : 'mb-8 md:mb-12'}`}>
    <Image
      src={coverImage}
      alt={altText || `Image de couverture — ${title}`}
      class="absolute inset-0 w-full h-full object-cover object-center"
      widths={[640, 1024, 1440]}
      sizes="100vw"
      format="webp"
      quality={60}
      height={480}
      loading="eager"
      decoding="async"
      fetchpriority="high"
    />
    <div class="absolute inset-0 bg-black/50" />
    <div class="relative h-full flex flex-col items-center justify-center px-4 text-center">
      <h1 class="hero-title text-3xl md:text-5xl font-medium leading-tight text-white">{title}</h1>
      {/* `whitespace-pre-line` : le retour à la ligne du CMS est conservé, et
          chaque ligne se replie d'elle-même sur un écran étroit — là où un <br>
          imposerait sa césure à un texte déjà retourné deux fois. */}
      {subtitle && (
        <p class="hero-subtitle mt-3 whitespace-pre-line text-lg md:text-xl text-white/90">{subtitle}</p>
      )}
      {action && (
        <a
          href={action.href}
          class="hero-action mt-5 inline-block rounded-[var(--radius-button)] border-2 border-white/80 px-6 py-2 text-sm font-medium text-white no-underline transition-colors hover:bg-white hover:text-[var(--color-heading)]"
        >
          {action.label} <span aria-hidden="true">↓</span>
        </a>
      )}
    </div>
  </section>
) : (
  <section class="py-12 md:py-20">
    <div class="max-w-3xl mx-auto px-4 text-center">
      <h1 class="text-4xl md:text-5xl font-medium leading-tight">{title}</h1>
      {subtitle && (
        <p class="mt-4 whitespace-pre-line text-lg md:text-xl text-[var(--color-text)]">{subtitle}</p>
      )}
    </div>
  </section>
)}

<style>
  .hero-title {
    color: white !important;
    text-shadow: 0 2px 8px rgba(0, 0, 0, 0.7), 0 0 2px rgba(0, 0, 0, 0.5);
  }
  .hero-subtitle {
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.7), 0 0 2px rgba(0, 0, 0, 0.4);
  }
  /* Le lien passe en blanc sur l'image, et en sombre une fois le fond rempli. */
  .hero-action {
    color: white !important;
    text-decoration: none !important;
  }
  .hero-action:hover {
    color: var(--color-heading) !important;
  }
</style>
