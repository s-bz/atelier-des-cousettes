---
interface Props {
  /** L'adresse connue d'avance, pour un adhérent déjà connecté. */
  email?: string | null;
}
const { email } = Astro.props;
---

{/*
  CE QUE ÇA VA COÛTER, PENDANT QU'ON REMPLIT.

  Le formulaire annonçait une règle — « 15 € s'ajoutent, sauf si… » — et laissait
  chacun faire le calcul. Or c'est le montant prélevé aujourd'hui qui décide,
  et il dépend de trois choses qu'on choisit ici : la formule, l'échelonnement,
  et l'adhésion déjà réglée ou non.

  LE CHIFFRAGE VIENT DU SERVEUR, jamais d'un calcul refait ici : c'est le même
  `construireEcheancier` qui produira l'échéancier envoyé à HelloAsso. Deux
  arithmétiques finiraient par diverger, et la page annoncerait alors un montant
  que le prélèvement démentirait.

  Sans JavaScript, ce bloc reste vide et le formulaire fonctionne : le devis est
  un confort, pas une étape.
*/}
<div
  id="devis"
  data-email={email ?? ''}
  hidden
  class="rounded-xl bg-[var(--color-bg-accent)] px-4 py-3"
>
  <p class="font-medium text-[var(--color-heading)]" id="devis-aujourdhui"></p>
  <p class="mt-1 text-sm text-[var(--color-text)]" id="devis-suite"></p>

  {/*
    LA CONTRIBUTION HELLOASSO, EN UNE LIGNE. Elle doit être dite — sans quoi
    l'écart entre notre « 49 € » et le « 50,x € » de leur page se lit comme un
    frais caché — mais elle ne mérite pas le paragraphe qu'elle avait : au
    moment de décider, quatre blocs de texte se neutralisent.
  */}
  {/*
    LE CODE DE RÉDUCTION VIT ICI, replié derrière un lien.

    En champ ouvert au milieu du formulaire, il annonçait à tous qu'une remise
    existe — et qui n'en a pas se demande ce qu'il rate, juste avant de payer.
    Replié, il ne coûte rien à qui l'ignore et reste à un clic de qui a reçu un
    code. Sa place est dans ce cadre : c'est le montant qu'il change.
  */}
  <slot />

  <p class="mt-2 text-sm text-[var(--color-text-light)]">
    HelloAsso proposera d’y ajouter une contribution facultative, modifiable jusqu’à zéro.
  </p>
</div>

<script>
  const bloc = document.getElementById('devis');
  const champEmail = document.getElementById('email') as HTMLInputElement | null;
  const formule = document.getElementById('formule') as HTMLSelectElement | null;
  const reglements = [...document.querySelectorAll<HTMLInputElement>('input[name="reglement"]')];

  const champCode = document.getElementById('code') as HTMLInputElement | null;
  /*
   * LE VERDICT DU CODE VIT SOUS LE CHAMP DU CODE, pas dans le devis : c'est là
   * qu'on peut encore en essayer un autre. L'élément appartient donc à la page,
   * et peut manquer — l'espace adhérent n'a pas de champ code.
   */
  const ligneCode = document.getElementById('code-retour');
  const aujourdhui = document.getElementById('devis-aujourdhui');
  const suite = document.getElementById('devis-suite');

  if (bloc && formule && aujourdhui && suite) {
    const euros = (c: number) =>
      (c / 100).toFixed(2).replace('.', ',').replace(',00', '') + ' €';

    let enVol: AbortController | null = null;
    let minuterie: ReturnType<typeof setTimeout> | undefined;

    async function chiffrer() {
      const id = formule!.value;
      if (!id) { bloc!.hidden = true; return; }

      // L'adresse connue d'avance l'emporte : sur l'espace adhérent, il n'y a
      // pas de champ à saisir.
      const email = bloc!.dataset.email || champEmail?.value || '';
      const comptant = reglements.find((r) => r.checked)?.value === 'comptant';

      const params = new URLSearchParams({ formule: id, comptant: comptant ? '1' : '0' });
      if (email.includes('@')) params.set('email', email);
      if (champCode?.value.trim()) params.set('code', champCode.value.trim());

      // Une réponse tardive ne doit pas écraser une plus récente.
      enVol?.abort();
      enVol = new AbortController();

      try {
        const r = await fetch(`/api/devis.json?${params}`, { signal: enVol.signal });
        if (!r.ok) { bloc!.hidden = true; return; }
        const d = await r.json();

        aujourdhui!.textContent = `À régler aujourd’hui : ${euros(d.premierCents)}`;
        const dont = d.adhesionCents
          ? `, dont ${euros(d.adhesionCents)} d’adhésion (une fois par famille)`
          : ` — adhésion déjà réglée`;
        suite!.textContent = d.nbEcheances
          ? `puis ${d.nbEcheances} versements de ${euros(d.suivantsCents)} — ${euros(d.totalCents)} en tout${dont}.`
          : `C’est le total${dont}.`;
        if (ligneCode) {
          // Un code refusé se dit ici, pas au moment de payer : c'est le seul
          // endroit où l'on peut encore en essayer un autre.
          ligneCode.textContent = d.codeErreur
            ? d.codeErreur
            : d.reductionCents ? `Code appliqué : ${euros(d.reductionCents)} de moins sur le forfait.` : '';
          ligneCode.className = `mt-1 text-sm ${d.codeErreur ? 'text-[var(--color-bg-pink)]' : 'text-[var(--color-button)]'}`;
        }
        bloc!.hidden = false;
      } catch (e) {
        // Une requête annulée n'est pas une panne : on laisse l'affichage en place.
        if ((e as Error)?.name !== 'AbortError') bloc!.hidden = true;
      }
    }

    formule.addEventListener('change', chiffrer);
    for (const r of reglements) r.addEventListener('change', chiffrer);
    // On ne chiffre pas à chaque touche : l'adresse n'est utile que complète.
    champCode?.addEventListener('input', () => {
      clearTimeout(minuterie);
      minuterie = setTimeout(chiffrer, 400);
    });
    champEmail?.addEventListener('input', () => {
      clearTimeout(minuterie);
      minuterie = setTimeout(chiffrer, 400);
    });

    chiffrer();
  }
</script>
