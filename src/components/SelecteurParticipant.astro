---
interface Props {
  personnes: { id: string; first_name: string; last_name: string }[];
  choisie: { id: string } | null;
  /** Page sur laquelle rester en changeant de personne. */
  base: string;
}

const { personnes, choisie, base } = Astro.props;
---

{/*
  Rien ne s'affiche quand le compte ne porte qu'une personne : c'est le cas
  courant, celui de l'adulte qui vient pour lui-même, et il ne doit jamais
  rencontrer la notion de « participant ».
*/}
{personnes.length > 1 && (
  <nav class="mb-6 flex flex-wrap gap-2" aria-label="Personne">
    {personnes.map((p) => {
      const actif = p.id === choisie?.id;
      return (
        <a
          href={`${base}?personne=${p.id}`}
          aria-current={actif ? 'page' : undefined}
          class={`rounded-[var(--radius-button)] px-4 py-2 text-sm font-medium transition-colors ${
            actif
              ? 'bg-[var(--color-button)] text-white'
              : 'border border-[var(--color-border-prominent)] text-[var(--color-text)] hover:border-[var(--color-button)]'
          }`}
        >
          {p.first_name}
        </a>
      );
    })}
  </nav>
)}
