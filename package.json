    "@keystatic/core": "^0.5.50",
    "@markdoc/markdoc": "^0.5.7",
    "@tailwindcss/vite": "^4.2.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vercel/analytics": "^2.0.1",
    "astro": "^7.0.0",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
